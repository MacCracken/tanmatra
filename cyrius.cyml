[package]
name = "tanmatra"
version = "${file:VERSION}"
description = "tanmatra — atomic and subatomic physics: Standard Model, nuclear structure, radioactive decay, spectral lines, atomic timekeeping"
license = "GPL-3.0-only"
repository = "https://github.com/MacCracken/tanmatra"
language = "cyrius"
cyrius = "6.7.18"

[build]
entry = "src/main.cyr"
output = "build/tanmatra"

# stdlib leaves, vendored into lib/ by `cyrius deps` and prepended to every compile.
#   math     — f64_sin / f64_cos on every target; exp / ln / atan on aarch64
#   ganita   — ganita_f64_cbrt / pow / sinh / tan / hypot (ganita 1.2.15 in the 6.7.18 bundle)
#   overflow — the saturating `+|` / `-|` / `*|` operators (AtomicInstant)
#   tagged / result — the value-form Option and Result
#   freelist — fl_alloc / fl_free, so Bateman's scratch is returned, not leaked
[deps]
stdlib = ["syscalls", "string", "alloc", "str", "fmt", "io", "vec", "math", "ganita", "overflow", "tagged", "result", "freelist",
    "sakshi"]

# prakash 2.15.1, pinned by tag, for the optics profile only (port plan M6). Optional, so a plain
# `cyrius deps` never vendors it: the core bundle stays prakash-free, as prakash keeps its own
# `ai` module out of its core. No `path =` override, which would bypass the commit pin that
# cyrius.lock records.
[deps.prakash]
git = "https://github.com/MacCracken/prakash.git"
tag = "2.15.1"
modules = ["dist/prakash.cyr"]
optional = true

# Features mirror the Rust crate's cargo features that the port carries. `default` is empty, as
# in Rust; the repo itself tests with `cyrius deps --features optics`.
[features]
default = []
optics = ["prakash"]

# Test / bench / fuzz compiles only.
[test]
stdlib = ["assert", "bench"]

# `[lib]` is the bundle `cyrius distlib` writes to dist/tanmatra.cyr. The list IS the
# concatenation order, and it is load-bearing: no src/ file has an `include`, so each module
# resolves at file scope against what precedes it. The full order (port plan §2 step 3):
#   error → numerics → constants → particle_data → particle → relativity → nucleus_data →
#   nucleus → shell_model → decay_data → decay → atomic_data → atomic_config →
#   atomic_hydrogenic → atomic_qed → reaction_data → reaction → scattering → timekeeping
# Modules are appended as their milestone lands. constants.cyr and *_data.cyr are generated
# by scripts/oracle; never edit them. `cyrius distlib --all` writes [lib] and every profile.
[lib]
modules = [
    "src/error.cyr",
    "src/numerics.cyr",
    "src/constants.cyr",
    "src/particle_data.cyr",
    "src/particle.cyr",
    "src/relativity.cyr",
    "src/nucleus_data.cyr",
    "src/nucleus.cyr",
    "src/shell_model.cyr",
    "src/decay_data.cyr",
    "src/decay.cyr",
    "src/atomic_data.cyr",
    "src/atomic_config.cyr",
    "src/atomic_hydrogenic.cyr",
    "src/atomic_qed.cyr",
    "src/reaction_data.cyr",
    "src/reaction.cyr",
    "src/scattering.cyr",
    "src/timekeeping_data.cyr",
    "src/timekeeping.cyr",
]

# The optics profile: the core plus src/optics.cyr, which needs prakash. Consumers who want it
# vendor with `cyrius deps --features optics` and include dist/tanmatra-optics.cyr; the core
# bundle never pulls in prakash (port plan M6).
[lib.optics]
modules = [
    "src/error.cyr",
    "src/numerics.cyr",
    "src/constants.cyr",
    "src/particle_data.cyr",
    "src/particle.cyr",
    "src/relativity.cyr",
    "src/nucleus_data.cyr",
    "src/nucleus.cyr",
    "src/shell_model.cyr",
    "src/decay_data.cyr",
    "src/decay.cyr",
    "src/atomic_data.cyr",
    "src/atomic_config.cyr",
    "src/atomic_hydrogenic.cyr",
    "src/atomic_qed.cyr",
    "src/reaction_data.cyr",
    "src/reaction.cyr",
    "src/scattering.cyr",
    "src/timekeeping_data.cyr",
    "src/timekeeping.cyr",
    "src/optics_data.cyr",
    "src/optics.cyr",
]
