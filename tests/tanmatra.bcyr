# tanmatra.bcyr — benchmarks, mirroring rust-old/benches/benchmarks.rs (criterion).
#
# A bench that has a Rust counterpart keeps its name and body, so the two numbers compare
# directly (docs/benchmarks-rust-v-cyrius.md). Cyrius-only benches cover API the Rust suite
# never timed. Each timed batch repeats the body many times: one clock read costs ~1.3 µs on
# an HPET host (lib/bench.cyr), and the library subtracts its measured floor.

include "src/error.cyr"
include "src/numerics.cyr"
include "src/constants.cyr"
include "src/particle_data.cyr"
include "src/particle.cyr"
include "src/relativity.cyr"

# A sink the timed loops write to, so their results are used.
var _bench_sink = 0;

# relativity/lorentz_gamma_1000: γ for β = i/1001, i = 1..1000 (the Rust bench's body).
fn bench_lorentz_gamma_1000() {
    var i = 1;
    while (i <= 1000) {
        var beta: f64 = f64_from(i) / 1001.0;
        var g: f64 = lorentz_gamma(beta);
        _bench_sink = g;
        i = i + 1;
    }
}

# relativity/invariant_mass_1000 (Cyrius-only): an electron at 1000 momenta along an oblique
# direction, |p| through _tm_hypot.
fn bench_invariant_mass_1000() {
    var i = 1;
    while (i <= 1000) {
        var p: f64 = f64_from(i);
        var e: f64 = relativistic_energy(TM_ELECTRON_MASS_MEV, p);
        var fm = TmFourMomentum_new(e, (3.0 * p) / 13.0, (4.0 * p) / 13.0, (12.0 * p) / 13.0);
        var m: f64 = fm.invariant_mass();
        _bench_sink = m;
        i = i + 1;
    }
}

# particle/properties_all (Cyrius-only): every tabulated property of every variant once.
fn bench_particle_properties_all() {
    var k = 0;
    while (k < 6) {
        var a: f64 = quark_mass_mev(k);
        var b: f64 = lepton_mass_mev(k);
        var c: f64 = boson_mass_mev(k);
        var d: f64 = boson_lifetime_seconds(k);
        var w: f64 = lepton_decay_width_mev(k);
        _bench_sink = a + b + c + d + w;
        k = k + 1;
    }
}

# Times `rounds` calls of a body fn per batch, over `batches` batches.
fn run(name, fp, rounds, batches) {
    var b = bench_new(name);
    var k = 0;
    while (k < batches) {
        bench_batch_start(b);
        var r = 0;
        while (r < rounds) { fncall0(fp); r = r + 1; }
        bench_batch_stop(b, rounds);
        k = k + 1;
    }
    bench_report(b);
}

# Runs every bench.
fn main(): i64 {
    alloc_init();
    run("relativity/lorentz_gamma_1000", &bench_lorentz_gamma_1000, 200, 20);
    run("relativity/invariant_mass_1000", &bench_invariant_mass_1000, 50, 20);
    run("particle/properties_all", &bench_particle_properties_all, 20000, 20);
    return 0;
}

var r = main();
sys_exit_group(r);
