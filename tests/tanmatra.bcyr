# tanmatra.bcyr — benchmarks, mirroring rust-old/benches/benchmarks.rs (criterion).
#
# A bench that has a Rust counterpart keeps its name and body, so the two numbers compare
# directly (docs/benchmarks-rust-v-cyrius.md). Cyrius-only benches cover API the Rust suite
# never timed. Each timed batch repeats the body many times: one clock read costs ~1.3 µs on
# an HPET host (lib/bench.cyr), and the library subtracts its measured floor.

include "src/error.cyr"
include "src/numerics.cyr"
include "src/constants.cyr"
include "src/particle_data.cyr"
include "src/particle.cyr"
include "src/relativity.cyr"
include "src/nucleus_data.cyr"
include "src/nucleus.cyr"
include "src/shell_model.cyr"
include "src/decay_data.cyr"
include "src/decay.cyr"
include "src/atomic_data.cyr"
include "src/atomic_config.cyr"
include "src/atomic_hydrogenic.cyr"
include "src/atomic_qed.cyr"
include "src/reaction_data.cyr"
include "src/reaction.cyr"
include "src/scattering.cyr"
include "src/timekeeping_data.cyr"
include "src/timekeeping.cyr"

# A sink the timed loops write to, so their results are used.
var _bench_sink = 0;

# relativity/lorentz_gamma_1000: γ for β = i/1001, i = 1..1000 (the Rust bench's body).
fn bench_lorentz_gamma_1000() {
    var i = 1;
    while (i <= 1000) {
        var beta: f64 = f64_from(i) / 1001.0;
        var g: f64 = lorentz_gamma(beta);
        _bench_sink = g;
        i = i + 1;
    }
}

# relativity/invariant_mass_1000 (Cyrius-only): an electron at 1000 momenta along an oblique
# direction, |p| through _tm_hypot.
fn bench_invariant_mass_1000() {
    var i = 1;
    while (i <= 1000) {
        var p: f64 = f64_from(i);
        var e: f64 = relativistic_energy(TM_ELECTRON_MASS_MEV, p);
        var fm = TmFourMomentum_new(e, (3.0 * p) / 13.0, (4.0 * p) / 13.0, (12.0 * p) / 13.0);
        var m: f64 = fm.invariant_mass();
        _bench_sink = m;
        i = i + 1;
    }
}

# particle/properties_all (Cyrius-only): every tabulated property of every variant once.
fn bench_particle_properties_all() {
    var k = 0;
    while (k < 6) {
        var a: f64 = quark_mass_mev(k);
        var b: f64 = lepton_mass_mev(k);
        var c: f64 = boson_mass_mev(k);
        var d: f64 = boson_lifetime_seconds(k);
        var w: f64 = lepton_decay_width_mev(k);
        _bench_sink = a + b + c + d + w;
        k = k + 1;
    }
}

# The nuclei each nucleus bench iterates, built once (as the Rust benches build theirs
# outside `b.iter`): word arrays with their counts.
var _bench_be = 0;
var _bench_be_n = 0;
var _bench_sc = 0;
var _bench_sc_n = 0;
var _bench_jp = 0;
var _bench_jp_n = 0;

# Builds the three nucleus lists of rust-old/benches/benchmarks.rs.
fn bench_build_nuclei() {
    _bench_be = alloc(8 * 1000);
    _bench_sc = alloc(8 * 1000);
    _bench_jp = alloc(8 * 100);
    var z = 1;
    while (z <= 100) {
        var a_max = z * 3;
        if (a_max > z + 9) { a_max = z + 9; }
        var a = z;
        while (a <= a_max) {
            store64(_bench_be + _bench_be_n * 8, _tm_nuc(z, a));
            _bench_be_n = _bench_be_n + 1;
            a = a + 1;
        }
        a = z;
        while (a <= z + 9) {
            store64(_bench_sc + _bench_sc_n * 8, _tm_nuc(z, a));
            _bench_sc_n = _bench_sc_n + 1;
            a = a + 1;
        }
        z = z + 1;
    }
    z = 1;
    while (z <= 99) {
        store64(_bench_jp + _bench_jp_n * 8, _tm_nuc(z, 2 * z + 1));
        _bench_jp_n = _bench_jp_n + 1;
        z = z + 2;
    }
    z = 1;
    while (z <= 99) {
        store64(_bench_jp + _bench_jp_n * 8, _tm_nuc(z, 2 * z));
        _bench_jp_n = _bench_jp_n + 1;
        z = z + 2;
    }
}

# nucleus/binding_energy_1000: SEMF over Z = 1..100, A = Z..min(3Z, Z + 9) (984 nuclei).
fn bench_binding_energy_1000() {
    var k = 0;
    while (k < _bench_be_n) {
        var b: f64 = nucleus_binding_energy(load64(_bench_be + k * 8));
        _bench_sink = b;
        k = k + 1;
    }
}

# nucleus/binding_energy_shell_corrected_1000: over Z = 1..100, A = Z..Z + 9 (1000 nuclei).
fn bench_binding_energy_shell_corrected_1000() {
    var k = 0;
    while (k < _bench_sc_n) {
        var b: f64 = nucleus_binding_energy_shell_corrected(load64(_bench_sc + k * 8));
        _bench_sink = b;
        k = k + 1;
    }
}

# nucleus/ground_state_spin_parity_100: odd Z = 1..99 at A = 2Z + 1 (odd A) and A = 2Z (odd-odd).
fn bench_ground_state_spin_parity_100() {
    var k = 0;
    while (k < _bench_jp_n) {
        var tj, par = ground_state_spin_parity(load64(_bench_jp + k * 8));
        _bench_sink = tj + par;
        k = k + 1;
    }
}

# nucleus/shell_occupation_126: occupations for 1..126 nucleons. Rust allocates a Vec per call;
# the Cyrius API fills caller buffers, so this times the fill alone.
fn bench_shell_occupation_126() {
    var lvs: TmShellLevel[32];
    var occ[256];
    var n = 1;
    while (n <= 126) {
        _bench_sink = shell_occupation(n, &lvs, &occ, 32);
        n = n + 1;
    }
}

# Buffers for the decay benches, built once.
var _bench_chain_n = 0;
var _bench_chain_m = 0;
var _bench_lam3 = 0;
var _bench_u238 = 0;
var _bench_u238_n = 0;
var _bench_pops = 0;

# Builds the decay benches' inputs: the λ of rust bateman_chain_3, and the U-238 series λ from
# decay_chain(U-238) and the isotope table (15 members with the stable Pb-206, as the Rust
# bench's list), so no half-life is re-typed here.
fn bench_build_decay() {
    _bench_chain_n = alloc(64 * 8);
    _bench_chain_m = alloc(64 * 8);
    _bench_lam3 = alloc(3 * 8);
    store64(_bench_lam3, 0.1);
    store64(_bench_lam3 + 8, 0.05);
    store64(_bench_lam3 + 16, 0.0);
    _bench_pops = alloc(64 * 8);
    _bench_u238 = alloc(64 * 8);
    var cnt = decay_chain(nucleus_uranium_238(), 50, _bench_chain_n, _bench_chain_m, 64);
    var k = 0;
    while (k < cnt) {
        var nk = load64(_bench_chain_n + k * 8);
        var j = 0;
        var hl: f64 = 0.0;
        var done = 0;
        while (j < known_isotope_count() && done == 0) {
            var iso = known_isotope(j);
            if (iso.nucleus == nk) { hl = iso.half_life_seconds; done = 1; }
            j = j + 1;
        }
        var t, lam = decay_constant(hl);
        store64(_bench_u238 + k * 8, lam);
        k = k + 1;
    }
    store64(_bench_u238 + cnt * 8, 0.0);
    _bench_u238_n = cnt + 1;
}

# decay/decay_chain_10: the U-238 chain, at most 10 steps.
fn bench_decay_chain_10() {
    _bench_sink = decay_chain(nucleus_uranium_238(), 10, _bench_chain_n, _bench_chain_m, 64);
}

# decay/bateman_chain_3: λ = (0.1, 0.05, 0) s⁻¹, N₀ = 10⁶, t = 100 s.
fn bench_bateman_chain_3() {
    _bench_sink = bateman_chain(_bench_lam3, 3, 1000000.0, 100.0, _bench_pops);
}

# decay/bateman_u238_series_15: the 15-member U-238 series at t = 1 y (365.2422 d).
fn bench_bateman_u238_series_15() {
    var y: f64 = 365.2422 * 86400.0;
    _bench_sink = bateman_chain(_bench_u238, _bench_u238_n, 1.0, y, _bench_pops);
}

# decay/known_isotopes_all (Rust: decay/known_isotopes_alloc): every isotope record once.
# Rust builds a Vec of 114 Isotopes with a String each; Cyrius reads the baked table by value.
fn bench_known_isotopes_all() {
    var k = 0;
    while (k < known_isotope_count()) {
        var iso = known_isotope(k);
        _bench_sink = iso.nucleus;
        k = k + 1;
    }
}

# atomic/spectral_line_1000: every line n1 < n2 ≤ 10 for Z = 1..10 (the Rust bench's body).
fn bench_spectral_line_1000() {
    var z = 1;
    while (z <= 10) {
        var n1 = 1;
        while (n1 <= 10) {
            var n2 = n1 + 1;
            while (n2 <= 10) {
                var t, v = spectral_line_nm(z, n1, n2);
                _bench_sink = v;
                n2 = n2 + 1;
            }
            n1 = n1 + 1;
        }
        z = z + 1;
    }
}

var _bench_cfg: TmOrbitalFilling[20];

# atomic/electron_config_36: the configurations of Z = 1..36. Rust returns a new Vec each;
# Cyrius fills a caller array.
fn bench_electron_config_36() {
    var z = 1;
    while (z <= 36) {
        var t, v = electron_configuration(z, &_bench_cfg, 20);
        _bench_sink = v;
        z = z + 1;
    }
}

# atomic/ionization_energy_118: every first ionization energy.
fn bench_ionization_energy_118() {
    var z = 1;
    while (z <= 118) {
        var t, v = ionization_energy_ev(z);
        _bench_sink = v;
        z = z + 1;
    }
}

# atomic/radial_wavefunction_100: R_32(r) at r = 0.1·i a₀, i = 0..99.
fn bench_radial_wavefunction_100() {
    var i = 0;
    while (i < 100) {
        var r: f64 = f64_from(i) * 0.1;
        var t, v = radial_wavefunction(1, 3, 2, r);
        _bench_sink = v;
        i = i + 1;
    }
}

# atomic/einstein_a_to_n2_upto_n10: A for np → 2s and nd → 2p, n = 3..10.
fn bench_einstein_a_n10() {
    var n = 3;
    while (n <= 10) {
        var t1, v1 = einstein_a_coefficient(1, n, 1, 2, 0);
        _bench_sink = v1;
        var t2, v2 = einstein_a_coefficient(1, n, 2, 2, 1);
        _bench_sink = v2;
        n = n + 1;
    }
}

# atomic/radial_wavefunction_n10_100: R_{10,3}(r) at r = 0.5·i a₀, i = 0..99.
fn bench_radial_wavefunction_n10_100() {
    var i = 0;
    while (i < 100) {
        var r: f64 = f64_from(i) * 0.5;
        var t, v = radial_wavefunction(1, 10, 3, r);
        _bench_sink = v;
        i = i + 1;
    }
}

# atomic/lamb_shift_nlj_all_n4: the j = l + 1/2 Lamb shift of every (n, l) with n ≤ 4.
fn bench_lamb_shift_nlj_all_n4() {
    var n = 1;
    while (n <= 4) {
        var l = 0;
        while (l < n) {
            var t, v = lamb_shift_nlj_ev(1, n, l, 2 * l + 1);
            _bench_sink = v;
            l = l + 1;
        }
        n = n + 1;
    }
}

# scattering/rutherford_1000: 5 MeV α on Au at θ = iπ/1001, i = 1..1000 (the Rust bench's body).
fn bench_rutherford_1000() {
    var i = 1;
    while (i <= 1000) {
        var theta: f64 = (f64_from(i) * _TM_PI) / 1001.0;
        var s: f64 = rutherford_differential(2, 79, 5.0, theta);
        _bench_sink = s;
        i = i + 1;
    }
}

# scattering/pair_production_1000: Pb at E_γ = 1.1 + i MeV, i = 0..999 (both Maximon branches).
fn bench_pair_production_1000() {
    var i = 0;
    while (i < 1000) {
        var e: f64 = 1.1 + f64_from(i);
        var s: f64 = pair_production_cross_section(82, e);
        _bench_sink = s;
        i = i + 1;
    }
}

# timekeeping/atomic_instant_add_seconds_1000: 1000 chained add_seconds(1.000000001) from
# (2.1e9 s, 123 456 789 ns), the Rust bench's body.
fn bench_atomic_instant_add_seconds_1000() {
    var x = TmAtomicInstant_new(2100000000, 123456789);
    var k = 0;
    while (k < 1000) {
        x = x.add_seconds(1.000000001);
        k = k + 1;
    }
    _bench_sink = x.nanos;
}

# Times `rounds` calls of a body fn per batch, over `batches` batches.
fn run(name, fp, rounds, batches) {
    var b = bench_new(name);
    var k = 0;
    while (k < batches) {
        bench_batch_start(b);
        var r = 0;
        while (r < rounds) { fncall0(fp); r = r + 1; }
        bench_batch_stop(b, rounds);
        k = k + 1;
    }
    bench_report(b);
}

# Runs every bench.
fn main(): i64 {
    alloc_init();
    run("relativity/lorentz_gamma_1000", &bench_lorentz_gamma_1000, 200, 20);
    run("relativity/invariant_mass_1000", &bench_invariant_mass_1000, 50, 20);
    run("particle/properties_all", &bench_particle_properties_all, 20000, 20);
    bench_build_nuclei();
    run("nucleus/binding_energy_1000", &bench_binding_energy_1000, 20, 20);
    run("nucleus/binding_energy_shell_corrected_1000", &bench_binding_energy_shell_corrected_1000, 5, 20);
    run("nucleus/ground_state_spin_parity_100", &bench_ground_state_spin_parity_100, 50, 20);
    run("nucleus/shell_occupation_126", &bench_shell_occupation_126, 50, 20);
    bench_build_decay();
    run("decay/decay_chain_10", &bench_decay_chain_10, 200, 20);
    run("decay/bateman_chain_3", &bench_bateman_chain_3, 200, 20);
    run("decay/bateman_u238_series_15", &bench_bateman_u238_series_15, 5, 20);
    run("decay/known_isotopes_all", &bench_known_isotopes_all, 200, 20);
    run("atomic/spectral_line_1000", &bench_spectral_line_1000, 50, 20);
    run("atomic/electron_config_36", &bench_electron_config_36, 200, 20);
    run("atomic/ionization_energy_118", &bench_ionization_energy_118, 2000, 20);
    run("atomic/radial_wavefunction_100", &bench_radial_wavefunction_100, 100, 20);
    run("atomic/einstein_a_to_n2_upto_n10", &bench_einstein_a_n10, 20, 20);
    run("atomic/radial_wavefunction_n10_100", &bench_radial_wavefunction_n10_100, 50, 20);
    run("atomic/lamb_shift_nlj_all_n4", &bench_lamb_shift_nlj_all_n4, 1000, 20);
    run("scattering/rutherford_1000", &bench_rutherford_1000, 20, 20);
    run("scattering/pair_production_1000", &bench_pair_production_1000, 20, 20);
    run("timekeeping/atomic_instant_add_seconds_1000", &bench_atomic_instant_add_seconds_1000, 50, 20);
    return 0;
}

var r = main();
sys_exit_group(r);
