# particle.tcyr — the reference-value tests of rust-old/src/particle.rs, ported one for one
# (each test_group is the Rust test's name). The four serde round-trip tests don't port
# (port plan §1, "Not carried over"). The golden corpus separately checks every property of
# every variant bit for bit (tests/parity.tcyr).

include "tests/ulp.cyr"
include "src/error.cyr"
include "src/numerics.cyr"
include "src/constants.cyr"
include "src/particle_data.cyr"
include "src/particle.cyr"

alloc_init();

# 1 if |a - b| < eps.
#must_use
fn near(a: f64, b: f64, eps: f64): i64 {
    if (f64_abs(a - b) < eps) { return 1; }
    return 0;
}

fn _t_quark_masses_ordered() {
    test_group("quark_masses_ordered");
    assert(quark_mass_mev(TM_QUARK_UP) < quark_mass_mev(TM_QUARK_DOWN), "u < d");
    assert(quark_mass_mev(TM_QUARK_DOWN) < quark_mass_mev(TM_QUARK_STRANGE), "d < s");
    assert(quark_mass_mev(TM_QUARK_STRANGE) < quark_mass_mev(TM_QUARK_CHARM), "s < c");
    assert(quark_mass_mev(TM_QUARK_CHARM) < quark_mass_mev(TM_QUARK_BOTTOM), "c < b");
    assert(quark_mass_mev(TM_QUARK_BOTTOM) < quark_mass_mev(TM_QUARK_TOP), "b < t");
}

fn _t_lepton_masses_ordered() {
    test_group("lepton_masses_ordered");
    assert(lepton_mass_mev(TM_LEPTON_ELECTRON) < lepton_mass_mev(TM_LEPTON_MUON), "e < mu");
    assert(lepton_mass_mev(TM_LEPTON_MUON) < lepton_mass_mev(TM_LEPTON_TAU), "mu < tau");
}

fn _t_force_strengths_ordered() {
    test_group("force_strengths_ordered");
    var s: f64 = fundamental_force_relative_strength(TM_FUNDAMENTAL_FORCE_STRONG);
    var em: f64 = fundamental_force_relative_strength(TM_FUNDAMENTAL_FORCE_ELECTROMAGNETIC);
    var w: f64 = fundamental_force_relative_strength(TM_FUNDAMENTAL_FORCE_WEAK);
    var g: f64 = fundamental_force_relative_strength(TM_FUNDAMENTAL_FORCE_GRAVITY);
    assert(s > em, "strong > EM");
    assert(em > w, "EM > weak");
    assert(w > g, "weak > gravity");
}

fn _t_quark_charges() {
    test_group("quark_charges");
    var eps: f64 = 0.0000000001;
    assert(near(quark_charge(TM_QUARK_UP), 2.0 / 3.0, eps), "up +2/3");
    assert(near(quark_charge(TM_QUARK_DOWN), -1.0 / 3.0, eps), "down -1/3");
}

fn _t_boson_higgs_mass() {
    test_group("boson_higgs_mass");
    assert(near(boson_mass_mev(TM_BOSON_HIGGS), 125200.0, 1.0), "Higgs 125.2 GeV");
}

fn _t_em_mediator_is_photon() {
    test_group("em_mediator_is_photon");
    var f = TM_FUNDAMENTAL_FORCE_ELECTROMAGNETIC;
    assert_eq(fundamental_force_mediator_count(f), 1, "one mediator");
    assert_eq(fundamental_force_mediator(f, 0), TM_BOSON_PHOTON, "the photon");
}

fn _t_muon_lifetime() {
    test_group("muon_lifetime");
    var tau: f64 = lepton_lifetime_seconds(TM_LEPTON_MUON);
    assert(near(tau, 0.000002197, 0.00000001), "2.197e-6 s");
}

fn _t_tau_lifetime() {
    test_group("tau_lifetime");
    var tau: f64 = lepton_lifetime_seconds(TM_LEPTON_TAU);
    assert(near(tau, 0.0000000000002903, 0.000000000000001), "2.903e-13 s");
}

fn _t_electron_is_stable() {
    test_group("electron_is_stable");
    assert_eq(lepton_is_stable(TM_LEPTON_ELECTRON), 1, "stable");
    assert_eq(_tm_is_inf(lepton_lifetime_seconds(TM_LEPTON_ELECTRON)), 1, "infinite lifetime");
    var w: f64 = lepton_decay_width_mev(TM_LEPTON_ELECTRON);
    assert(f64_abs(w) < 0.000000000000000000000000000001, "zero width");
}

fn _t_neutrinos_stable() {
    test_group("neutrinos_stable");
    assert_eq(lepton_is_stable(TM_LEPTON_ELECTRON_NEUTRINO), 1, "nu_e");
    assert_eq(lepton_is_stable(TM_LEPTON_MUON_NEUTRINO), 1, "nu_mu");
    assert_eq(lepton_is_stable(TM_LEPTON_TAU_NEUTRINO), 1, "nu_tau");
}

fn _t_w_boson_decay_width() {
    test_group("w_boson_decay_width");
    assert(near(boson_decay_width_mev(TM_BOSON_W_PLUS), 2085.0, 50.0), "W width ~2085 MeV");
}

fn _t_z_boson_decay_width() {
    test_group("z_boson_decay_width");
    assert(near(boson_decay_width_mev(TM_BOSON_Z), 2495.5, 5.0), "Z width ~2495.5 MeV");
}

fn _t_photon_is_stable() {
    test_group("photon_is_stable");
    assert_eq(boson_is_stable(TM_BOSON_PHOTON), 1, "stable");
    assert_eq(_tm_is_inf(boson_lifetime_seconds(TM_BOSON_PHOTON)), 1, "infinite lifetime");
}

fn _t_width_lifetime_consistency() {
    test_group("width_lifetime_consistency");
    var gamma: f64 = lepton_decay_width_mev(TM_LEPTON_MUON);
    var tau: f64 = lepton_lifetime_seconds(TM_LEPTON_MUON);
    var hbar: f64 = TM_HBAR_MEV_S;
    var product: f64 = gamma * tau;
    var rel: f64 = f64_abs(product - hbar) / hbar;
    assert(rel < 0.000001, "Gamma * tau = hbar");
}

fn _t_quark_generations() {
    test_group("quark_generations");
    assert_eq(quark_generation(TM_QUARK_UP), 1, "up");
    assert_eq(quark_generation(TM_QUARK_DOWN), 1, "down");
    assert_eq(quark_generation(TM_QUARK_CHARM), 2, "charm");
    assert_eq(quark_generation(TM_QUARK_STRANGE), 2, "strange");
    assert_eq(quark_generation(TM_QUARK_TOP), 3, "top");
    assert_eq(quark_generation(TM_QUARK_BOTTOM), 3, "bottom");
}

fn _t_lepton_all_masses() {
    test_group("lepton_all_masses");
    var eps: f64 = 0.0000000001;
    assert(lepton_mass_mev(TM_LEPTON_ELECTRON) > 0.0, "electron > 0");
    assert(f64_abs(lepton_mass_mev(TM_LEPTON_ELECTRON_NEUTRINO)) < eps, "nu_e ~ 0");
    assert(lepton_mass_mev(TM_LEPTON_MUON) > 100.0, "muon > 100 MeV");
    assert(f64_abs(lepton_mass_mev(TM_LEPTON_MUON_NEUTRINO)) < eps, "nu_mu ~ 0");
    assert(lepton_mass_mev(TM_LEPTON_TAU) > 1700.0, "tau > 1700 MeV");
    assert(f64_abs(lepton_mass_mev(TM_LEPTON_TAU_NEUTRINO)) < eps, "nu_tau ~ 0");
}

fn _t_lepton_all_charges() {
    test_group("lepton_all_charges");
    var eps: f64 = 0.0000000001;
    assert(near(lepton_charge(TM_LEPTON_ELECTRON), -1.0, eps), "electron -1");
    assert(near(lepton_charge(TM_LEPTON_MUON), -1.0, eps), "muon -1");
    assert(near(lepton_charge(TM_LEPTON_TAU), -1.0, eps), "tau -1");
    assert(f64_abs(lepton_charge(TM_LEPTON_ELECTRON_NEUTRINO)) < eps, "nu_e 0");
    assert(f64_abs(lepton_charge(TM_LEPTON_MUON_NEUTRINO)) < eps, "nu_mu 0");
    assert(f64_abs(lepton_charge(TM_LEPTON_TAU_NEUTRINO)) < eps, "nu_tau 0");
}

fn _t_lepton_all_generations() {
    test_group("lepton_all_generations");
    assert_eq(lepton_generation(TM_LEPTON_ELECTRON), 1, "electron");
    assert_eq(lepton_generation(TM_LEPTON_ELECTRON_NEUTRINO), 1, "nu_e");
    assert_eq(lepton_generation(TM_LEPTON_MUON), 2, "muon");
    assert_eq(lepton_generation(TM_LEPTON_MUON_NEUTRINO), 2, "nu_mu");
    assert_eq(lepton_generation(TM_LEPTON_TAU), 3, "tau");
    assert_eq(lepton_generation(TM_LEPTON_TAU_NEUTRINO), 3, "nu_tau");
}

fn _t_boson_all_properties() {
    test_group("boson_all_properties");
    var eps: f64 = 0.0000000001;
    assert(f64_abs(boson_mass_mev(TM_BOSON_PHOTON)) < eps, "photon massless");
    assert(f64_abs(boson_mass_mev(TM_BOSON_GLUON)) < eps, "gluon massless");
    assert(boson_mass_mev(TM_BOSON_W_PLUS) > 80000.0, "W+ > 80 GeV");
    assert(boson_mass_mev(TM_BOSON_W_MINUS) > 80000.0, "W- > 80 GeV");
    assert(boson_mass_mev(TM_BOSON_Z) > 91000.0, "Z > 91 GeV");
    assert_eq(boson_spin(TM_BOSON_HIGGS), 0, "Higgs spin 0");
    assert_eq(boson_spin(TM_BOSON_PHOTON), 1, "photon spin 1");
    assert(near(boson_charge(TM_BOSON_W_PLUS), 1.0, eps), "W+ +1");
    assert(near(boson_charge(TM_BOSON_W_MINUS), -1.0, eps), "W- -1");
    assert(f64_abs(boson_charge(TM_BOSON_Z)) < eps, "Z 0");
    assert(f64_abs(boson_charge(TM_BOSON_HIGGS)) < eps, "Higgs 0");
}

fn _t_force_all_ranges() {
    test_group("force_all_ranges");
    assert(fundamental_force_range_meters(TM_FUNDAMENTAL_FORCE_STRONG) < 0.00000000000001, "strong < 1e-14 m");
    assert_eq(_tm_is_inf(fundamental_force_range_meters(TM_FUNDAMENTAL_FORCE_ELECTROMAGNETIC)), 1, "EM infinite");
    assert(fundamental_force_range_meters(TM_FUNDAMENTAL_FORCE_WEAK) < 0.00000000000000001, "weak < 1e-17 m");
    assert_eq(_tm_is_inf(fundamental_force_range_meters(TM_FUNDAMENTAL_FORCE_GRAVITY)), 1, "gravity infinite");
}

fn _t_force_all_mediators() {
    test_group("force_all_mediators");
    assert(fundamental_force_mediator_count(TM_FUNDAMENTAL_FORCE_STRONG) > 0, "strong has one");
    assert(fundamental_force_mediator_count(TM_FUNDAMENTAL_FORCE_ELECTROMAGNETIC) > 0, "EM has one");
    assert(fundamental_force_mediator_count(TM_FUNDAMENTAL_FORCE_WEAK) > 0, "weak has one");
    assert_eq(fundamental_force_mediator_count(TM_FUNDAMENTAL_FORCE_GRAVITY), 0, "gravity has none");
}

fn _t_boson_gluon_is_stable() {
    test_group("boson_gluon_is_stable");
    assert_eq(boson_is_stable(TM_BOSON_GLUON), 1, "gluon stable");
}

fn _t_tau_not_stable() {
    test_group("tau_not_stable");
    assert_eq(lepton_is_stable(TM_LEPTON_TAU), 0, "tau unstable");
    assert_eq(lepton_is_stable(TM_LEPTON_MUON), 0, "muon unstable");
}

fn _t_higgs_decay_width() {
    test_group("higgs_decay_width");
    assert(near(boson_decay_width_mev(TM_BOSON_HIGGS), 3.7, 0.1), "Higgs width 3.7 MeV");
}

# Cyrius-only: Rust can't hold an out-of-range enum value; Cyrius answers it, never aborts.
fn _t_out_of_range_values() {
    test_group("out_of_range_values");
    var bad = TM_QUARK_COUNT;
    var m: f64 = quark_mass_mev(bad);
    assert(m != m, "mass NaN");
    assert_eq(quark_generation(0 - 1), 0 - 1, "generation -1");
    assert_eq(lepton_is_stable(TM_LEPTON_COUNT), 0, "predicate 0");
    assert_eq(fundamental_force_mediator(TM_FUNDAMENTAL_FORCE_WEAK, 3), 0 - 1, "mediator k out of range");
    assert_eq(fundamental_force_mediator_count(TM_FUNDAMENTAL_FORCE_COUNT), 0, "count of a bad force");
}

# Runs every test and returns the failure count.
fn main(): i64 {
    _t_quark_masses_ordered();
    _t_lepton_masses_ordered();
    _t_force_strengths_ordered();
    _t_quark_charges();
    _t_boson_higgs_mass();
    _t_em_mediator_is_photon();
    _t_muon_lifetime();
    _t_tau_lifetime();
    _t_electron_is_stable();
    _t_neutrinos_stable();
    _t_w_boson_decay_width();
    _t_z_boson_decay_width();
    _t_photon_is_stable();
    _t_width_lifetime_consistency();
    _t_quark_generations();
    _t_lepton_all_masses();
    _t_lepton_all_charges();
    _t_lepton_all_generations();
    _t_boson_all_properties();
    _t_force_all_ranges();
    _t_force_all_mediators();
    _t_boson_gluon_is_stable();
    _t_tau_not_stable();
    _t_higgs_decay_width();
    _t_out_of_range_values();
    return assert_summary();
}

var exit_code = main();
if (exit_code > 0) { exit_code = 1; }
sys_exit_group(exit_code);
