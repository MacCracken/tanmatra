fn _t_series_wavelengths_decrease_with_n() {
    test_group("series_wavelengths_decrease_with_n");
    var ns[512];
    var nm[512];
    var t, cnt = balmer_series(1, 10, &ns, &nm, 64);
    assert_eq(is_ok(t), 1, "Balmer series Ok");
    var i = 1;
    while (i < cnt) {
        var cur: f64 = load64(&nm + i * 8);
        var prev: f64 = load64(&nm + (i - 1) * 8);
        assert(cur < prev, "Wavelength should decrease");
        i = i + 1;
    }
}

