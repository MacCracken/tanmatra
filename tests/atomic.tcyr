    test_group("electron_affinity_chlorine");
    var t, v = electron_affinity_ev(17);
    assert_eq(is_ok(t), 1, "Cl EA Ok");
    var ea_cl: f64 = v;
    assert(near(ea_cl, 3.613, 0.01), "Cl EA ~3.613 eV");
