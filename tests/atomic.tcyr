# atomic.tcyr — the reference-value tests of rust-old/src/atomic.rs, ported one for one, in
# order (each test_group is the Rust test's name). Not carried over (port plan §1): the four
# serde round-trip tests serde_roundtrip_orbital_type, serde_roundtrip_quantum_numbers,
# serde_roundtrip_orbital_filling and serde_roundtrip_transition_type (none of the four types is
# an M7 exchange type). Each Rust `.unwrap()` is an assert on the Ok tag before the payload is
# read. The golden corpus separately checks every function against the oracle on the M3 grid,
# in its tolerance class (tests/parity.tcyr).

include "tests/ulp.cyr"
include "src/error.cyr"
include "src/numerics.cyr"
include "src/constants.cyr"
include "src/particle_data.cyr"
include "src/particle.cyr"
include "src/relativity.cyr"
include "src/nucleus_data.cyr"
include "src/nucleus.cyr"
include "src/shell_model.cyr"
include "src/decay_data.cyr"
include "src/decay.cyr"
include "src/atomic_data.cyr"
include "src/atomic_config.cyr"
include "src/atomic_hydrogenic.cyr"
include "src/atomic_qed.cyr"

alloc_init();

# 1 if |a - b| < eps.
#must_use
fn near(a: f64, b: f64, eps: f64): i64 {
    if (f64_abs(a - b) < eps) { return 1; }
    return 0;
}

# 1 if a == b as f64s: rust's `==` on an f64 payload.
#must_use
fn _f64_eq(a: f64, b: f64): i64 {
    if (a == b) { return 1; }
    return 0;
}

# The Rust test module's mhz(ev): ev / H_EV_S / 1e6.
#must_use
fn _mhz(ev: f64): f64 {
    var m: f64 = (ev / TM_H_EV_S) / 1000000.0;
    return m;
}

# format_configuration(&electron_configuration(z).unwrap()), the unwrap an assert on the Ok.
#must_use
fn _config_full(z): Str {
    var cfg: TmOrbitalFilling[20];
    var t, n = electron_configuration(z, &cfg, 20);
    assert_eq(is_ok(t), 1, "electron_configuration Ok");
    if (is_ok(t) != 1) { n = 0; }
    return format_configuration(&cfg, n);
}

# format_configuration_short(&electron_configuration(z).unwrap(), z), the unwrap an assert on
# the Ok.
#must_use
fn _config_short(z): Str {
    var cfg: TmOrbitalFilling[20];
    var t, n = electron_configuration(z, &cfg, 20);
    assert_eq(is_ok(t), 1, "electron_configuration Ok");
    if (is_ok(t) != 1) { n = 0; }
    return format_configuration_short(&cfg, n, z);
}

# radial_probability_density(1, n, l, r).unwrap() for the normalization integral: an Err gives
# NaN, which fails that (n, l)'s norm assert as Rust's unwrap would fail the test (one assert
# per (n, l), not one per sample).
#must_use
fn _density(n, l, r: f64): f64 {
    var t, v = radial_probability_density(1, n, l, r);
    if (is_ok(t) != 1) { return _tm_nan(); }
    var p: f64 = v;
    return p;
}

fn _t_h_alpha_wavelength() {
    test_group("h_alpha_wavelength");
    var t, v = spectral_line_nm(1, 2, 3);
    assert_eq(is_ok(t), 1, "H-alpha Ok");
    var lambda: f64 = v;
    assert(near(lambda, 656.3, 1.0), "H-alpha ~656.3 nm");
}

fn _t_lyman_alpha() {
    test_group("lyman_alpha");
    var t, v = spectral_line_nm(1, 1, 2);
    assert_eq(is_ok(t), 1, "Lyman-alpha Ok");
    var lambda: f64 = v;
    assert(near(lambda, 121.6, 0.5), "Lyman-alpha ~121.6 nm");
}

fn _t_spectral_line_invalid() {
    test_group("spectral_line_invalid");
    assert_eq(is_err_result(spectral_line_nm(1, 0, 2)), 1, "n1 = 0 is Err");
    assert_eq(is_err_result(spectral_line_nm(1, 2, 2)), 1, "n1 = n2 is Err");
}

