    assert_eq(is_ok(t2), 1, "He+ 2P1/2 Ok");
    var p12: f64 = v2;
    var split: f64 = _mhz(s12 - p12);
    var d: f64 = f64_abs(split - 14041.13);
    assert(d / 14041.13 < 0.04, "He+ 2S1/2 - 2P1/2 = 14041.13 MHz to 4%");
}

