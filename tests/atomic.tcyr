fn _t_lamb_shift_hydrogen_classic() {
    test_group("lamb_shift_hydrogen_classic");
    var t1, v1 = lamb_shift_nlj_ev(1, 2, 0, 1);
    assert_eq(is_ok(t1), 1, "2S1/2 Ok");
    var s12: f64 = v1;
    var t2, v2 = lamb_shift_nlj_ev(1, 2, 1, 1);
    assert_eq(is_ok(t2), 1, "2P1/2 Ok");
    var p12: f64 = v2;
    var split: f64 = _mhz(s12 - p12);
    var d1: f64 = f64_abs(split - 1057.845);
    assert(d1 / 1057.845 < 0.003, "2S1/2 - 2P1/2 = 1057.845 MHz to 3e-3");
    var t3, v3 = lamb_shift_nlj_ev(1, 1, 0, 1);
    assert_eq(is_ok(t3), 1, "1S1/2 Ok");
    var e1s: f64 = v3;
    var one_s: f64 = _mhz(e1s);
    var d2: f64 = f64_abs(one_s - 8172.9);
    assert(d2 / 8172.9 < 0.003, "1S Lamb shift = 8172.9 MHz to 3e-3");
    var t4, v4 = lamb_shift_nlj_ev(1, 2, 1, 3);
    assert_eq(is_ok(t4), 1, "2P3/2 Ok");
    var e2p32: f64 = v4;
    var p32: f64 = _mhz(e2p32);
    assert(near(p32, 12.8, 0.5), "2P3/2 ~12.8 MHz");
}

