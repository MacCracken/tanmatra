    var e: f64 = v;
    var me: f64 = TM_ELECTRON_MASS_MEV;
    assert(e < me, "Dirac energy should be less than rest mass");
    assert(e > 0.5109, "Dirac energy should be close to rest mass");
}

fn _t_dirac_binding_hydrogen_1s() {
