fn _t_radial_wavefunctions_normalized() {
    test_group("radial_wavefunctions_normalized");
    var n = 1;
    while (n <= 10) {
        var l = 0;
        while (l < n) {
            var steps = 40000;
            var fsteps: f64 = f64_from(steps);
            var nn: f64 = f64_from(n * n);
            var r_max: f64 = (4.0 * nn) + 40.0;
            var h: f64 = r_max / fsteps;
            var f0: f64 = _density(n, l, 0.0);
            var fm: f64 = _density(n, l, r_max);
            var acc: f64 = f0 + fm;
            var k = 1;
            while (k < steps) {
                var w: f64 = 2.0;
                if ((k & 1) == 1) { w = 4.0; }
                var fk: f64 = f64_from(k);
                var fx: f64 = _density(n, l, fk * h);
                acc = acc + (w * fx);
                k = k + 1;
            }
            var norm: f64 = (acc * h) / 3.0;
            assert(near(norm, 1.0, 0.000000001), "Simpson norm of R_nl^2 r^2 = 1 (n <= 10, l < n)");
            l = l + 1;
        }
        n = n + 1;
    }
}

fn _t_radial_r31_matches_textbook() {
    test_group("radial_r31_matches_textbook");
    var rs[32];
    store64(&rs, 0.5);
    store64(&rs + 8, 2.0);
    store64(&rs + 16, 6.0);
    store64(&rs + 24, 9.0);
    var k = 0;
    while (k < 4) {
        var r: f64 = load64(&rs + k * 8);
        var root6: f64 = f64_sqrt(6.0);
        var mr: f64 = -r;
        var ex: f64 = f64_exp(mr / 3.0);
        var expected: f64 = (((8.0 / (27.0 * root6)) * (1.0 - (r / 6.0))) * r) * ex;
        var t, v = radial_wavefunction(1, 3, 1, r);
        assert_eq(is_ok(t), 1, "R_31(r) Ok");
        var got: f64 = v;
        assert(near(got, expected, 0.000000000000001), "R_31 = Griffiths eq. 4.89");
        k = k + 1;
    }
}

# One row of einstein_a_matches_nist_with_reduced_mass: A(nu lu -> nl ll) * mu within 2e-4 of
# the NIST value.
fn _einstein_a_nist_row(mu: f64, nu, lu, nl, ll, nist: f64) {
    var t, v = einstein_a_coefficient(1, nu, lu, nl, ll);
    assert_eq(is_ok(t), 1, "Einstein A Ok");
    var a0: f64 = v;
    var a: f64 = a0 * mu;
    var d: f64 = f64_abs(a - nist);
    var rel: f64 = d / nist;
    assert(rel < 0.0002, "A * mu matches NIST ASD to 2e-4");
}

fn _t_einstein_a_matches_nist_with_reduced_mass() {
    test_group("einstein_a_matches_nist_with_reduced_mass");
    var t, v = reduced_mass_factor(1, 1);
    assert_eq(is_ok(t), 1, "reduced_mass_factor(1, 1) Ok");
    var mu: f64 = v;
    _einstein_a_nist_row(mu, 2, 1, 1, 0, 626490000.0);
    _einstein_a_nist_row(mu, 3, 1, 1, 0, 167250000.0);
    _einstein_a_nist_row(mu, 3, 1, 2, 0, 22448000.0);
    _einstein_a_nist_row(mu, 3, 0, 2, 1, 6314300.0);
    _einstein_a_nist_row(mu, 3, 2, 2, 1, 64651000.0);
}

