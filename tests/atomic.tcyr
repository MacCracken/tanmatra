fn _t_radial_1s_at_origin() {
    test_group("radial_1s_at_origin");
    var t, v = radial_wavefunction(1, 1, 0, 0.0);
    assert_eq(is_ok(t), 1, "R_10(0) Ok");
    var r: f64 = v;
    assert(near(r, 2.0, 0.0000000001), "R_10(0) = 2");
}

fn _t_radial_1s_decays() {
    test_group("radial_1s_decays");
    var t1, v1 = radial_wavefunction(1, 1, 0, 1.0);
    assert_eq(is_ok(t1), 1, "R_10(1) Ok");
    var w1: f64 = v1;
    var r1: f64 = f64_abs(w1);
    var t5, v5 = radial_wavefunction(1, 1, 0, 5.0);
    assert_eq(is_ok(t5), 1, "R_10(5) Ok");
    var w5: f64 = v5;
    var r5: f64 = f64_abs(w5);
    assert(r1 > r5, "R_10 should decay with distance");
}

fn _t_radial_2s_has_node() {
    test_group("radial_2s_has_node");
    var t, v = radial_wavefunction(1, 2, 0, 2.0);
    assert_eq(is_ok(t), 1, "R_20(2) Ok");
    var r: f64 = v;
    var a: f64 = f64_abs(r);
    assert(a < 0.1, "R_20 should be near zero at r=2a0");
}

fn _t_probability_density_positive() {
    test_group("probability_density_positive");
    var t, v = radial_probability_density(1, 1, 0, 1.0);
    assert_eq(is_ok(t), 1, "P_10(1) Ok");
    var pd: f64 = v;
    assert(pd > 0.0, "Probability density must be positive");
}

fn _t_radial_invalid_quantum_numbers() {
    test_group("radial_invalid_quantum_numbers");
    assert_eq(is_err_result(radial_wavefunction(1, 0, 0, 1.0)), 1, "n = 0 is Err");
    assert_eq(is_err_result(radial_wavefunction(1, 1, 1, 1.0)), 1, "l >= n is Err");
    assert_eq(is_err_result(radial_wavefunction(1, 61, 0, 1.0)), 1, "n > 60 is Err");
    assert_eq(is_err_result(radial_wavefunction(0, 1, 0, 1.0)), 1, "Z = 0 is Err");
}

fn _t_selection_rules_allowed() {
    test_group("selection_rules_allowed");
    assert_eq(check_selection_rules(0, 1), TM_TRANSITION_TYPE_ELECTRIC_DIPOLE, "l 0 -> 1 is E1");
    assert_eq(check_selection_rules(1, 2), TM_TRANSITION_TYPE_ELECTRIC_DIPOLE, "l 1 -> 2 is E1");
    assert_eq(check_selection_rules(2, 1), TM_TRANSITION_TYPE_ELECTRIC_DIPOLE, "l 2 -> 1 is E1");
}

fn _t_selection_rules_forbidden() {
    test_group("selection_rules_forbidden");
    assert_eq(check_selection_rules(0, 0), TM_TRANSITION_TYPE_FORBIDDEN, "l 0 -> 0 is forbidden");
    assert_eq(check_selection_rules(0, 2), TM_TRANSITION_TYPE_FORBIDDEN, "l 0 -> 2 is forbidden");
    assert_eq(check_selection_rules(1, 3), TM_TRANSITION_TYPE_FORBIDDEN, "l 1 -> 3 is forbidden");
}

fn _t_selection_rules_full_with_ml() {
    test_group("selection_rules_full_with_ml");
    assert_eq(check_selection_rules_full(0, 0, 1, 0), TM_TRANSITION_TYPE_ELECTRIC_DIPOLE, "dl = 1, dml = 0 is E1");
    assert_eq(check_selection_rules_full(1, 0, 1, 0), TM_TRANSITION_TYPE_FORBIDDEN, "dl = 0 is forbidden");
    assert_eq(check_selection_rules_full(0, 0, 1, 2), TM_TRANSITION_TYPE_FORBIDDEN, "dml = 2 is forbidden");
}

