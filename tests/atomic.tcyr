fn _t_electron_affinity_noble_gases_zero() {
    test_group("electron_affinity_noble_gases_zero");
    var zs[48];
    store64(&zs, 2);
    store64(&zs + 8, 10);
    store64(&zs + 16, 18);
    store64(&zs + 24, 36);
    store64(&zs + 32, 54);
    store64(&zs + 40, 86);
    var k = 0;
    while (k < 6) {
        var z = load64(&zs + k * 8);
        var t, v = electron_affinity_ev(z);
        assert_eq(is_ok(t), 1, "noble gas EA Ok");
        var ea: f64 = v;
        var a: f64 = f64_abs(ea);
        assert(a < 0.0000000001, "Noble gas should have EA=0");
        k = k + 1;
    }
}

