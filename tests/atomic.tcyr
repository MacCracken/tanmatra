fn _t_ionization_energy_hydrogen() {
    test_group("ionization_energy_hydrogen");
    var t, v = ionization_energy_ev(1);
    assert_eq(is_ok(t), 1, "H IE Ok");
    var ie: f64 = v;
    assert(near(ie, 13.598, 0.01), "H IE ~13.598 eV");
}

fn _t_ionization_energy_helium() {
    test_group("ionization_energy_helium");
    var t, v = ionization_energy_ev(2);
    assert_eq(is_ok(t), 1, "He IE Ok");
    var ie: f64 = v;
    assert(near(ie, 24.587, 0.01), "He IE ~24.587 eV");
}

fn _t_ionization_energy_noble_gases_high() {
    test_group("ionization_energy_noble_gases_high");
    var t1, v1 = ionization_energy_ev(10);
    assert_eq(is_ok(t1), 1, "Ne IE Ok");
    var ne: f64 = v1;
    var t2, v2 = ionization_energy_ev(11);
    assert_eq(is_ok(t2), 1, "Na IE Ok");
    var na: f64 = v2;
    assert(ne > na, "Ne IE should be > Na IE");
    var t3, v3 = ionization_energy_ev(18);
    assert_eq(is_ok(t3), 1, "Ar IE Ok");
    var ar: f64 = v3;
    var t4, v4 = ionization_energy_ev(19);
    assert_eq(is_ok(t4), 1, "K IE Ok");
    var k: f64 = v4;
    assert(ar > k, "Ar IE should be > K IE");
}

fn _t_ionization_energy_invalid() {
    test_group("ionization_energy_invalid");
    assert_eq(is_err_result(ionization_energy_ev(0)), 1, "Z = 0 is Err");
    assert_eq(is_err_result(ionization_energy_ev(119)), 1, "Z = 119 is Err");
}

fn _t_ionization_energy_cesium_lowest_alkali() {
    test_group("ionization_energy_cesium_lowest_alkali");
    var t, v = ionization_energy_ev(55);
    assert_eq(is_ok(t), 1, "Cs IE Ok");
    var cs: f64 = v;
    assert(cs < 4.0, "Cs IE should be < 4 eV");
}

fn _t_ionization_energy_noble_gas_trend() {
    test_group("ionization_energy_noble_gas_trend");
    var t1, v1 = ionization_energy_ev(86);
    assert_eq(is_ok(t1), 1, "Rn IE Ok");
    var rn: f64 = v1;
    var t2, v2 = ionization_energy_ev(87);
    assert_eq(is_ok(t2), 1, "Fr IE Ok");
    var fr: f64 = v2;
    assert(rn > fr, "Rn IE should be > Fr IE");
}

fn _t_ionization_energy_lanthanide_range() {
    test_group("ionization_energy_lanthanide_range");
    var z = 57;
    while (z <= 71) {
        var t, v = ionization_energy_ev(z);
        assert_eq(is_ok(t), 1, "lanthanide IE Ok");
        var ie: f64 = v;
        var in_range = 0;
        if (ie > 5.0 && ie < 6.5) { in_range = 1; }
        assert(in_range, "lanthanide IE in (5.0, 6.5) eV");
        z = z + 1;
    }
}

fn _t_quantum_numbers_valid() {
    test_group("quantum_numbers_valid");
    var q: TmQuantumNumbers;
    assert_eq(is_ok(TmQuantumNumbers_new(1, 0, 0, 1, &q)), 1, "(1, 0, 0, +1/2) Ok");
    assert_eq(is_ok(TmQuantumNumbers_new(2, 1, 0 - 1, 0 - 1, &q)), 1, "(2, 1, -1, -1/2) Ok");
    assert_eq(is_ok(TmQuantumNumbers_new(3, 2, 2, 1, &q)), 1, "(3, 2, 2, +1/2) Ok");
}

fn _t_quantum_numbers_invalid() {
    test_group("quantum_numbers_invalid");
    var q: TmQuantumNumbers;
    assert_eq(is_err_result(TmQuantumNumbers_new(0, 0, 0, 1, &q)), 1, "n = 0 is Err");
    assert_eq(is_err_result(TmQuantumNumbers_new(1, 1, 0, 1, &q)), 1, "l >= n is Err");
    assert_eq(is_err_result(TmQuantumNumbers_new(2, 1, 2, 1, &q)), 1, "|ml| > l is Err");
    assert_eq(is_err_result(TmQuantumNumbers_new(1, 0, 0, 2, &q)), 1, "ms not +/-1 is Err");
}

fn _t_orbital_max_electrons() {
    test_group("orbital_max_electrons");
    assert_eq(orbital_type_max_electrons(TM_ORBITAL_TYPE_S), 2, "s holds 2");
    assert_eq(orbital_type_max_electrons(TM_ORBITAL_TYPE_P), 6, "p holds 6");
    assert_eq(orbital_type_max_electrons(TM_ORBITAL_TYPE_D), 10, "d holds 10");
    assert_eq(orbital_type_max_electrons(TM_ORBITAL_TYPE_F), 14, "f holds 14");
}

fn _t_hydrogen_ground_state_energy() {
    test_group("hydrogen_ground_state_energy");
    var t, v = hydrogen_level_energy_ev(1, 1, 1);
    assert_eq(is_ok(t), 1, "H 1s1/2 Ok");
    var e: f64 = v;
    assert(near(e, -13.6, 0.01), "H 1s1/2 ~-13.6 eV");
}

fn _t_fine_structure_splits_levels() {
    test_group("fine_structure_splits_levels");
    var t1, v1 = hydrogen_level_energy_ev(1, 2, 1);
    assert_eq(is_ok(t1), 1, "2s1/2 Ok");
    var e_s: f64 = v1;
    var t2, v2 = hydrogen_level_energy_ev(1, 2, 3);
    assert_eq(is_ok(t2), 1, "2p3/2 Ok");
    var e_p32: f64 = v2;
    var d: f64 = f64_abs(e_s - e_p32);
    assert(d > 0.000001, "Fine structure should split n=2 levels");
}

fn _t_h_alpha_fine_structure() {
    test_group("h_alpha_fine_structure");
    var t, v = spectral_line_fine_nm(1, 2, 3, 3, 5);
    assert_eq(is_ok(t), 1, "2p3/2 - 3d5/2 Ok");
    var lambda: f64 = v;
    assert(near(lambda, 656.3, 2.0), "H-alpha fine ~656 nm");
}

fn _t_fine_structure_invalid() {
    test_group("fine_structure_invalid");
    assert_eq(is_err_result(hydrogen_level_energy_ev(1, 0, 1)), 1, "n = 0 is Err");
    assert_eq(is_err_result(hydrogen_level_energy_ev(1, 1, 3)), 1, "j = 3/2 at n = 1 is Err");
}

fn _t_lande_g_s_electron() {
    test_group("lande_g_s_electron");
    var g: f64 = lande_g_factor(0, 1);
    assert(near(g, 2.0, 0.0000000001), "g(1s1/2) = 2");
}

fn _t_lande_g_p32() {
    test_group("lande_g_p32");
    var g: f64 = lande_g_factor(1, 3);
    var expected: f64 = 4.0 / 3.0;
    assert(near(g, expected, 0.0000000001), "g(2p3/2) = 4/3");
}

fn _t_zeeman_zero_field() {
    test_group("zeeman_zero_field");
    var de: f64 = zeeman_splitting_ev(0, 1, 1, 0.0);
    var a: f64 = f64_abs(de);
    assert(a < 0.000000000000000000000000000001, "No splitting in zero field");
}

fn _t_zeeman_proportional_to_field() {
    test_group("zeeman_proportional_to_field");
    var de1: f64 = zeeman_splitting_ev(0, 1, 1, 1.0);
    var de2: f64 = zeeman_splitting_ev(0, 1, 1, 2.0);
    var d: f64 = f64_abs(de2 - (2.0 * de1));
    assert(d < 0.000000000000001, "Zeeman should be linear in B");
}

fn _t_stark_zero_field() {
    test_group("stark_zero_field");
    var de: f64 = stark_shift_hydrogen_ev(2, 1, 0.0);
    var a: f64 = f64_abs(de);
    assert(a < 0.000000000000000000000000000001, "no Stark shift in zero field");
}

fn _t_stark_proportional_to_field() {
    test_group("stark_proportional_to_field");
    var de1: f64 = stark_shift_hydrogen_ev(2, 1, 1000000.0);
    var de2: f64 = stark_shift_hydrogen_ev(2, 1, 2000000.0);
    var d: f64 = f64_abs(de2 - (2.0 * de1));
    assert(d < 0.00000000000000000001, "Stark should be linear in F");
}

fn _t_stark_increases_with_n() {
    test_group("stark_increases_with_n");
    var s2: f64 = stark_shift_hydrogen_ev(2, 1, 100000000.0);
    var de2: f64 = f64_abs(s2);
    var s5: f64 = stark_shift_hydrogen_ev(5, 4, 100000000.0);
    var de5: f64 = f64_abs(s5);
    assert(de5 > de2, "n=5 Stark should be larger than n=2");
}

