fn _t_hydrogen_config() {
    test_group("hydrogen_config");
    var cfg: TmOrbitalFilling[20];
    var t, n = electron_configuration(1, &cfg, 20);
    assert_eq(is_ok(t), 1, "H configuration Ok");
    assert_eq(n, 1, "one subshell");
    var e: *TmOrbitalFilling = &cfg;
    assert_eq(e.n, 1, "config[0].n = 1");
    assert_eq(e.orbital, TM_ORBITAL_TYPE_S, "config[0].orbital = S");
    assert_eq(e.electrons, 1, "config[0].electrons = 1");
}

fn _t_helium_config() {
    test_group("helium_config");
    var full = _config_full(2);
    assert_eq(str_eq_cstr(full, "1s2"), 1, "He 1s2");
}

fn _t_noble_gas_neon() {
    test_group("noble_gas_neon");
    var full = _config_full(10);
    assert_eq(str_eq_cstr(full, "1s2 2s2 2p6"), 1, "Ne 1s2 2s2 2p6");
}

fn _t_total_electrons_match_z() {
    test_group("total_electrons_match_z");
    var cfg: TmOrbitalFilling[20];
    var base: *TmOrbitalFilling = &cfg;
    var z = 1;
    while (z <= 118) {
        var t, n = electron_configuration(z, base, 20);
        assert_eq(is_ok(t), 1, "electron_configuration Ok");
        var total = 0;
        var k = 0;
        while (k < n) {
            var e: *TmOrbitalFilling = base + k;
            total = total + e.electrons;
            k = k + 1;
        }
        assert_eq(total, z, "total electrons = Z");
        z = z + 1;
    }
}

