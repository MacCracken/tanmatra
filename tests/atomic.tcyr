fn _t_h_alpha_vacuum_with_reduced_mass() {
    test_group("h_alpha_vacuum_with_reduced_mass");
    var t, v = spectral_line_vacuum_nm(1, 1, 2, 3);
    assert_eq(is_ok(t), 1, "H-alpha vacuum Ok");
    var lambda: f64 = v;
    assert(near(lambda, 656.4696, 0.001), "H-alpha 656.4696 nm");
}

fn _t_fine_structure_uses_codata_rydberg() {
    test_group("fine_structure_uses_codata_rydberg");
    var t1, v1 = hydrogen_level_energy_ev(1, 1, 1);
    assert_eq(is_ok(t1), 1, "H 1s1/2 first-order Ok");
    var e: f64 = v1;
    var t2, v2 = dirac_binding_energy_ev(1, 1, 1);
    assert_eq(is_ok(t2), 1, "H 1s1/2 Dirac binding Ok");
    var b: f64 = v2;
    var dirac: f64 = -b;
    assert(near(e, dirac, 0.00000001), "first-order = Dirac to 1e-8 eV");
    assert_eq(is_err_result(hydrogen_level_energy_ev(1, 2, 2)), 1, "2j = 2 is Err");
}

fn _t_dirac_rejects_j_above_n() {
    test_group("dirac_rejects_j_above_n");
    assert_eq(is_err_result(dirac_energy_mev(1, 1, 3)), 1, "j = 3/2 at n = 1 is Err");
}

fn _t_ionization_energy_reference_values() {
    test_group("ionization_energy_reference_values");
    var t1, v1 = ionization_energy_ev(43);
    assert_eq(is_ok(t1), 1, "Tc IE Ok");
    var tc: f64 = v1;
    assert(near(tc, 7.11938, 0.000000001), "Tc IE 7.11938 eV (NIST ASD)");
    var t2, v2 = ionization_energy_ev(96);
    assert_eq(is_ok(t2), 1, "Cm IE Ok");
    var cm: f64 = v2;
    assert(near(cm, 5.992241, 0.000000001), "Cm IE 5.992241 eV (NIST ASD)");
    var t3, v3 = ionization_energy_ev(112);
    assert_eq(is_ok(t3), 1, "Cn IE Ok");
    var cn: f64 = v3;
    assert(near(cn, 12.02, 0.000000001), "Cn IE 12.02 eV (Smits et al. 2023)");
}

fn _t_electron_affinity_reference_values() {
    test_group("electron_affinity_reference_values");
    var t1, k1 = electron_affinity(90);
    assert_eq(is_ok(t1), 1, "Th EA Ok");
    assert_eq(k1, TM_ELECTRON_AFFINITY_BOUND, "Th EA is Bound");
    var e1, v1 = electron_affinity_ev(90);
    assert_eq(is_ok(e1), 1, "Th EA value Ok");
    var th: f64 = v1;
    assert(_f64_eq(th, 0.60769), "Th EA Bound(0.60769)");
    var t2, k2 = electron_affinity(92);
    assert_eq(is_ok(t2), 1, "U EA Ok");
    assert_eq(k2, TM_ELECTRON_AFFINITY_BOUND, "U EA is Bound");
    var e2, v2 = electron_affinity_ev(92);
    assert_eq(is_ok(e2), 1, "U EA value Ok");
    var u: f64 = v2;
    assert(_f64_eq(u, 0.31497), "U EA Bound(0.31497)");
    var t3, k3 = electron_affinity(2);
    assert_eq(is_ok(t3), 1, "He EA Ok");
    assert_eq(k3, TM_ELECTRON_AFFINITY_UNBOUND, "He EA is Unbound");
    var t4, k4 = electron_affinity(104);
    assert_eq(is_ok(t4), 1, "Rf EA Ok");
    assert_eq(k4, TM_ELECTRON_AFFINITY_UNKNOWN, "Rf EA is Unknown");
    var t5, v5 = electron_affinity_ev(59);
    assert_eq(is_ok(t5), 1, "Pr EA Ok");
    var pr: f64 = v5;
    assert(near(pr, 0.10923, 0.000000000001), "Pr EA 0.10923 eV");
}

fn _t_superheavy_configurations_follow_madelung() {
    test_group("superheavy_configurations_follow_madelung");
    var ds = _config_short(110);
    assert_eq(str_eq_cstr(ds, "[Rn] 7s2 5f14 6d8"), 1, "Ds [Rn] 7s2 5f14 6d8");
    var rg = _config_short(111);
    assert_eq(str_eq_cstr(rg, "[Rn] 7s2 5f14 6d9"), 1, "Rg [Rn] 7s2 5f14 6d9");
}

fn _t_stark_and_lande_reject_impossible_states() {
    test_group("stark_and_lande_reject_impossible_states");
    var s: f64 = stark_shift_hydrogen_ev(2, 5, 1000000.0);
    var sa: f64 = f64_abs(s);
    assert(sa < 0.000000000000000000000000000001, "|k| > n - 1: no Stark shift");
    var g: f64 = lande_g_factor(0, 3);
    var ga: f64 = f64_abs(g);
    assert(ga < 0.000000000000000000000000000001, "j = 3/2 at l = 0: g = 0");
}

