}

fn _t_dirac_binding_hydrogen_2s_2p() {
    test_group("dirac_binding_hydrogen_2s_2p");
    var t1, v1 = dirac_energy_mev(1, 2, 1);
    assert_eq(is_ok(t1), 1, "2s1/2 Ok");
    var e_2s: f64 = v1;
    var t2, v2 = dirac_energy_mev(1, 2, 1);
    assert_eq(is_ok(t2), 1, "2p1/2 Ok");
    var e_2p: f64 = v2;
    assert(near(e_2s, e_2p, 0.000000000000001), "2s1/2 and 2p1/2 have same Dirac energy");
    var t3, v3 = dirac_energy_mev(1, 2, 3);
    assert_eq(is_ok(t3), 1, "2p3/2 Ok");
    var e_2p32: f64 = v3;
    var d: f64 = f64_abs(e_2s - e_2p32);
    assert(d > 0.000000000001, "2s1/2 and 2p3/2 should differ");
}

fn _t_dirac_binding_scales_with_z() {
