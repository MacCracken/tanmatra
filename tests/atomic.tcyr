fn _t_lamb_shift_grows_with_z() {
    test_group("lamb_shift_grows_with_z");
    var he: f64 = lamb_shift_ev(2, 2, 0);
    var h: f64 = lamb_shift_ev(1, 2, 0);
    assert(he > h, "He+ 2S Lamb shift > H 2S");
}

