fn _t_lyman_series_hydrogen() {
    test_group("lyman_series_hydrogen");
    var ns[512];
    var nm[512];
    var t, cnt = lyman_series(1, 6, &ns, &nm, 64);
    assert_eq(is_ok(t), 1, "Lyman series Ok");
    assert_eq(cnt, 5, "n = 2..=6: five lines");
    var first: f64 = load64(&nm);
    assert(near(first, 121.6, 0.5), "Ly-alpha ~121.6 nm");
    var last: f64 = load64(&nm + (cnt - 1) * 8);
    assert(last > 91.0, "converges toward the 91.2 nm limit");
}

fn _t_balmer_series_hydrogen() {
    test_group("balmer_series_hydrogen");
    var ns[512];
    var nm[512];
    var t, cnt = balmer_series(1, 8, &ns, &nm, 64);
    assert_eq(is_ok(t), 1, "Balmer series Ok");
    assert_eq(cnt, 6, "n = 3..=8: six lines");
    var h_alpha: f64 = load64(&nm);
    assert(near(h_alpha, 656.3, 1.0), "H-alpha ~656.3 nm");
    var h_beta: f64 = load64(&nm + 8);
    assert(near(h_beta, 486.1, 1.0), "H-beta ~486.1 nm");
}

fn _t_paschen_series_hydrogen() {
