fn _t_shell_occupation_he4() {
    test_group("shell_occupation_he4");
    var lvs[256];
    var occ[256];
    var cnt = shell_occupation(2, &lvs, &occ, 32);
    assert_eq(cnt, 1, "one level occupied");
    assert_eq(load64(&occ), 2, "1s1/2 fully filled");
}

fn _t_shell_closure_functions() {
    test_group("shell_closure_functions");
    assert_eq(shell_closure_below(10), 8, "closure below 10 = 8");
    assert_eq(shell_closure_below(28), 28, "closure below 28 = 28");
    assert_eq(shell_closure_below(1), 0, "closure below 1 = 0");
    var t20, v20 = next_shell_closure(20);
    assert(is_some(t20) == 1 && v20 == 28, "next closure after 20 = Some(28)");
    var t82, v82 = next_shell_closure(82);
    assert(is_some(t82) == 1 && v82 == 126, "next closure after 82 = Some(126)");
    assert_eq(is_none(next_shell_closure(200)), 1, "next closure after 200 = None");
}

