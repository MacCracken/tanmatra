fn _t_superallowed_ft_values_count() {
    test_group("superallowed_ft_values_count");
    assert_eq(superallowed_ft_value_count(), 9, "should have 9 superallowed transitions");
}

fn _t_superallowed_ft_values_range() {
    test_group("superallowed_ft_values_range");
    var cnt = superallowed_ft_value_count();
    var k = 0;
    while (k < cnt) {
        var d = superallowed_ft_value(k);
        var ft: f64 = d.ft_seconds;
        assert(ft > 3030.0 && ft < 3080.0, "ft out of range");
        k = k + 1;
    }
}

fn _t_superallowed_parent_daughter_consistency() {
    test_group("superallowed_parent_daughter_consistency");
    var cnt = superallowed_ft_value_count();
    var k = 0;
    while (k < cnt) {
        var d = superallowed_ft_value(k);
        assert_eq(nucleus_a(d.parent), nucleus_a(d.daughter), "Parent A != daughter A");
        assert_eq(nucleus_z(d.parent), nucleus_z(d.daughter) + 1, "Parent Z should be daughter Z + 1");
        k = k + 1;
    }
}

# The index of the first superallowed transition whose parent has mass number a, or -1:
# rust `superallowed_ft_values().iter().find(|d| d.parent.a() == a)`.
#must_use
fn _superallowed_find(a): i64 {
    var cnt = superallowed_ft_value_count();
    var k = 0;
    while (k < cnt) {
        var d = superallowed_ft_value(k);
        if (nucleus_a(d.parent) == a) { return k; }
        k = k + 1;
    }
    return 0 - 1;
}

fn _t_superallowed_corrected_ft_per_transition() {
    test_group("superallowed_corrected_ft_per_transition");
    var eps: f64 = 0.000000001;
    var k14 = _superallowed_find(14);
    assert(k14 >= 0, "O-14 transition found");
    if (k14 >= 0) {
        var o14: TmSuperallowedDecay = superallowed_ft_value(k14);
        var ft: f64 = o14.ft_seconds;
        assert(near(ft, 3042.2, eps), "O-14 ft 3042.2 s");
        var t14, v14 = o14.corrected_ft_seconds();
        assert_eq(is_some(t14), 1, "O-14 corrected Ft tabulated");
        var big14: f64 = v14;
        assert(near(big14, 3070.2, eps), "O-14 Ft 3070.2 s");
    }
    var k62 = _superallowed_find(62);
    assert(k62 >= 0, "Ga-62 transition found");
    if (k62 >= 0) {
        var ga62: TmSuperallowedDecay = superallowed_ft_value(k62);
        var t62, v62 = ga62.corrected_ft_seconds();
        assert_eq(is_some(t62), 1, "Ga-62 corrected Ft tabulated");
        var big62: f64 = v62;
        assert(near(big62, 3072.4, eps), "Ga-62 Ft 3072.4 s");
    }
}

fn _t_semf_close_to_ame2020() {
    test_group("semf_close_to_ame2020");
    var b_fe: f64 = nucleus_binding_energy(_new_nucleus(26, 56));
    assert(near(b_fe, 492.2600, 12.0), "Fe-56 B within 12 MeV of AME2020");
    var b_pb: f64 = nucleus_binding_energy(_new_nucleus(82, 208));
    assert(near(b_pb, 1636.4301, 12.0), "Pb-208 B within 12 MeV of AME2020");
    var b_sn: f64 = nucleus_binding_energy(_new_nucleus(50, 120));
    assert(near(b_sn, 1020.5448, 12.0), "Sn-120 B within 12 MeV of AME2020");
}

# 1 if the shell-corrected binding energy of (z, a) is closer to b_exp than the liquid-drop one.
#must_use
fn _shell_improves(z, a, b_exp: f64): i64 {
    var nuc = _new_nucleus(z, a);
    var b: f64 = nucleus_binding_energy(nuc);
    var bs: f64 = nucleus_binding_energy_shell_corrected(nuc);
    var err_ldm: f64 = f64_abs(b - b_exp);
    var err_shell: f64 = f64_abs(bs - b_exp);
    if (err_shell < err_ldm) { return 1; }
    return 0;
}

fn _t_shell_correction_improves_doubly_magic() {
    test_group("shell_correction_improves_doubly_magic");
    assert_eq(_shell_improves(28, 56, 483.9956), 1, "Ni-56 shell correction improves B");
    assert_eq(_shell_improves(50, 132, 1102.8432), 1, "Sn-132 shell correction improves B");
    assert_eq(_shell_improves(82, 208, 1636.4301), 1, "Pb-208 shell correction improves B");
}

fn _t_shell_term_sign_at_magic_and_midshell() {
    test_group("shell_term_sign_at_magic_and_midshell");
    var s_pb: f64 = _tm_ms_shell_term(82, 126);
    var s_er: f64 = _tm_ms_shell_term(68, 98);
    assert(s_pb < 0.0, "doubly magic Pb-208: extra binding");
    assert(s_er > 0.0, "mid-shell Er-166: less binding");
}

fn _t_atomic_mass_includes_electrons() {
    test_group("atomic_mass_includes_electrons");
    var fe = nucleus_iron_56();
    var atomic: f64 = nucleus_atomic_mass_amu(fe);
    var nuclear: f64 = nucleus_nuclear_mass_amu(fe);
    var diff: f64 = atomic - nuclear;
    assert(near(diff, 0.0142257, 0.0000001), "26 electrons minus their binding, u");
}

fn _t_odd_odd_spin_is_integer() {
    test_group("odd_odd_spin_is_integer");
    var z = 1;
    while (z <= 99) {
        var a = 2 * z;
        while (a <= 2 * z + 60) {
            if (z % 2 == 1 && (a - z) % 2 == 1) {
                var two_j, parity = ground_state_spin_parity(_new_nucleus(z, a));
                assert_eq(two_j % 2, 0, "odd-odd gave half-integer spin");
            }
            a = a + 1;
        }
        z = z + 1;
    }
}

# 1 if ground_state_spin_parity(Nucleus::new(z, a)) is (two_j, parity).
#must_use
fn _spin_parity_is(z, a, two_j, parity): i64 {
    var got_j, got_p = ground_state_spin_parity(_new_nucleus(z, a));
    if (got_j == two_j && got_p == parity) { return 1; }
    return 0;
}

fn _t_spin_parity_reference_nuclei() {
    test_group("spin_parity_reference_nuclei");
    var minus = 0 - 1;
    assert_eq(_spin_parity_is(7, 14, 2, 1), 1, "N-14 1+");
    assert_eq(_spin_parity_is(5, 10, 6, 1), 1, "B-10 3+");
    assert_eq(_spin_parity_is(19, 40, 8, minus), 1, "K-40 4-");
    assert_eq(_spin_parity_is(17, 38, 4, minus), 1, "Cl-38 2-");
    assert_eq(_spin_parity_is(82, 207, 1, minus), 1, "Pb-207 1/2-");
    assert_eq(_spin_parity_is(83, 209, 9, minus), 1, "Bi-209 9/2-");
    assert_eq(_spin_parity_is(8, 17, 5, 1), 1, "O-17 5/2+");
    assert_eq(_spin_parity_is(20, 41, 7, minus), 1, "Ca-41 7/2-");
}

fn _t_spin_zero_or_half_has_no_quadrupole() {
    test_group("spin_zero_or_half_has_no_quadrupole");
    var k = 0;
    while (k < TM_NUCLEAR_MOMENTS_COUNT) {
        var z = TM_NUCLEAR_MOMENTS_Z[k];
        var a = TM_NUCLEAR_MOMENTS_A[k];
        var two_j = 2;
        if (z == 9 && a == 19) { two_j = 1; }
        if (z == 1 && a == 1) { two_j = 1; }
        if (z == 2 && a == 3) { two_j = 1; }
        if (z == 6 && a == 13) { two_j = 1; }
        if (z == 15 && a == 31) { two_j = 1; }
        if (z == 82 && a == 207) { two_j = 1; }
        if (two_j <= 1) {
            var q: f64 = TM_NUCLEAR_MOMENTS_Q_BARN[k];
            assert(f64_abs(q) < 0.000000000000001, "spin <= 1/2 but Q != 0");
        }
        k = k + 1;
    }
}

fn _t_corrected_ft_value_returns_average_superallowed_part() {
    test_group("corrected_ft_value_returns_average (superallowed_average_ft assert)");
    var ft, unc = superallowed_average_ft();
    var f: f64 = ft;
    var u: f64 = unc;
    assert(f == 3072.24, "average Ft 3072.24 s");
    assert(u == 1.85, "uncertainty 1.85 s");
}

