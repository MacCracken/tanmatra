}

fn _t_invalid_a_less_than_z() {
    test_group("invalid_a_less_than_z");
    assert_eq(is_err_result(nucleus_new(10, 5)), 1, "A < Z is Err");
}

fn _t_mass_defect_equals_binding_energy() {
    test_group("mass_defect_equals_binding_energy");
    var c12 = nucleus_carbon_12();
    var md: f64 = nucleus_mass_defect(c12);
    var be: f64 = nucleus_binding_energy(c12);
    assert(f64_abs(md - be) < 0.0000000001, "mass defect = BE");
}

fn _t_binding_energy_increases_with_a_midrange() {
    test_group("binding_energy_increases_with_a_midrange");
    var c12 = nucleus_carbon_12();
    var fe56 = nucleus_iron_56();
    var b_c: f64 = nucleus_binding_energy(c12);
    var b_fe: f64 = nucleus_binding_energy(fe56);
    assert(b_fe > b_c, "BE(Fe-56) > BE(C-12)");
}

fn _t_bea_peaks_around_iron() {
    test_group("bea_peaks_around_iron");
    var o16 = _new_nucleus(8, 16);
    var fe56 = nucleus_iron_56();
    var u238 = nucleus_uranium_238();
    var bea_o: f64 = nucleus_binding_energy_per_nucleon(o16);
    var bea_fe: f64 = nucleus_binding_energy_per_nucleon(fe56);
    var bea_u: f64 = nucleus_binding_energy_per_nucleon(u238);
    assert(bea_fe > bea_o, "Fe-56 B/A should exceed O-16 B/A");
    assert(bea_fe > bea_u, "Fe-56 B/A should exceed U-238 B/A");
}

fn _t_nuclear_mass_reasonable() {
    test_group("nuclear_mass_reasonable");
    var fe56 = nucleus_iron_56();
    var mass: f64 = nucleus_nuclear_mass(fe56);
    assert(mass > 52000.0, "Fe-56 mass too low");
    assert(mass < 52500.0, "Fe-56 mass too high");
}

# The magic numbers the shell model's cumulative filling must reach, in order.
var _MAGIC: u16[7] = { 2, 8, 20, 28, 50, 82, 126 };

fn _t_shell_model_reproduces_magic_numbers() {
    test_group("shell_model_reproduces_magic_numbers");
    var cumulative = 0;
    var magic_idx = 0;
    var cnt = shell_model_level_count();
    var k = 0;
    while (k < cnt) {
        var lv = shell_model_level(k);
        cumulative = cumulative + shell_level_two_j(lv) + 1;
        if (magic_idx < 7) {
            if (cumulative == _MAGIC[magic_idx]) { magic_idx = magic_idx + 1; }
        }
        k = k + 1;
    }
    assert_eq(magic_idx, 7, "not all magic numbers found in shell model");
}

fn _t_shell_level_labels() {
    test_group("shell_level_labels");
    var level = shell_level_new(1, 3, 7);
    var lab = shell_level_label(level);
    assert_eq(str_eq_cstr(lab, "1f7/2"), 1, "label 1f7/2");
    assert_eq(shell_level_degeneracy(level), 8, "degeneracy 8");
}

