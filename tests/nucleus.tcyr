# nucleus.tcyr — the reference-value tests of rust-old/src/nucleus.rs, ported one for one
# (each test_group is the Rust test's name). Not carried over (port plan §1): the four serde
# round-trip tests serde_roundtrip, serde_roundtrip_shell_level,
# serde_roundtrip_nuclear_moments and serde_roundtrip_superallowed_decay; and the
# corrected_ft_value half of corrected_ft_value_returns_average (deprecated in 1.3.0). That
# test's other assert, on superallowed_average_ft, is ported as
# _t_corrected_ft_value_returns_average_superallowed_part. The golden corpus separately
# checks every function bit for bit on the M2 grid (tests/parity.tcyr).

include "tests/ulp.cyr"
include "src/error.cyr"
include "src/numerics.cyr"
include "src/constants.cyr"
include "src/particle_data.cyr"
include "src/particle.cyr"
include "src/relativity.cyr"
include "src/nucleus_data.cyr"
include "src/nucleus.cyr"
include "src/shell_model.cyr"

alloc_init();

# 1 if |a - b| < eps.
#must_use
fn near(a: f64, b: f64, eps: f64): i64 {
    if (f64_abs(a - b) < eps) { return 1; }
    return 0;
}

# Nucleus::new(z, a).unwrap(): the nucleus word, aborting on Err.
#must_use
fn _new_nucleus(z, a): i64 {
    var t, v = nucleus_new(z, a);
    return result_unwrap(t, v);
}

fn _t_fe56_binding_energy_per_nucleon() {
    test_group("fe56_binding_energy_per_nucleon");
    var fe56 = nucleus_iron_56();
    var bea: f64 = nucleus_binding_energy_per_nucleon(fe56);
    assert(bea > 8.6, "Fe-56 B/A too low");
    assert(bea < 9.0, "Fe-56 B/A too high");
}

fn _t_he4_binding_energy_positive() {
    test_group("he4_binding_energy_positive");
    var he4 = nucleus_helium_4();
    var be: f64 = nucleus_binding_energy(he4);
    assert(be > 15.0, "He-4 BE too low");
    assert(be < 35.0, "He-4 BE within expected range");
}

fn _t_hydrogen_has_zero_binding_energy() {
    test_group("hydrogen_has_zero_binding_energy");
    var h1 = nucleus_hydrogen_1();
    var be: f64 = nucleus_binding_energy(h1);
    assert(f64_abs(be) < 0.0000000001, "H-1 BE 0");
}

fn _t_nuclear_radius_fe56() {
    test_group("nuclear_radius_fe56");
    var fe56 = nucleus_iron_56();
    var r: f64 = nucleus_nuclear_radius(fe56);
    assert(near(r, 4.59, 0.1), "Fe-56 radius ~4.59 fm");
}

fn _t_magic_numbers() {
    test_group("magic_numbers");
    assert_eq(is_magic_number(2), 1, "2 magic");
    assert_eq(is_magic_number(8), 1, "8 magic");
    assert_eq(is_magic_number(20), 1, "20 magic");
    assert_eq(is_magic_number(28), 1, "28 magic");
    assert_eq(is_magic_number(50), 1, "50 magic");
    assert_eq(is_magic_number(82), 1, "82 magic");
    assert_eq(is_magic_number(126), 1, "126 magic");
    assert_eq(is_magic_number(3), 0, "3 not magic");
    assert_eq(is_magic_number(100), 0, "100 not magic");
}

fn _t_doubly_magic_he4() {
    test_group("doubly_magic_he4");
    var he4 = nucleus_helium_4();
    assert_eq(nucleus_is_doubly_magic(he4), 1, "He-4 Z=2 N=2 doubly magic");
}

