fn _t_sagnac_one_way_equatorial_loop() {
    test_group("sagnac_one_way_equatorial_loop");
    var r: f64 = 6378137.0;
    var steps = 3600;
    var fsteps: f64 = f64_from(steps);
    var total: f64 = 0.0;
    var k = 0;
    while (k < steps) {
        var fk: f64 = f64_from(k);
        var fk1: f64 = f64_from(k + 1);
        var a1: f64 = ((2.0 * _TM_PI) * fk) / fsteps;
        var a2: f64 = ((2.0 * _TM_PI) * fk1) / fsteps;
        var c1: f64 = f64_cos(a1);
        var s1: f64 = f64_sin(a1);
        var c2: f64 = f64_cos(a2);
        var s2: f64 = f64_sin(a2);
        var hop: f64 = sagnac_one_way_ns(r * c1, r * s1, r * c2, r * s2);
        total = total + hop;
        k = k + 1;
    }
    var exact: f64 = (((((2.0 * TM_EARTH_ROTATION_RAD_S) * _TM_PI) * r) * r) / (TM_C * TM_C)) * 1000000000.0;
    assert(near(exact, 207.39, 0.01), "2 Omega (pi R^2) / c^2 = 207.39 ns");
    assert(f64_abs(total - exact) / exact < 0.00001, "one-way hops sum to the loop value");
}

fn _t_cipm_2025_frequencies() {
    test_group("cipm_2025_frequencies");
    var sr: f64 = frequency_standard_transition_frequency_hz(TM_FREQUENCY_STANDARD_STRONTIUM_OPTICAL);
    assert(near(sr, 429228004229872.992, 0.07), "Sr CIPM 2025");
    var yb: f64 = frequency_standard_transition_frequency_hz(TM_FREQUENCY_STANDARD_YTTERBIUM_OPTICAL);
    assert(near(yb, 518295836590863.632, 0.07), "Yb CIPM 2025");
    var rb: f64 = frequency_standard_transition_frequency_hz(TM_FREQUENCY_STANDARD_RUBIDIUM87);
    assert(near(rb, 6834682610.9043129, 0.000001), "Rb CIPM 2025");
    var q: f64 = frequency_standard_quality_factor_for_linewidth(TM_FREQUENCY_STANDARD_CESIUM133, 1.0);
    assert(near(q, 9192631770.0, 0.001), "Cs Q at 1 Hz linewidth");
}

fn _t_tcg_and_tdb_at_j2000() {
    test_group("tcg_and_tdb_at_j2000");
    var jd: f64 = 2451545.0;
    var tcg_tt: f64 = tcg_minus_tt_seconds(jd);
    assert(near(tcg_tt, 0.505833, 0.000001), "TCG - TT at J2000 ~0.505833 s");
    var tcg: f64 = tt_to_tcg_jd(jd);
    var tt: f64 = tcg_to_tt_jd(tcg);
    assert(near(tt, jd, 0.000000001), "TT -> TCG -> TT");
    var tdb: f64 = tcb_to_tdb_jd(jd);
    var d: f64 = ((tdb - jd) * 86400.0) + 11.2537;
    assert(f64_abs(d) < 0.001, "TDB - TCB at J2000 ~-11.2537 s");
    var tcb: f64 = tdb_to_tcb_jd(tdb);
    assert(near(tcb, jd, 0.000000001), "TCB -> TDB -> TCB");
    var t0: f64 = TM_T0_JD;
    var tcg_tt0: f64 = tcg_minus_tt_seconds(t0);
    assert(f64_abs(tcg_tt0) < 0.000000000001, "TCG - TT = 0 at T0");
    var sec0: f64 = tcb_minus_tcg_secular_seconds(t0);
    assert(f64_abs(sec0) < 0.000000000001, "secular TCB - TCG = 0 at T0");
}

fn _t_tai_minus_utc_rubber_second_era() {
    test_group("tai_minus_utc_rubber_second_era");
    var a: f64 = tai_minus_utc_seconds_mjd(37300.0);
    assert(near(a, 1.422818, 0.000000001), "MJD 37300 (1961-01-01): 1.422818 s");
    var b: f64 = tai_minus_utc_seconds_mjd(41316.999);
    assert(near(b, 9.892239, 0.00001), "end of 1971: ~9.892239 s");
    var c: f64 = tai_minus_utc_seconds_mjd(41317.0);
    assert(near(c, 10.0, 0.000000000001), "1972-01-01: 10 s");
    var d: f64 = tai_minus_utc_seconds_mjd(57754.0);
    assert(near(d, 37.0, 0.000000000001), "2017-01-01: 37 s");
    var e: f64 = tai_minus_utc_seconds_mjd(57753.0);
    assert(near(e, 36.0, 0.000000000001), "2016-12-31: 36 s");
    var f: f64 = tai_minus_utc_seconds_mjd(30000.0);
    assert(f64_abs(f) < 0.000000000001, "before 1961: 0 s");
}

fn _t_atomic_instant_exact_at_modern_epoch() {
    test_group("atomic_instant_exact_at_modern_epoch");
    var t0 = TmAtomicInstant_new(2100000000, 123456789);
    var same = t0.add_seconds(0.0);
    assert_eq(_inst_eq(same, t0), 1, "t0 + 0 s == t0");
    var t1 = t0.add_seconds(0.000000001);
    var hi1, lo1 = t1.nanoseconds_since(t0);
    assert_eq(hi1, 0, "t0 + 1e-9 s: 1 ns later (high word)");
    assert_eq(lo1, 1, "t0 + 1e-9 s: 1 ns later (low word)");
    var t2 = t0.add_seconds(-2.5);
    var hi2, lo2 = t2.nanoseconds_since(t0);
    assert_eq(hi2, 0 - 1, "t0 - 2.5 s: -2 500 000 000 ns (high word)");
    assert_eq(lo2, 0 - 2500000000, "t0 - 2.5 s: -2 500 000 000 ns (low word)");
    var t3 = t0.add_nanoseconds(900000000);
    assert_eq(t3.seconds, 2100000001, "t0 + 0.9e9 ns: seconds carry");
    assert_eq(t3.nanos, 23456789, "t0 + 0.9e9 ns: nanos wrap");
    var t4 = TmAtomicInstant_from_tai_seconds(0.3);
    assert_eq(t4.nanos, 300000000, "0.3 s = 300 000 000 ns");
}

fn _t_time_dilation_exact_vs_leading_order() {
    test_group("time_dilation_exact_vs_leading_order");
    var exact: f64 = time_dilation_shift_exact(0.5);
    var root: f64 = f64_sqrt(0.75);
    assert(near(exact, root - 1.0, 0.000000000000001), "beta = 0.5: sqrt(0.75) - 1");
    var lead: f64 = second_order_doppler_shift(0.0001);
    var full: f64 = time_dilation_shift_exact(0.0001);
    assert(near(lead, full, 0.0000000000000001), "beta = 1e-4: leading order = exact");
}

fn _t_sagnac_equator() {
    test_group("sagnac_equator");
    var dt: f64 = sagnac_correction_ns(0.0, 1000000.0);
    assert(f64_abs(dt) < 0.0000000001, "equator: no Sagnac correction");
}

fn _t_sagnac_pole() {
    test_group("sagnac_pole");
    # core::f64::consts::FRAC_PI_2: pi / 2 halves exactly.
    var half_pi: f64 = _TM_PI / 2.0;
    var dt: f64 = sagnac_correction_ns(half_pi, 1000000.0);
    assert(dt > 0.0, "pole: positive");
    var expected: f64 = (((4.0 * TM_EARTH_ROTATION_RAD_S) * 1000000.0) / (TM_C * TM_C)) * 1000000000.0;
    assert(near(dt, expected, 0.000001), "pole: 4 Omega A / c^2");
}

fn _t_sagnac_sign_hemisphere() {
    test_group("sagnac_sign_hemisphere");
    var dt_north: f64 = sagnac_correction_ns(0.5, 1000000.0);
    assert(dt_north > 0.0, "northern hemisphere: positive");
    var dt_south: f64 = sagnac_correction_ns(-0.5, 1000000.0);
    assert(dt_south < 0.0, "southern hemisphere: negative");
}

fn _t_lg_rate_value() {
    test_group("lg_rate_value");
    var lg: f64 = TM_LG_RATE;
    assert(near(lg, 0.0000000006969290134, 0.0000000000000000001), "L_G = 6.969290134e-10");
}

fn _t_lc_rate_value() {
    test_group("lc_rate_value");
    var lc: f64 = TM_LC_RATE;
    assert(near(lc, 0.0000000148082686741, 0.000000000000000001), "L_C = 1.48082686741e-8");
}

fn _t_tai_tt_offset_value() {
    test_group("tai_tt_offset_value");
    var eps: f64 = _f64_epsilon();
    var off: f64 = TM_TAI_TT_OFFSET_S;
    assert(near(off, 32.184, eps), "TT - TAI = 32.184 s");
}

fn _t_tai_gps_offset_value() {
    test_group("tai_gps_offset_value");
    var eps: f64 = _f64_epsilon();
    var off: f64 = TM_TAI_GPS_OFFSET_S;
    assert(near(off, 19.0, eps), "TAI - GPS = 19 s");
}

fn _t_leap_second_table_length() {
    test_group("leap_second_table_length");
    assert_eq(_TM_LEAP_SECOND_COUNT, 28, "28 leap-second entries");
}

fn _t_leap_seconds_monotonic() {
    test_group("leap_seconds_monotonic");
    var i = 1;
    while (i < _TM_LEAP_SECOND_COUNT) {
        var y_prev = _TM_LEAP_SECOND_YEAR[i - 1];
        var m_prev = _TM_LEAP_SECOND_MONTH[i - 1];
        var d_prev = _TM_LEAP_SECOND_DELTA_AT[i - 1];
        var y_curr = _TM_LEAP_SECOND_YEAR[i];
        var m_curr = _TM_LEAP_SECOND_MONTH[i];
        var d_curr = _TM_LEAP_SECOND_DELTA_AT[i];
        # rust `(y_curr, m_curr) > (y_prev, m_prev)`: lexicographic.
        var sorted = 0;
        if (y_curr > y_prev || (y_curr == y_prev && m_curr > m_prev)) { sorted = 1; }
        assert(sorted, "Table not sorted");
        assert(d_curr > d_prev, "Delta AT not monotonically increasing");
        i = i + 1;
    }
}

fn _t_leap_seconds_first_and_last() {
    test_group("leap_seconds_first_and_last");
    assert_eq(_TM_LEAP_SECOND_YEAR[0], 1972, "first entry year 1972");
    assert_eq(_TM_LEAP_SECOND_MONTH[0], 1, "first entry month 1");
    assert_eq(_TM_LEAP_SECOND_DELTA_AT[0], 10, "first entry Delta AT 10");
    var last = _TM_LEAP_SECOND_COUNT - 1;
    assert_eq(_TM_LEAP_SECOND_YEAR[last], 2017, "last entry year 2017");
    assert_eq(_TM_LEAP_SECOND_MONTH[last], 1, "last entry month 1");
    assert_eq(_TM_LEAP_SECOND_DELTA_AT[last], 37, "last entry Delta AT 37");
}

fn _t_leap_seconds_all_valid_months() {
    test_group("leap_seconds_all_valid_months");
    var k = 0;
    while (k < _TM_LEAP_SECOND_COUNT) {
        var m = _TM_LEAP_SECOND_MONTH[k];
        var valid = 0;
        if (m == 1 || m == 7) { valid = 1; }
        assert(valid, "Leap second in unexpected month");
        k = k + 1;
    }
}

fn _t_cesium_defines_si_second() {
    test_group("cesium_defines_si_second");
    var eps: f64 = _f64_epsilon();
    var f: f64 = frequency_standard_transition_frequency_hz(TM_FREQUENCY_STANDARD_CESIUM133);
    assert(near(f, 9192631770.0, eps), "SI second: 9 192 631 770 Cs-133 periods");
}

fn _t_gps_epoch_leap_seconds_consistent() {
    test_group("gps_epoch_leap_seconds_consistent");
    var eps: f64 = _f64_epsilon();
    var delta_at = leap_seconds_at(1980, 1);
    var d: f64 = f64_from(delta_at);
    var off: f64 = TM_TAI_GPS_OFFSET_S;
    assert(near(d, off, eps), "GPS epoch Delta AT = TAI - GPS = 19 s");
}

fn _t_atomic_instant_tt_gps_consistent() {
    test_group("atomic_instant_tt_gps_consistent");
    var t = TmAtomicInstant_new(1000000, 0);
    var tt: f64 = t.to_tt_seconds();
    var gps: f64 = t.to_gps_seconds();
    assert(near(tt - gps, 51.184, 0.0000000001), "TT - GPS = 51.184 s");
}

