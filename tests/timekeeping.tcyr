# timekeeping.tcyr — the reference-value tests of rust-old/src/timekeeping.rs, ported one for
# one (each test_group is the Rust test's name). Not carried over (port plan §1): the four
# serde tests serde_roundtrip_frequency_standard, serde_roundtrip_time_scale,
# serde_roundtrip_atomic_instant and atomic_instant_serde_normalizes; and
# quality_factors_reasonable, whose every assert is on FrequencyStandard::quality_factor
# (deprecated in 1.3.0), so no part of it is left to port. The golden corpus separately checks
# every function against the oracle on the M5 grid, in its tolerance class (tests/parity.tcyr).

include "tests/ulp.cyr"
include "src/error.cyr"
include "src/numerics.cyr"
include "src/constants.cyr"
include "src/particle_data.cyr"
include "src/particle.cyr"
include "src/relativity.cyr"
include "src/nucleus_data.cyr"
include "src/nucleus.cyr"
include "src/shell_model.cyr"
include "src/decay_data.cyr"
include "src/decay.cyr"
include "src/timekeeping_data.cyr"
include "src/timekeeping.cyr"

alloc_init();

# 1 if |a - b| < eps.
#must_use
fn near(a: f64, b: f64, eps: f64): i64 {
    if (f64_abs(a - b) < eps) { return 1; }
    return 0;
}

# Rust's f64::EPSILON, 2^-52 (0x3CB0000000000000).
#must_use
fn _f64_epsilon(): f64 {
    var e: f64 = 0x3CB0000000000000;
    return e;
}

# 1 if a == b: rust's derived PartialEq on AtomicInstant (both fields equal).
#must_use
fn _inst_eq(a: TmAtomicInstant, b: TmAtomicInstant): i64 {
    if (a.seconds == b.seconds && a.nanos == b.nanos) { return 1; }
    return 0;
}

# 1 if a < b: rust's derived PartialOrd on AtomicInstant (seconds, then nanos).
#must_use
fn _inst_lt(a: TmAtomicInstant, b: TmAtomicInstant): i64 {
    if (a.seconds < b.seconds) { return 1; }
    if (a.seconds == b.seconds && a.nanos < b.nanos) { return 1; }
    return 0;
}

fn _t_cesium_frequency_exact() {
    test_group("cesium_frequency_exact");
    var eps: f64 = _f64_epsilon();
    var f: f64 = frequency_standard_transition_frequency_hz(TM_FREQUENCY_STANDARD_CESIUM133);
    assert(near(f, 9192631770.0, eps), "Cs-133 9 192 631 770 Hz exactly");
}

