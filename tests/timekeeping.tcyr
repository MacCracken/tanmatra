fn _t_fractional_stability_ordering() {
    test_group("fractional_stability_ordering");
    var sr: f64 = frequency_standard_fractional_stability(TM_FREQUENCY_STANDARD_STRONTIUM_OPTICAL);
    var cs: f64 = frequency_standard_fractional_stability(TM_FREQUENCY_STANDARD_CESIUM133);
    var yb: f64 = frequency_standard_fractional_stability(TM_FREQUENCY_STANDARD_YTTERBIUM_OPTICAL);
    var rb: f64 = frequency_standard_fractional_stability(TM_FREQUENCY_STANDARD_RUBIDIUM87);
    assert(sr < cs, "Sr optical more stable than Cs");
    assert(yb < rb, "Yb optical more stable than Rb");
}

fn _t_all_standards_count() {
    test_group("all_standards_count");
    assert_eq(all_frequency_standard_count(), 5, "five frequency standards");
}

fn _t_all_standards_unique_frequencies() {
    test_group("all_standards_unique_frequencies");
    var n = all_frequency_standard_count();
    var i = 0;
    while (i < n) {
        var j = i + 1;
        while (j < n) {
            var fi: f64 = frequency_standard_transition_frequency_hz(all_frequency_standard(i));
            var fj: f64 = frequency_standard_transition_frequency_hz(all_frequency_standard(j));
            assert(f64_abs(fi - fj) > 1.0, "standards have distinct frequencies");
            j = j + 1;
        }
        i = i + 1;
    }
}

