    assert(near(net, 38.575, 0.001), "net +38.575 us/day (IERS 2010 / Ashby 2003)");
    var grav_only: f64 = schwarzschild_clock_correction_us_per_day(a, 0.0);
    assert(near(grav_only, 45.788, 0.001), "gravitational +45.788 us/day");
}

