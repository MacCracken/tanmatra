    test_group("gps_gravitational_part");
    var c2: f64 = TM_C * TM_C;
    var inv: f64 = (1.0 / 6371000.0) - (1.0 / 26560000.0);
    var grav: f64 = (((TM_GM_EARTH / c2) * inv) * 86400.0) * 1000000.0;
    assert(near(grav, 45.7, 0.5), "gravitational part ~45.7 us/day");
}

