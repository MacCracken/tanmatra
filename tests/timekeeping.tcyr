fn _t_atomic_instant_ordering() {
    test_group("atomic_instant_ordering");
    var t1 = TmAtomicInstant_new(100, 0);
    var t2 = TmAtomicInstant_new(100, 1);
    var t3 = TmAtomicInstant_new(101, 0);
    assert_eq(_inst_lt(t1, t2), 1, "(100, 0) < (100, 1)");
    assert_eq(_inst_lt(t2, t3), 1, "(100, 1) < (101, 0)");
}

