    var c2: f64 = TM_C * TM_C;
    var vel: f64 = (((3874.0 * 3874.0) / (2.0 * c2)) * 86400.0) * 1000000.0;
    assert(near(vel, 7.2, 0.1), "velocity part ~7.2 us/day");
}

