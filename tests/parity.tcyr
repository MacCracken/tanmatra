# parity.tcyr — replays the golden corpus (tests/golden/*.tsv) against the port.
#
# Port plan §2 step 7. Format and comparison rules: scripts/oracle/README.md. The module
# list is tests/golden/modules.txt, which the generator writes. The replay machinery is
# tests/parity_core.cyr; this file holds the core modules' dispatchers. The optics module, which
# needs prakash, is tests/optics_parity.tcyr's.
#
# Every row of every module is one of:
# - ok: every output matched within its class;
# - FAILED: an output differs; the first few are printed with the row's note;
# - measured: class C, with no bound set yet for its function. The ulp distance is
#   recorded but not gated. Bounds are set per function before its comparison
#   (docs/development/port-parity.md);
# - accepted: a divergence an ADR accepts, listed by row in _par_accepted;
# - pending: its function isn't ported yet (no dispatcher entry).
#
# Per function it prints the row counts and the ulp histogram, which is the step 8
# baseline. The exit code is the number of modules with a failure, at most a handful, so
# the 8-bit exit status can't wrap.

include "tests/ulp.cyr"
include "src/error.cyr"
include "src/numerics.cyr"
include "src/constants.cyr"
include "src/particle_data.cyr"
include "src/particle.cyr"
include "src/relativity.cyr"
include "src/nucleus_data.cyr"
include "src/nucleus.cyr"
include "src/shell_model.cyr"
include "src/decay_data.cyr"
include "src/decay.cyr"
include "src/atomic_data.cyr"
include "src/atomic_config.cyr"
include "src/atomic_hydrogenic.cyr"
include "src/atomic_qed.cyr"
include "src/reaction_data.cyr"
include "src/reaction.cyr"
include "src/scattering.cyr"
include "src/timekeeping_data.cyr"
include "src/timekeeping.cyr"
include "src/bridge.cyr"

alloc_init();

include "tests/parity_core.cyr"

# ── dispatch ────────────────────────────────────────────────────────────────────────
# Each module's dispatcher fills the got list for one row. It returns 1 when it handled
# the function, 0 when the function is pending (not ported), or -1 when the inputs are
# unusable (a defect, counted as a failure). Add a function the moment it's ported.

# `const` rows: the generated TM_ constants (src/constants.cyr).
fn _par_constants(fp, fl): i64 {
    if (_par_eq(fp, fl, "const") != 1 || _par_in_n != 1) { return 0; }
    var np = load64(_par_in_v);
    var nl = load64(_par_in_l);
    var x: f64 = 0.0;
    if (_par_eq(np, nl, "ELECTRON_MASS_MEV") == 1) { x = TM_ELECTRON_MASS_MEV; }
    elif (_par_eq(np, nl, "PROTON_MASS_MEV") == 1) { x = TM_PROTON_MASS_MEV; }
    elif (_par_eq(np, nl, "NEUTRON_MASS_MEV") == 1) { x = TM_NEUTRON_MASS_MEV; }
    elif (_par_eq(np, nl, "AMU_MEV") == 1) { x = TM_AMU_MEV; }
    elif (_par_eq(np, nl, "FINE_STRUCTURE") == 1) { x = TM_FINE_STRUCTURE; }
    elif (_par_eq(np, nl, "HBAR_EV_S") == 1) { x = TM_HBAR_EV_S; }
    elif (_par_eq(np, nl, "RYDBERG") == 1) { x = TM_RYDBERG; }
    elif (_par_eq(np, nl, "BOHR_RADIUS") == 1) { x = TM_BOHR_RADIUS; }
    elif (_par_eq(np, nl, "AVOGADRO") == 1) { x = TM_AVOGADRO; }
    elif (_par_eq(np, nl, "ELEMENTARY_CHARGE") == 1) { x = TM_ELEMENTARY_CHARGE; }
    elif (_par_eq(np, nl, "C") == 1) { x = TM_C; }
    elif (_par_eq(np, nl, "R0_FM") == 1) { x = TM_R0_FM; }
    elif (_par_eq(np, nl, "BOLTZMANN_EV") == 1) { x = TM_BOLTZMANN_EV; }
    elif (_par_eq(np, nl, "H_EV_S") == 1) { x = TM_H_EV_S; }
    elif (_par_eq(np, nl, "HBAR_MEV_S") == 1) { x = TM_HBAR_MEV_S; }
    elif (_par_eq(np, nl, "BOHR_MAGNETON_EV_T") == 1) { x = TM_BOHR_MAGNETON_EV_T; }
    elif (_par_eq(np, nl, "COULOMB_MEV_FM") == 1) { x = TM_COULOMB_MEV_FM; }
    elif (_par_eq(np, nl, "CLASSICAL_ELECTRON_RADIUS_FM") == 1) { x = TM_CLASSICAL_ELECTRON_RADIUS_FM; }
    elif (_par_eq(np, nl, "PROTON_G_FACTOR") == 1) { x = TM_PROTON_G_FACTOR; }
    elif (_par_eq(np, nl, "ELECTRON_ANOMALOUS_MOMENT") == 1) { x = TM_ELECTRON_ANOMALOUS_MOMENT; }
    elif (_par_eq(np, nl, "STANDARD_GRAVITY") == 1) { x = TM_STANDARD_GRAVITY; }
    elif (_par_eq(np, nl, "GM_EARTH") == 1) { x = TM_GM_EARTH; }
    elif (_par_eq(np, nl, "EARTH_ROTATION_RAD_S") == 1) { x = TM_EARTH_ROTATION_RAD_S; }
    elif (_par_eq(np, nl, "HBAR_C_MEV_FM") == 1) { x = TM_HBAR_C_MEV_FM; }
    elif (_par_eq(np, nl, "HC_EV_NM") == 1) { x = TM_HC_EV_NM; }
    elif (_par_eq(np, nl, "RYDBERG_EV") == 1) { x = TM_RYDBERG_EV; }
    elif (_par_eq(np, nl, "ELECTRON_MASS_U") == 1) { x = TM_ELECTRON_MASS_U; }
    elif (_par_eq(np, nl, "PROTON_MASS_U") == 1) { x = TM_PROTON_MASS_U; }
    elif (_par_eq(np, nl, "NEUTRON_MASS_U") == 1) { x = TM_NEUTRON_MASS_U; }
    elif (_par_eq(np, nl, "HYDROGEN_ATOM_MASS_U") == 1) { x = TM_HYDROGEN_ATOM_MASS_U; }
    elif (_par_eq(np, nl, "NUCLEAR_MAGNETON_EV_T") == 1) { x = TM_NUCLEAR_MAGNETON_EV_T; }
    elif (_par_eq(np, nl, "DEUTERON_G_FACTOR") == 1) { x = TM_DEUTERON_G_FACTOR; }
    elif (_par_eq(np, nl, "ATOMIC_UNIT_TIME_S") == 1) { x = TM_ATOMIC_UNIT_TIME_S; }
    elif (_par_eq(np, nl, "COULOMB_K_SI") == 1) { x = TM_COULOMB_K_SI; }
    else { return 0 - 1; }
    _par_got_f(x);
    return 1;
}

# `libm::` rows: the Cyrius math function each libm call maps to (port plan §5).
# libm::round is the port's _tm_round_half_away (M5) and libm::ldexp its _tm_ldexp (M2), each
# Rust libm's own algorithm operation for operation.
fn _par_libm(fp, fl): i64 {
    var x: f64 = _par_in(0);
    if (_par_eq(fp, fl, "libm::sqrt") == 1) { var r: f64 = f64_sqrt(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "libm::fabs") == 1) { var r: f64 = f64_abs(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "libm::floor") == 1) { var r: f64 = f64_floor(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "libm::trunc") == 1) { var r: f64 = f64_trunc(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "libm::round") == 1) { var r: f64 = _tm_round_half_away(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "libm::cbrt") == 1) { var r: f64 = ganita_f64_cbrt(x); _par_got_f(r); return 1; }
    # From M4 the sin, cos and log rows go to the port's bit-exact transcriptions (class A).
    if (_par_eq(fp, fl, "libm::sin") == 1) { var r: f64 = _tm_sin(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "libm::cos") == 1) { var r: f64 = _tm_cos(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "libm::tan") == 1) { var r: f64 = ganita_f64_tan(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "libm::exp") == 1) { var r: f64 = f64_exp(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "libm::log") == 1) { var r: f64 = _tm_log(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "libm::sinh") == 1) { var r: f64 = ganita_f64_sinh(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "libm::ldexp") == 1) { var r: f64 = _tm_ldexp(x, _par_in(1)); _par_got_f(r); return 1; }
    var y: f64 = _par_in(1);
    if (_par_eq(fp, fl, "libm::pow") == 1) { var r: f64 = ganita_f64_pow(x, y); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "libm::hypot") == 1) { var r: f64 = _tm_hypot(x, y); _par_got_f(r); return 1; }
    return 0;
}

# `particle` rows: src/particle.cyr, one function per Rust enum method.
fn _par_particle(fp, fl): i64 {
    var v = _par_enum(0);
    if (v < 0) { return 0 - 1; }
    if (_par_eq(fp, fl, "Quark::mass_mev") == 1) { _par_got_f(quark_mass_mev(v)); return 1; }
    if (_par_eq(fp, fl, "Quark::charge") == 1) { _par_got_f(quark_charge(v)); return 1; }
    if (_par_eq(fp, fl, "Quark::generation") == 1) { _par_got_i(quark_generation(v)); return 1; }
    if (_par_eq(fp, fl, "Lepton::mass_mev") == 1) { _par_got_f(lepton_mass_mev(v)); return 1; }
    if (_par_eq(fp, fl, "Lepton::charge") == 1) { _par_got_f(lepton_charge(v)); return 1; }
    if (_par_eq(fp, fl, "Lepton::generation") == 1) { _par_got_i(lepton_generation(v)); return 1; }
    if (_par_eq(fp, fl, "Lepton::lifetime_seconds") == 1) { _par_got_f(lepton_lifetime_seconds(v)); return 1; }
    if (_par_eq(fp, fl, "Lepton::decay_width_mev") == 1) { _par_got_f(lepton_decay_width_mev(v)); return 1; }
    if (_par_eq(fp, fl, "Lepton::is_stable") == 1) { _par_got_i(lepton_is_stable(v)); return 1; }
    if (_par_eq(fp, fl, "Boson::mass_mev") == 1) { _par_got_f(boson_mass_mev(v)); return 1; }
    if (_par_eq(fp, fl, "Boson::spin") == 1) { _par_got_i(boson_spin(v)); return 1; }
    if (_par_eq(fp, fl, "Boson::charge") == 1) { _par_got_f(boson_charge(v)); return 1; }
    if (_par_eq(fp, fl, "Boson::decay_width_mev") == 1) { _par_got_f(boson_decay_width_mev(v)); return 1; }
    if (_par_eq(fp, fl, "Boson::lifetime_seconds") == 1) { _par_got_f(boson_lifetime_seconds(v)); return 1; }
    if (_par_eq(fp, fl, "Boson::is_stable") == 1) { _par_got_i(boson_is_stable(v)); return 1; }
    if (_par_eq(fp, fl, "FundamentalForce::relative_strength") == 1) {
        _par_got_f(fundamental_force_relative_strength(v));
        return 1;
    }
    if (_par_eq(fp, fl, "FundamentalForce::range_meters") == 1) {
        _par_got_f(fundamental_force_range_meters(v));
        return 1;
    }
    if (_par_eq(fp, fl, "FundamentalForce::mediator") == 1) {
        var n = fundamental_force_mediator_count(v);
        _par_got_seq(n);
        var k = 0;
        while (k < n) { _par_got_e(_par_boson_name(fundamental_force_mediator(v, k))); k = k + 1; }
        return 1;
    }
    return 0;
}

# The four-momentum in inputs k .. k + 3.
fn _par_fm(k): TmFourMomentum {
    var e: f64 = _par_in(k);
    var x: f64 = _par_in(k + 1);
    var y: f64 = _par_in(k + 2);
    var z: f64 = _par_in(k + 3);
    var p: TmFourMomentum = TmFourMomentum_new(e, x, y, z);
    return p;
}

# `relativity` rows: src/relativity.cyr.
fn _par_relativity(fp, fl): i64 {
    var a: f64 = _par_in(0);
    var b: f64 = _par_in(1);
    if (_par_eq(fp, fl, "lorentz_gamma") == 1) { _par_got_f(lorentz_gamma(a)); return 1; }
    if (_par_eq(fp, fl, "gamma_to_beta") == 1) { _par_got_f(gamma_to_beta(a)); return 1; }
    if (_par_eq(fp, fl, "beta_to_velocity") == 1) { _par_got_f(beta_to_velocity(a)); return 1; }
    if (_par_eq(fp, fl, "velocity_to_beta") == 1) { _par_got_f(velocity_to_beta(a)); return 1; }
    if (_par_eq(fp, fl, "de_broglie_wavelength_fm") == 1) { _par_got_f(de_broglie_wavelength_fm(a)); return 1; }
    if (_par_eq(fp, fl, "velocity_addition") == 1) { _par_got_f(velocity_addition(a, b)); return 1; }
    if (_par_eq(fp, fl, "relativistic_energy") == 1) { _par_got_f(relativistic_energy(a, b)); return 1; }
    if (_par_eq(fp, fl, "relativistic_momentum") == 1) { _par_got_f(relativistic_momentum(a, b)); return 1; }
    if (_par_eq(fp, fl, "FourMomentum::at_rest") == 1) {
        var r = TmFourMomentum_at_rest(a);
        _par_got_fm(r);
        return 1;
    }
    if (_par_eq(fp, fl, "FourMomentum::from_mass_and_momentum") == 1) {
        var r = TmFourMomentum_from_mass_and_momentum(a, b);
        _par_got_fm(r);
        return 1;
    }
    var p = _par_fm(0);
    if (_par_eq(fp, fl, "FourMomentum::new") == 1) { _par_got_fm(p); return 1; }
    if (_par_eq(fp, fl, "FourMomentum::momentum_magnitude") == 1) { _par_got_f(p.momentum_magnitude()); return 1; }
    if (_par_eq(fp, fl, "FourMomentum::invariant_mass") == 1) { _par_got_f(p.invariant_mass()); return 1; }
    if (_par_eq(fp, fl, "FourMomentum::beta") == 1) { _par_got_f(p.beta()); return 1; }
    if (_par_eq(fp, fl, "FourMomentum::gamma") == 1) { _par_got_f(p.gamma()); return 1; }
    if (_par_eq(fp, fl, "FourMomentum::kinetic_energy") == 1) { _par_got_f(p.kinetic_energy()); return 1; }
    var q = _par_fm(4);
    if (_par_eq(fp, fl, "FourMomentum::add") == 1) {
        var s: TmFourMomentum = p + q;
        _par_got_fm(s);
        return 1;
    }
    if (_par_eq(fp, fl, "invariant_mass_two_body") == 1) { _par_got_f(invariant_mass_two_body(p, q)); return 1; }
    return 0;
}

# `nucleus` rows: src/nucleus.cyr and src/shell_model.cyr. A nucleus input is `i:Z i:A`.
fn _par_nucleus(fp, fl): i64 {
    if (_par_eq(fp, fl, "Nucleus::hydrogen_1") == 1) { _par_got_nuc(nucleus_hydrogen_1()); return 1; }
    if (_par_eq(fp, fl, "Nucleus::helium_4") == 1) { _par_got_nuc(nucleus_helium_4()); return 1; }
    if (_par_eq(fp, fl, "Nucleus::carbon_12") == 1) { _par_got_nuc(nucleus_carbon_12()); return 1; }
    if (_par_eq(fp, fl, "Nucleus::iron_56") == 1) { _par_got_nuc(nucleus_iron_56()); return 1; }
    if (_par_eq(fp, fl, "Nucleus::uranium_235") == 1) { _par_got_nuc(nucleus_uranium_235()); return 1; }
    if (_par_eq(fp, fl, "Nucleus::uranium_238") == 1) { _par_got_nuc(nucleus_uranium_238()); return 1; }
    if (_par_eq(fp, fl, "superallowed_ft_values") == 1) {
        var cnt = superallowed_ft_value_count();
        _par_got_seq(cnt);
        var k = 0;
        while (k < cnt) {
            var d = superallowed_ft_value(k);
            _par_got_i(nucleus_z(d.parent));
            _par_got_i(nucleus_a(d.parent));
            _par_got_i(nucleus_z(d.daughter));
            _par_got_i(nucleus_a(d.daughter));
            _par_got_f(d.ft_seconds);
            k = k + 1;
        }
        return 1;
    }
    if (_par_eq(fp, fl, "superallowed_average_ft") == 1) {
        var ft, unc = superallowed_average_ft();
        _par_got_f(ft);
        _par_got_f(unc);
        return 1;
    }
    if (_par_eq(fp, fl, "shell_model_levels") == 1) {
        var cnt = shell_model_level_count();
        _par_got_seq(cnt);
        var k = 0;
        while (k < cnt) {
            var slv = shell_model_level(k);
            _par_got_i(slv.n_shell);
            _par_got_i(slv.l);
            _par_got_i(slv.two_j);
            k = k + 1;
        }
        return 1;
    }
    var x = _par_in(0);
    if (_par_eq(fp, fl, "is_magic_number") == 1) { _par_got_i(is_magic_number(x)); return 1; }
    if (_par_eq(fp, fl, "shell_closure_below") == 1) { _par_got_i(shell_closure_below(x)); return 1; }
    if (_par_eq(fp, fl, "next_shell_closure") == 1) {
        var t, v = next_shell_closure(x);
        if (is_some(t) == 1) { _par_got_i(v); } else { _par_got_none(); }
        return 1;
    }
    if (_par_eq(fp, fl, "shell_occupation") == 1) {
        var lvs: TmShellLevel[32];
        var occ[256];
        var cnt = shell_occupation(x, &lvs, &occ, 32);
        _par_got_seq(cnt);
        var base: *TmShellLevel = &lvs;
        var k = 0;
        while (k < cnt) {
            var olv: *TmShellLevel = base + k;
            _par_got_i(olv.n_shell);
            _par_got_i(olv.l);
            _par_got_i(olv.two_j);
            _par_got_i(load64(&occ + k * 8));
            k = k + 1;
        }
        return 1;
    }
    var y = _par_in(1);
    if (_par_eq(fp, fl, "Nucleus::new") == 1) {
        var t, v = nucleus_new(x, y);
        if (is_ok(t) == 1) { _par_got_i(nucleus_z(v)); _par_got_i(nucleus_a(v)); }
        else { _par_got_err(v); }
        return 1;
    }
    if (_par_in_n == 3) {
        var plv = TmShellLevel_new(x, y, _par_in(2));
        if (_par_eq(fp, fl, "ShellLevel::degeneracy") == 1) { _par_got_i(plv.degeneracy()); return 1; }
        if (_par_eq(fp, fl, "ShellLevel::j") == 1) { _par_got_f(plv.j()); return 1; }
        if (_par_eq(fp, fl, "ShellLevel::label") == 1) {
            var lab = plv.label();
            _par_got_s(str_data(lab), str_len(lab));
            return 1;
        }
        return 0;
    }
    if (_par_eq(fp, fl, "SuperallowedDecay::corrected_ft_seconds") == 1) {
        var sd: TmSuperallowedDecay;
        sd.parent = _tm_nuc(x, y);
        sd.daughter = _tm_nuc(_par_in(2), _par_in(3));
        var ftv: f64 = _par_in(4);
        sd.ft_seconds = ftv;
        var t, v = sd.corrected_ft_seconds();
        _par_got_opt_f(t, v);
        return 1;
    }
    var n = _tm_nuc(x, y);
    if (_par_eq(fp, fl, "Nucleus::binding_energy") == 1) { _par_got_f(nucleus_binding_energy(n)); return 1; }
    if (_par_eq(fp, fl, "Nucleus::binding_energy_shell_corrected") == 1) {
        _par_got_f(nucleus_binding_energy_shell_corrected(n));
        return 1;
    }
    if (_par_eq(fp, fl, "ground_state_spin_parity") == 1) {
        var tj, par = ground_state_spin_parity(n);
        _par_got_i(tj);
        _par_got_i(par);
        return 1;
    }
    if (_par_eq(fp, fl, "Nucleus::z") == 1) { _par_got_i(nucleus_z(n)); return 1; }
    if (_par_eq(fp, fl, "Nucleus::a") == 1) { _par_got_i(nucleus_a(n)); return 1; }
    if (_par_eq(fp, fl, "Nucleus::n") == 1) { _par_got_i(nucleus_n(n)); return 1; }
    if (_par_eq(fp, fl, "Nucleus::binding_energy_per_nucleon") == 1) {
        _par_got_f(nucleus_binding_energy_per_nucleon(n));
        return 1;
    }
    if (_par_eq(fp, fl, "Nucleus::mass_defect") == 1) { _par_got_f(nucleus_mass_defect(n)); return 1; }
    if (_par_eq(fp, fl, "Nucleus::nuclear_mass") == 1) { _par_got_f(nucleus_nuclear_mass(n)); return 1; }
    if (_par_eq(fp, fl, "Nucleus::atomic_mass_amu") == 1) { _par_got_f(nucleus_atomic_mass_amu(n)); return 1; }
    if (_par_eq(fp, fl, "Nucleus::nuclear_mass_amu") == 1) { _par_got_f(nucleus_nuclear_mass_amu(n)); return 1; }
    if (_par_eq(fp, fl, "Nucleus::nuclear_radius") == 1) { _par_got_f(nucleus_nuclear_radius(n)); return 1; }
    if (_par_eq(fp, fl, "Nucleus::is_magic") == 1) { _par_got_i(nucleus_is_magic(n)); return 1; }
    if (_par_eq(fp, fl, "Nucleus::is_doubly_magic") == 1) { _par_got_i(nucleus_is_doubly_magic(n)); return 1; }
    if (_par_eq(fp, fl, "Nucleus::experimental_mass_excess_kev") == 1) {
        var t, v = nucleus_experimental_mass_excess_kev(n);
        _par_got_opt_f(t, v);
        return 1;
    }
    if (_par_eq(fp, fl, "Nucleus::experimental_atomic_mass_amu") == 1) {
        var t, v = nucleus_experimental_atomic_mass_amu(n);
        _par_got_opt_f(t, v);
        return 1;
    }
    if (_par_eq(fp, fl, "Nucleus::charge_radius_fm") == 1) {
        var t, v = nucleus_charge_radius_fm(n);
        _par_got_opt_f(t, v);
        return 1;
    }
    if (_par_eq(fp, fl, "Nucleus::nuclear_moments") == 1) {
        var mom: TmNuclearMoments;
        if (nucleus_nuclear_moments(n, &mom) == 1) {
            _par_got_f(mom.magnetic_dipole_mu_n);
            _par_got_f(mom.electric_quadrupole_barn);
        } else {
            _par_got_none();
        }
        return 1;
    }
    return 0;
}

# A TmDecayMode value's golden name ("DecayMode.Alpha").
#must_use
fn _par_decay_mode_name(m): i64 {
    if (m == TM_DECAY_MODE_ALPHA) { return "DecayMode.Alpha"; }
    if (m == TM_DECAY_MODE_BETA_MINUS) { return "DecayMode.BetaMinus"; }
    if (m == TM_DECAY_MODE_BETA_PLUS) { return "DecayMode.BetaPlus"; }
    if (m == TM_DECAY_MODE_ELECTRON_CAPTURE) { return "DecayMode.ElectronCapture"; }
    if (m == TM_DECAY_MODE_GAMMA) { return "DecayMode.Gamma"; }
    if (m == TM_DECAY_MODE_SPONTANEOUS_FISSION) { return "DecayMode.SpontaneousFission"; }
    if (m == TM_DECAY_MODE_PROTON_EMISSION) { return "DecayMode.ProtonEmission"; }
    if (m == TM_DECAY_MODE_NEUTRON_EMISSION) { return "DecayMode.NeutronEmission"; }
    if (m == TM_DECAY_MODE_ISOMERIC_TRANSITION) { return "DecayMode.IsomericTransition"; }
    return "DecayMode.?";
}

# `decay` rows: src/decay.cyr.
fn _par_decay(fp, fl): i64 {
    if (_par_eq(fp, fl, "known_isotopes") == 1) { _par_got_seq(known_isotope_count()); return 1; }
    if (_par_eq(fp, fl, "known_isotopes[]") == 1) {
        var iso = known_isotope(_par_in(0));
        _par_got_nuc(iso.nucleus);
        _par_got_s(iso.name, strlen(iso.name));
        _par_got_f(iso.half_life_seconds);
        _par_got_e(_par_decay_mode_name(iso.primary_decay));
        _par_got_i(iso.is_isomer);
        _par_got_f(iso.excitation_energy_kev);
        return 1;
    }
    if (_par_eq(fp, fl, "bateman_chain") == 1) {
        var n = _par_in(0);
        var lam = alloc(n * 8 + 8);
        var pops = alloc(n * 8 + 8);
        var k = 0;
        while (k < n) { store64(lam + k * 8, _par_in(1 + k)); k = k + 1; }
        var n0: f64 = _par_in(1 + n);
        var t: f64 = _par_in(2 + n);
        var got = bateman_chain(lam, n, n0, t, pops);
        if (got < 0) { return 0 - 1; }
        _par_got_seq(got);
        k = 0;
        while (k < got) { _par_got_f(load64(pops + k * 8)); k = k + 1; }
        return 1;
    }
    var a: f64 = _par_in(0);
    var b: f64 = _par_in(1);
    if (_par_eq(fp, fl, "decay_constant") == 1) { var t, v = decay_constant(a); _par_got_res_f(t, v); return 1; }
    if (_par_eq(fp, fl, "activity_bq") == 1) { var t, v = activity_bq(a, b); _par_got_res_f(t, v); return 1; }
    if (_par_eq(fp, fl, "remaining_fraction") == 1) { _par_got_f(remaining_fraction(a, b)); return 1; }
    var nuc = _tm_nuc(_par_in(0), _par_in(1));
    if (_par_eq(fp, fl, "alpha_decay") == 1) { var t, v = alpha_decay(nuc); _par_got_res_n(t, v); return 1; }
    if (_par_eq(fp, fl, "beta_minus_decay") == 1) { var t, v = beta_minus_decay(nuc); _par_got_res_n(t, v); return 1; }
    if (_par_eq(fp, fl, "beta_plus_decay") == 1) { var t, v = beta_plus_decay(nuc); _par_got_res_n(t, v); return 1; }
    if (_par_eq(fp, fl, "decay_chain") == 1) {
        var ns[512];
        var ms[512];
        var cnt = decay_chain(nuc, _par_in(2), &ns, &ms, 64);
        _par_got_seq(cnt);
        var k2 = 0;
        while (k2 < cnt && k2 < 64) {
            _par_got_nuc(load64(&ns + k2 * 8));
            _par_got_e(_par_decay_mode_name(load64(&ms + k2 * 8)));
            k2 = k2 + 1;
        }
        return 1;
    }
    return 0;
}

# The TM_FREQUENCY_STANDARD_* value of input k's enum token, or -1.
fn _par_standard(k): i64 {
    var at = k * 8;
    if (load64(_par_in_k + at) != 101) { return 0 - 1; }
    var p = load64(_par_in_v + at);
    var l = load64(_par_in_l + at);
    if (_par_eq(p, l, "FrequencyStandard.Cesium133") == 1) { return TM_FREQUENCY_STANDARD_CESIUM133; }
    if (_par_eq(p, l, "FrequencyStandard.Rubidium87") == 1) { return TM_FREQUENCY_STANDARD_RUBIDIUM87; }
    if (_par_eq(p, l, "FrequencyStandard.HydrogenMaser") == 1) { return TM_FREQUENCY_STANDARD_HYDROGEN_MASER; }
    if (_par_eq(p, l, "FrequencyStandard.StrontiumOptical") == 1) { return TM_FREQUENCY_STANDARD_STRONTIUM_OPTICAL; }
    if (_par_eq(p, l, "FrequencyStandard.YtterbiumOptical") == 1) { return TM_FREQUENCY_STANDARD_YTTERBIUM_OPTICAL; }
    return 0 - 1;
}

# A TmFrequencyStandard value's golden name.
#must_use
fn _par_standard_name(s): i64 {
    if (s == TM_FREQUENCY_STANDARD_CESIUM133) { return "FrequencyStandard.Cesium133"; }
    if (s == TM_FREQUENCY_STANDARD_RUBIDIUM87) { return "FrequencyStandard.Rubidium87"; }
    if (s == TM_FREQUENCY_STANDARD_HYDROGEN_MASER) { return "FrequencyStandard.HydrogenMaser"; }
    if (s == TM_FREQUENCY_STANDARD_STRONTIUM_OPTICAL) { return "FrequencyStandard.StrontiumOptical"; }
    if (s == TM_FREQUENCY_STANDARD_YTTERBIUM_OPTICAL) { return "FrequencyStandard.YtterbiumOptical"; }
    return "FrequencyStandard.?";
}

# Appends an instant as its golden tokens, `i:seconds i:nanos`.
fn _par_got_inst(t: TmAtomicInstant) {
    _par_got_i(t.seconds);
    _par_got_i(t.nanos);
}

# The instant in inputs k, k + 1 (already normalized by the oracle).
fn _par_inst(k): TmAtomicInstant {
    var t: TmAtomicInstant;
    t.seconds = _par_in(k);
    t.nanos = _par_in(k + 1);
    return t;
}

# `timekeeping` rows: src/timekeeping.cyr. An instant is `i:seconds i:nanos`.
fn _par_timekeeping(fp, fl): i64 {
    if (_par_eq(fp, fl, "const") == 1) {
        var np = load64(_par_in_v);
        var nl = load64(_par_in_l);
        var x: f64 = 0.0;
        if (_par_eq(np, nl, "LEAP_SECOND_TABLE_VALID_UNTIL") == 1) {
            _par_got_i(TM_LEAP_SECOND_TABLE_VALID_UNTIL_YEAR);
            _par_got_i(TM_LEAP_SECOND_TABLE_VALID_UNTIL_MONTH);
            _par_got_i(TM_LEAP_SECOND_TABLE_VALID_UNTIL_DAY);
            return 1;
        }
        if (_par_eq(np, nl, "TAI_TT_OFFSET_S") == 1) { x = TM_TAI_TT_OFFSET_S; }
        elif (_par_eq(np, nl, "TAI_GPS_OFFSET_S") == 1) { x = TM_TAI_GPS_OFFSET_S; }
        elif (_par_eq(np, nl, "LG_RATE") == 1) { x = TM_LG_RATE; }
        elif (_par_eq(np, nl, "LC_RATE") == 1) { x = TM_LC_RATE; }
        elif (_par_eq(np, nl, "LB_RATE") == 1) { x = TM_LB_RATE; }
        elif (_par_eq(np, nl, "TDB0_S") == 1) { x = TM_TDB0_S; }
        elif (_par_eq(np, nl, "T0_JD") == 1) { x = TM_T0_JD; }
        else { return 0 - 1; }
        _par_got_f(x);
        return 1;
    }
    if (_par_eq(fp, fl, "all_frequency_standards") == 1) {
        var cnt = all_frequency_standard_count();
        _par_got_seq(cnt);
        var k = 0;
        while (k < cnt) { _par_got_e(_par_standard_name(all_frequency_standard(k))); k = k + 1; }
        return 1;
    }
    var fs = _par_standard(0);
    if (fs >= 0) {
        if (_par_eq(fp, fl, "FrequencyStandard::transition_frequency_hz") == 1) {
            _par_got_f(frequency_standard_transition_frequency_hz(fs));
            return 1;
        }
        if (_par_eq(fp, fl, "FrequencyStandard::transition_wavelength_m") == 1) {
            _par_got_f(frequency_standard_transition_wavelength_m(fs));
            return 1;
        }
        if (_par_eq(fp, fl, "FrequencyStandard::fractional_stability") == 1) {
            _par_got_f(frequency_standard_fractional_stability(fs));
            return 1;
        }
        if (_par_eq(fp, fl, "FrequencyStandard::quality_factor_for_linewidth") == 1) {
            var lw: f64 = _par_in(1);
            _par_got_f(frequency_standard_quality_factor_for_linewidth(fs, lw));
            return 1;
        }
        return 0;
    }
    var a: f64 = _par_in(0);
    var b: f64 = _par_in(1);
    if (_par_eq(fp, fl, "tcg_minus_tt_seconds") == 1) { _par_got_f(tcg_minus_tt_seconds(a)); return 1; }
    if (_par_eq(fp, fl, "tt_to_tcg_jd") == 1) { _par_got_f(tt_to_tcg_jd(a)); return 1; }
    if (_par_eq(fp, fl, "tcg_to_tt_jd") == 1) { _par_got_f(tcg_to_tt_jd(a)); return 1; }
    if (_par_eq(fp, fl, "tcb_to_tdb_jd") == 1) { _par_got_f(tcb_to_tdb_jd(a)); return 1; }
    if (_par_eq(fp, fl, "tdb_to_tcb_jd") == 1) { _par_got_f(tdb_to_tcb_jd(a)); return 1; }
    if (_par_eq(fp, fl, "tcb_minus_tcg_secular_seconds") == 1) {
        _par_got_f(tcb_minus_tcg_secular_seconds(a));
        return 1;
    }
    if (_par_eq(fp, fl, "tai_to_tt") == 1) { _par_got_f(tai_to_tt(a)); return 1; }
    if (_par_eq(fp, fl, "tt_to_tai") == 1) { _par_got_f(tt_to_tai(a)); return 1; }
    if (_par_eq(fp, fl, "tai_to_gps") == 1) { _par_got_f(tai_to_gps(a)); return 1; }
    if (_par_eq(fp, fl, "gps_to_tai") == 1) { _par_got_f(gps_to_tai(a)); return 1; }
    if (_par_eq(fp, fl, "tai_minus_utc_seconds_mjd") == 1) { _par_got_f(tai_minus_utc_seconds_mjd(a)); return 1; }
    if (_par_eq(fp, fl, "gravitational_redshift") == 1) { _par_got_f(gravitational_redshift(a)); return 1; }
    if (_par_eq(fp, fl, "second_order_doppler_shift") == 1) { _par_got_f(second_order_doppler_shift(a)); return 1; }
    if (_par_eq(fp, fl, "time_dilation_shift_exact") == 1) { _par_got_f(time_dilation_shift_exact(a)); return 1; }
    if (_par_eq(fp, fl, "sagnac_correction_ns") == 1) { _par_got_f(sagnac_correction_ns(a, b)); return 1; }
    if (_par_eq(fp, fl, "schwarzschild_clock_correction_us_per_day") == 1) {
        _par_got_f(schwarzschild_clock_correction_us_per_day(a, b));
        return 1;
    }
    if (_par_eq(fp, fl, "sagnac_one_way_ns") == 1) {
        var c: f64 = _par_in(2);
        var d: f64 = _par_in(3);
        _par_got_f(sagnac_one_way_ns(a, b, c, d));
        return 1;
    }
    if (_par_eq(fp, fl, "AtomicInstant::from_tai_seconds") == 1) {
        var t = TmAtomicInstant_from_tai_seconds(a);
        _par_got_inst(t);
        return 1;
    }
    var ia = _par_in(0);
    var ib = _par_in(1);
    if (_par_eq(fp, fl, "leap_seconds_at") == 1) { _par_got_i(leap_seconds_at(ia, ib)); return 1; }
    if (_par_eq(fp, fl, "tai_to_utc_offset") == 1) { _par_got_f(tai_to_utc_offset(ia, ib)); return 1; }
    if (_par_eq(fp, fl, "utc_to_tai_offset") == 1) { _par_got_f(utc_to_tai_offset(ia, ib)); return 1; }
    if (_par_eq(fp, fl, "AtomicInstant::new") == 1) {
        var t = TmAtomicInstant_new(ia, ib);
        _par_got_inst(t);
        return 1;
    }
    var p = _par_inst(0);
    if (_par_eq(fp, fl, "AtomicInstant::tai_seconds") == 1) { _par_got_f(p.tai_seconds()); return 1; }
    if (_par_eq(fp, fl, "AtomicInstant::to_tt_seconds") == 1) { _par_got_f(p.to_tt_seconds()); return 1; }
    if (_par_eq(fp, fl, "AtomicInstant::to_gps_seconds") == 1) { _par_got_f(p.to_gps_seconds()); return 1; }
    if (_par_eq(fp, fl, "AtomicInstant::add_nanoseconds") == 1) {
        var t = p.add_nanoseconds(_par_in(2));
        _par_got_inst(t);
        return 1;
    }
    if (_par_eq(fp, fl, "AtomicInstant::add_seconds") == 1) {
        var dt: f64 = _par_in(2);
        var t = p.add_seconds(dt);
        _par_got_inst(t);
        return 1;
    }
    var q = _par_inst(2);
    if (_par_eq(fp, fl, "AtomicInstant::duration_since") == 1) { _par_got_f(p.duration_since(q)); return 1; }
    if (_par_eq(fp, fl, "AtomicInstant::nanoseconds_since") == 1) {
        var hi, lo = p.nanoseconds_since(q);
        _par_got_i(hi);
        _par_got_i(lo);
        return 1;
    }
    return 0;
}

# Routes a row to its module's dispatcher. 0 (pending) for a module with none yet.
# A TmOrbitalType value's golden name.
#must_use
fn _par_orbital_name(o): i64 {
    if (o == TM_ORBITAL_TYPE_S) { return "OrbitalType.S"; }
    if (o == TM_ORBITAL_TYPE_P) { return "OrbitalType.P"; }
    if (o == TM_ORBITAL_TYPE_D) { return "OrbitalType.D"; }
    if (o == TM_ORBITAL_TYPE_F) { return "OrbitalType.F"; }
    return "OrbitalType.?";
}

# A TmTransitionType value's golden name.
#must_use
fn _par_transition_name(t): i64 {
    if (t == TM_TRANSITION_TYPE_ELECTRIC_DIPOLE) { return "TransitionType.ElectricDipole"; }
    if (t == TM_TRANSITION_TYPE_FORBIDDEN) { return "TransitionType.Forbidden"; }
    return "TransitionType.?";
}

# A TmElectronAffinity kind's golden name.
#must_use
fn _par_affinity_name(k): i64 {
    if (k == TM_ELECTRON_AFFINITY_BOUND) { return "ElectronAffinity.Bound"; }
    if (k == TM_ELECTRON_AFFINITY_UNBOUND) { return "ElectronAffinity.Unbound"; }
    if (k == TM_ELECTRON_AFFINITY_UNKNOWN) { return "ElectronAffinity.Unknown"; }
    return "ElectronAffinity.?";
}

# Appends a configuration of `n` entries: `v:n`, then `i:n e:OrbitalType.X i:electrons` each.
fn _par_got_config(cfg: *TmOrbitalFilling, n) {
    _par_got_seq(n);
    var k = 0;
    while (k < n) {
        var e: *TmOrbitalFilling = cfg + k;
        _par_got_i(e.n);
        _par_got_e(_par_orbital_name(e.orbital));
        _par_got_i(e.electrons);
        k = k + 1;
    }
}

# Reads the configuration input at token k (`v:len`, then triples) into cfg; returns len.
fn _par_in_config(k, cfg: *TmOrbitalFilling): i64 {
    var len = _par_in(k);
    var j = 0;
    while (j < len) {
        var at = k + 1 + j * 3;
        var e: *TmOrbitalFilling = cfg + j;
        e.n = _par_in(at);
        e.orbital = _par_enum(at + 1);
        e.electrons = _par_in(at + 2);
        j = j + 1;
    }
    return len;
}

# Appends a series result: `v:count`, then `i:n f:λ` per line; or the Err.
fn _par_got_series(t, v, ns, nm) {
    if (is_ok(t) != 1) { _par_got_err(v); return 0; }
    _par_got_seq(v);
    var k = 0;
    while (k < v) {
        _par_got_i(load64(ns + k * 8));
        _par_got_f(load64(nm + k * 8));
        k = k + 1;
    }
    return 0;
}

# `atomic` rows: src/atomic_config.cyr, src/atomic_hydrogenic.cyr and src/atomic_qed.cyr.
fn _par_atomic(fp, fl): i64 {
    if (_par_eq(fp, fl, "OrbitalType::l") == 1) { _par_got_i(orbital_type_l(_par_enum(0))); return 1; }
    if (_par_eq(fp, fl, "OrbitalType::max_electrons") == 1) {
        _par_got_i(orbital_type_max_electrons(_par_enum(0)));
        return 1;
    }
    if (_par_eq(fp, fl, "OrbitalType::symbol") == 1) {
        var ch = alloc(8);
        store8(ch, orbital_type_symbol(_par_enum(0)));
        _par_got_text(ch, 1);
        return 1;
    }
    if (_par_eq(fp, fl, "format_configuration") == 1) {
        var cfg = alloc(32 * 24);
        var len = _par_in_config(0, cfg);
        var s = format_configuration(cfg, len);
        _par_got_text(str_data(s), str_len(s));
        return 1;
    }
    if (_par_eq(fp, fl, "format_configuration_short") == 1) {
        var cfg2 = alloc(32 * 24);
        var len2 = _par_in_config(0, cfg2);
        var s2 = format_configuration_short(cfg2, len2, _par_in(1 + len2 * 3));
        _par_got_text(str_data(s2), str_len(s2));
        return 1;
    }
    var a = _par_in(0);
    var b = _par_in(1);
    var c = _par_in(2);
    var d = _par_in(3);
    var e = _par_in(4);
    if (_par_eq(fp, fl, "QuantumNumbers::new") == 1) {
        var q: TmQuantumNumbers;
        var qt, qv = TmQuantumNumbers_new(a, b, c, d, &q);
        if (is_ok(qt) == 1) {
            _par_got_i(q.n);
            _par_got_i(q.l);
            _par_got_i(q.ml);
            _par_got_i(q.ms);
        } else {
            _par_got_err(qv);
        }
        return 1;
    }
    if (_par_eq(fp, fl, "electron_configuration") == 1) {
        var cfg3 = alloc(32 * 24);
        var ct, cv = electron_configuration(a, cfg3, 32);
        if (is_ok(ct) == 1) { _par_got_config(cfg3, cv); } else { _par_got_err(cv); }
        return 1;
    }
    if (_par_eq(fp, fl, "ionization_energy_ev") == 1) {
        var t, v = ionization_energy_ev(a);
        _par_got_res_f(t, v);
        return 1;
    }
    if (_par_eq(fp, fl, "electron_affinity") == 1) {
        var et, ev = electron_affinity(a);
        if (is_ok(et) != 1) { _par_got_err(ev); return 1; }
        _par_got_e(_par_affinity_name(ev));
        if (ev == TM_ELECTRON_AFFINITY_BOUND) {
            var vt, vv = electron_affinity_ev(a);
            _par_got_f(vv);
        }
        return 1;
    }
    if (_par_eq(fp, fl, "electron_affinity_ev") == 1) {
        var t, v = electron_affinity_ev(a);
        _par_got_res_f(t, v);
        return 1;
    }
    if (_par_eq(fp, fl, "spectral_line_nm") == 1) {
        var t, v = spectral_line_nm(a, b, c);
        _par_got_res_f(t, v);
        return 1;
    }
    if (_par_eq(fp, fl, "reduced_mass_factor") == 1) {
        var t, v = reduced_mass_factor(a, b);
        _par_got_res_f(t, v);
        return 1;
    }
    if (_par_eq(fp, fl, "spectral_line_vacuum_nm") == 1) {
        var t, v = spectral_line_vacuum_nm(a, b, c, d);
        _par_got_res_f(t, v);
        return 1;
    }
    if (_par_eq(fp, fl, "hydrogen_level_energy_ev") == 1) {
        var t, v = hydrogen_level_energy_ev(a, b, c);
        _par_got_res_f(t, v);
        return 1;
    }
    if (_par_eq(fp, fl, "spectral_line_fine_nm") == 1) {
        var t, v = spectral_line_fine_nm(a, b, c, d, e);
        _par_got_res_f(t, v);
        return 1;
    }
    var ns = alloc(512);
    var nm = alloc(512);
    if (_par_eq(fp, fl, "lyman_series") == 1) {
        var t, v = lyman_series(a, b, ns, nm, 64);
        _par_got_series(t, v, ns, nm);
        return 1;
    }
    if (_par_eq(fp, fl, "balmer_series") == 1) {
        var t, v = balmer_series(a, b, ns, nm, 64);
        _par_got_series(t, v, ns, nm);
        return 1;
    }
    if (_par_eq(fp, fl, "paschen_series") == 1) {
        var t, v = paschen_series(a, b, ns, nm, 64);
        _par_got_series(t, v, ns, nm);
        return 1;
    }
    if (_par_eq(fp, fl, "brackett_series") == 1) {
        var t, v = brackett_series(a, b, ns, nm, 64);
        _par_got_series(t, v, ns, nm);
        return 1;
    }
    if (_par_eq(fp, fl, "pfund_series") == 1) {
        var t, v = pfund_series(a, b, ns, nm, 64);
        _par_got_series(t, v, ns, nm);
        return 1;
    }
    var bf: f64 = b;
    var cf: f64 = c;
    var df: f64 = d;
    if (_par_eq(fp, fl, "lande_g_factor") == 1) { _par_got_f(lande_g_factor(a, b)); return 1; }
    if (_par_eq(fp, fl, "zeeman_splitting_ev") == 1) { _par_got_f(zeeman_splitting_ev(a, b, c, df)); return 1; }
    if (_par_eq(fp, fl, "stark_shift_hydrogen_ev") == 1) { _par_got_f(stark_shift_hydrogen_ev(a, b, cf)); return 1; }
    if (_par_eq(fp, fl, "anomalous_zeeman_splitting_ev") == 1) {
        var af: f64 = a;
        _par_got_f(anomalous_zeeman_splitting_ev(af, b, c));
        return 1;
    }
    if (_par_eq(fp, fl, "lamb_shift_nlj_ev") == 1) {
        var t, v = lamb_shift_nlj_ev(a, b, c, d);
        _par_got_res_f(t, v);
        return 1;
    }
    if (_par_eq(fp, fl, "lamb_shift_ev") == 1) { _par_got_f(lamb_shift_ev(a, b, c)); return 1; }
    if (_par_eq(fp, fl, "vacuum_polarization_ev") == 1) { _par_got_f(vacuum_polarization_ev(a, b, c)); return 1; }
    if (_par_eq(fp, fl, "dirac_energy_mev") == 1) {
        var t, v = dirac_energy_mev(a, b, c);
        _par_got_res_f(t, v);
        return 1;
    }
    if (_par_eq(fp, fl, "dirac_binding_energy_ev") == 1) {
        var t, v = dirac_binding_energy_ev(a, b, c);
        _par_got_res_f(t, v);
        return 1;
    }
    if (_par_eq(fp, fl, "relativistic_correction_ev") == 1) {
        var t, v = relativistic_correction_ev(a, b, c);
        _par_got_res_f(t, v);
        return 1;
    }
    if (_par_eq(fp, fl, "hyperfine_splitting_ev") == 1) { _par_got_f(hyperfine_splitting_ev(a, b, cf)); return 1; }
    if (_par_eq(fp, fl, "hyperfine_splitting_spin_ev") == 1) {
        _par_got_f(hyperfine_splitting_spin_ev(a, b, cf, df));
        return 1;
    }
    if (_par_eq(fp, fl, "electron_g_factor") == 1) { _par_got_f(electron_g_factor()); return 1; }
    if (_par_eq(fp, fl, "bound_electron_g_factor") == 1) { _par_got_f(bound_electron_g_factor(a)); return 1; }
    if (_par_eq(fp, fl, "breit_interaction_ev") == 1) { _par_got_f(breit_interaction_ev(a)); return 1; }
    if (_par_eq(fp, fl, "radial_wavefunction") == 1) {
        var t, v = radial_wavefunction(a, b, c, df);
        _par_got_res_f(t, v);
        return 1;
    }
    if (_par_eq(fp, fl, "radial_probability_density") == 1) {
        var t, v = radial_probability_density(a, b, c, df);
        _par_got_res_f(t, v);
        return 1;
    }
    if (_par_eq(fp, fl, "check_selection_rules") == 1) {
        _par_got_e(_par_transition_name(check_selection_rules(a, b)));
        return 1;
    }
    if (_par_eq(fp, fl, "check_selection_rules_full") == 1) {
        _par_got_e(_par_transition_name(check_selection_rules_full(a, b, c, d)));
        return 1;
    }
    if (_par_eq(fp, fl, "einstein_a_coefficient") == 1) {
        var t, v = einstein_a_coefficient(a, b, c, d, e);
        _par_got_res_f(t, v);
        return 1;
    }
    if (_par_eq(fp, fl, "einstein_b_coefficient") == 1) {
        var t, v = einstein_b_coefficient(a, b, c, d, e);
        _par_got_res_f(t, v);
        return 1;
    }
    return 0;
}

# A TmLepton value's golden name, the inverse of _par_enum for leptons.
#must_use
fn _par_lepton_name(l): i64 {
    if (l == TM_LEPTON_ELECTRON) { return "Lepton.Electron"; }
    if (l == TM_LEPTON_ELECTRON_NEUTRINO) { return "Lepton.ElectronNeutrino"; }
    if (l == TM_LEPTON_MUON) { return "Lepton.Muon"; }
    if (l == TM_LEPTON_MUON_NEUTRINO) { return "Lepton.MuonNeutrino"; }
    if (l == TM_LEPTON_TAU) { return "Lepton.Tau"; }
    if (l == TM_LEPTON_TAU_NEUTRINO) { return "Lepton.TauNeutrino"; }
    return "Lepton.?";
}

# A TmNucleosynthesisProcess value's golden name.
#must_use
fn _par_process_name(p): i64 {
    if (p == TM_NUCLEOSYNTHESIS_PROCESS_S_PROCESS) { return "NucleosynthesisProcess.SProcess"; }
    if (p == TM_NUCLEOSYNTHESIS_PROCESS_R_PROCESS) { return "NucleosynthesisProcess.RProcess"; }
    if (p == TM_NUCLEOSYNTHESIS_PROCESS_RP_PROCESS) { return "NucleosynthesisProcess.RpProcess"; }
    return "NucleosynthesisProcess.?";
}

# Appends a reaction's fields: name, projectile (`n:` for none), target, products, neutron
# counts, leptons, Q.
fn _par_got_reaction(r: TmNuclearReaction) {
    _par_got_text(r.name, strlen(r.name));
    if (r.projectile == 0) { _par_got_none(); } else { _par_got_nuc(r.projectile); }
    _par_got_nuc(r.target);
    _par_got_seq(r.product_count);
    var k = 0;
    while (k < r.product_count) {
        _par_got_nuc(r.product(k));
        k = k + 1;
    }
    _par_got_i(r.neutrons_in);
    _par_got_i(r.neutrons_out);
    _par_got_seq(r.lepton_count);
    k = 0;
    while (k < r.lepton_count) {
        _par_got_e(_par_lepton_name(r.lepton(k)));
        k = k + 1;
    }
    _par_got_f(r.q_value_mev);
}

# Appends a pathway: name, process, seed, then each step's nucleus and reaction text.
fn _par_got_pathway(p: TmNucleosynthesisPathway) {
    _par_got_text(p.name, strlen(p.name));
    _par_got_e(_par_process_name(p.process));
    _par_got_nuc(p.seed);
    _par_got_seq(p.step_count);
    var k = 0;
    while (k < p.step_count) {
        var st = p.step(k);
        _par_got_nuc(st.nucleus);
        _par_got_text(st.reaction, strlen(st.reaction));
        k = k + 1;
    }
}

# `reaction` rows: src/reaction.cyr.
fn _par_reaction(fp, fl): i64 {
    if (_par_eq(fp, fl, "dt_fusion") == 1) { _par_got_reaction(dt_fusion()); return 1; }
    if (_par_eq(fp, fl, "dd_fusion_he3") == 1) { _par_got_reaction(dd_fusion_he3()); return 1; }
    if (_par_eq(fp, fl, "dd_fusion_t") == 1) { _par_got_reaction(dd_fusion_t()); return 1; }
    if (_par_eq(fp, fl, "pp_chain_step1") == 1) { _par_got_reaction(pp_chain_step1()); return 1; }
    if (_par_eq(fp, fl, "u235_fission") == 1) { _par_got_reaction(u235_fission()); return 1; }
    if (_par_eq(fp, fl, "cno_cycle") == 1) { _par_got_reaction(cno_cycle()); return 1; }
    if (_par_eq(fp, fl, "triple_alpha") == 1) { _par_got_reaction(triple_alpha()); return 1; }
    if (_par_eq(fp, fl, "s_process_main") == 1) { _par_got_pathway(s_process_main()); return 1; }
    if (_par_eq(fp, fl, "r_process_main") == 1) { _par_got_pathway(r_process_main()); return 1; }
    if (_par_eq(fp, fl, "thermal_neutron_cross_sections") == 1) {
        _par_got_seq(thermal_neutron_cross_section_count());
        return 1;
    }
    if (_par_eq(fp, fl, "u235_fission_yields") == 1) { _par_got_seq(u235_fission_yield_count()); return 1; }
    if (_par_eq(fp, fl, "pu239_fission_yields") == 1) { _par_got_seq(pu239_fission_yield_count()); return 1; }
    if (_par_eq(fp, fl, "const") == 1) {
        if (_par_eq(load64(_par_in_v), load64(_par_in_l), "CNO_NEUTRINO_LOSS_MEV") != 1) { return 0 - 1; }
        var cno: f64 = TM_CNO_NEUTRINO_LOSS_MEV;
        _par_got_f(cno);
        return 1;
    }
    if (_par_eq(fp, fl, "NuclearReaction::nuclear_charge_change") == 1
        || _par_eq(fp, fl, "NuclearReaction::baryon_number_change") == 1) {
        var r: TmNuclearReaction;
        var at = 0;
        r.projectile = 0;
        if (load64(_par_in_k) == 110) { at = 1; } else { r.projectile = _tm_nuc(_par_in(0), _par_in(1)); at = 2; }
        r.target = _tm_nuc(_par_in(at), _par_in(at + 1));
        var n = _par_in(at + 2);
        var prods = alloc(n * 8 + 8);
        var j = 0;
        while (j < n) {
            store64(prods + j * 8, _tm_nuc(_par_in(at + 3 + j * 2), _par_in(at + 4 + j * 2)));
            j = j + 1;
        }
        r.products = prods;
        r.product_count = n;
        r.neutrons_in = _par_in(at + 3 + n * 2);
        r.neutrons_out = _par_in(at + 4 + n * 2);
        r.leptons_out = 0;
        r.lepton_count = 0;
        if (_par_eq(fp, fl, "NuclearReaction::nuclear_charge_change") == 1) {
            _par_got_i(r.nuclear_charge_change());
        } else {
            _par_got_i(r.baryon_number_change());
        }
        return 1;
    }
    if (_par_eq(fp, fl, "q_value") == 1) {
        var rs = alloc(256);
        var ps = alloc(256);
        var rn = _par_in_f64s(0, rs);
        var pn = _par_in_f64s(1 + rn, ps);
        _par_got_f(q_value(rs, rn, ps, pn));
        return 1;
    }
    var a = _par_in(0);
    var b = _par_in(1);
    var c = _par_in(2);
    var d = _par_in(3);
    if (_par_eq(fp, fl, "thermal_neutron_cross_sections[]") == 1) {
        var x = thermal_neutron_cross_section(a);
        _par_got_nuc(x.target);
        _par_got_f(x.absorption_barns);
        _par_got_f(x.fission_barns);
        _par_got_f(x.scattering_barns);
        return 1;
    }
    if (_par_eq(fp, fl, "u235_fission_yields[]") == 1) {
        var y = u235_fission_yield(a);
        _par_got_i(y.mass_number);
        _par_got_f(y.yield_fraction);
        return 1;
    }
    if (_par_eq(fp, fl, "pu239_fission_yields[]") == 1) {
        var y2 = pu239_fission_yield(a);
        _par_got_i(y2.mass_number);
        _par_got_f(y2.yield_fraction);
        return 1;
    }
    if (_par_eq(fp, fl, "geometric_cross_section_barns") == 1) {
        _par_got_f(geometric_cross_section_barns(_tm_nuc(a, b)));
        return 1;
    }
    if (_par_eq(fp, fl, "coulomb_barrier") == 1) {
        var t, v = coulomb_barrier(_tm_nuc(a, b), _tm_nuc(c, d));
        _par_got_res_f(t, v);
        return 1;
    }
    if (_par_eq(fp, fl, "resonance_integral_barns") == 1) {
        var t, v = resonance_integral_barns(a, b);
        _par_got_opt_f(t, v);
        return 1;
    }
    if (_par_eq(fp, fl, "fission_resonance_integral_barns") == 1) {
        var t, v = fission_resonance_integral_barns(a, b);
        _par_got_opt_f(t, v);
        return 1;
    }
    if (_par_eq(fp, fl, "n_alpha_resonance_integral_barns") == 1) {
        var t, v = n_alpha_resonance_integral_barns(a, b);
        _par_got_opt_f(t, v);
        return 1;
    }
    if (_par_eq(fp, fl, "max_energy_loss_fraction") == 1) { _par_got_f(max_energy_loss_fraction(a)); return 1; }
    if (_par_eq(fp, fl, "average_lethargy_gain") == 1) { _par_got_f(average_lethargy_gain(a)); return 1; }
    var af: f64 = a;
    var bf: f64 = b;
    var cf: f64 = c;
    if (_par_eq(fp, fl, "collisions_to_thermalize") == 1) { _par_got_f(collisions_to_thermalize(a, bf, cf)); return 1; }
    if (_par_eq(fp, fl, "moderating_ratio") == 1) { _par_got_f(moderating_ratio(af, bf, cf)); return 1; }
    if (_par_eq(fp, fl, "breit_wigner_cross_section") == 1) {
        var df: f64 = d;
        var ef: f64 = _par_in(4);
        var gf: f64 = _par_in(5);
        var mf: f64 = _par_in(6);
        _par_got_f(breit_wigner_cross_section(af, bf, cf, df, ef, gf, mf));
        return 1;
    }
    return 0;
}

# `scattering` rows: src/scattering.cyr.
fn _par_scattering(fp, fl): i64 {
    if (_par_eq(fp, fl, "partial_wave_cross_section") == 1 || _par_eq(fp, fl, "partial_wave_differential") == 1) {
        var kf: f64 = _par_in(0);
        var ds = alloc(256);
        var n = _par_in_f64s(1, ds);
        if (_par_eq(fp, fl, "partial_wave_cross_section") == 1) {
            _par_got_f(partial_wave_cross_section(kf, ds, n));
        } else {
            var th: f64 = _par_in(2 + n);
            _par_got_f(partial_wave_differential(kf, ds, n, th));
        }
        return 1;
    }
    var a = _par_in(0);
    var b = _par_in(1);
    var c = _par_in(2);
    var d = _par_in(3);
    var af: f64 = a;
    var bf: f64 = b;
    var cf: f64 = c;
    var df: f64 = d;
    var ef: f64 = _par_in(4);
    if (_par_eq(fp, fl, "rutherford_differential") == 1) {
        _par_got_f(rutherford_differential(a, b, cf, df));
        return 1;
    }
    if (_par_eq(fp, fl, "rutherford_total_above_angle") == 1) {
        _par_got_f(rutherford_total_above_angle(a, b, cf, df));
        return 1;
    }
    if (_par_eq(fp, fl, "distance_of_closest_approach") == 1) {
        _par_got_f(distance_of_closest_approach(a, b, cf));
        return 1;
    }
    if (_par_eq(fp, fl, "sommerfeld_parameter") == 1) { _par_got_f(sommerfeld_parameter(a, b, cf)); return 1; }
    if (_par_eq(fp, fl, "mott_correction_factor") == 1) { _par_got_f(mott_correction_factor(af, bf)); return 1; }
    if (_par_eq(fp, fl, "legendre_polynomial") == 1) { _par_got_f(legendre_polynomial(a, bf)); return 1; }
    if (_par_eq(fp, fl, "thomas_fermi_screening_fm") == 1) { _par_got_f(thomas_fermi_screening_fm(a)); return 1; }
    if (_par_eq(fp, fl, "born_screened_coulomb") == 1) {
        _par_got_f(born_screened_coulomb(a, b, cf, df, ef));
        return 1;
    }
    if (_par_eq(fp, fl, "born_screened_coulomb_with_masses") == 1) {
        var ff: f64 = _par_in(5);
        var gf: f64 = _par_in(6);
        _par_got_f(born_screened_coulomb_with_masses(a, b, cf, df, ef, ff, gf));
        return 1;
    }
    if (_par_eq(fp, fl, "mott_electron_differential") == 1) {
        _par_got_f(mott_electron_differential(a, bf, cf));
        return 1;
    }
    if (_par_eq(fp, fl, "mott_electron_with_form_factor") == 1) {
        _par_got_f(mott_electron_with_form_factor(a, b, cf, df));
        return 1;
    }
    if (_par_eq(fp, fl, "nuclear_form_factor_uniform") == 1) {
        _par_got_f(nuclear_form_factor_uniform(af, bf));
        return 1;
    }
    if (_par_eq(fp, fl, "compton_energy_ratio") == 1) { _par_got_f(compton_energy_ratio(af, bf)); return 1; }
    if (_par_eq(fp, fl, "klein_nishina_differential") == 1) {
        _par_got_f(klein_nishina_differential(af, bf));
        return 1;
    }
    if (_par_eq(fp, fl, "klein_nishina_total") == 1) { _par_got_f(klein_nishina_total(af)); return 1; }
    if (_par_eq(fp, fl, "pair_production_cross_section") == 1) {
        _par_got_f(pair_production_cross_section(a, bf));
        return 1;
    }
    return 0;
}

# `bridge` rows: src/bridge.cyr, the chrono bridge.
fn _par_bridge(fp, fl): i64 {
    if (_par_eq(fp, fl, "utc_date_to_tai_offset") == 1) {
        _par_got_i(utc_date_to_tai_offset(_par_in(0), _par_in(1)));
        return 1;
    }
    var s: f64 = _par_in(0);
    if (_par_eq(fp, fl, "tai_to_utc_seconds") == 1) {
        _par_got_f(tai_to_utc_seconds(s, _par_in(1), _par_in(2)));
        return 1;
    }
    if (_par_eq(fp, fl, "utc_to_tai_seconds") == 1) {
        _par_got_f(utc_to_tai_seconds(s, _par_in(1), _par_in(2)));
        return 1;
    }
    return 0;
}

fn _par_dispatch(mp, ml, fp, fl): i64 {
    _par_got_n = 0;
    if (_par_eq(mp, ml, "constants") == 1) { return _par_constants(fp, fl); }
    if (_par_eq(mp, ml, "libm") == 1) { return _par_libm(fp, fl); }
    if (_par_eq(mp, ml, "particle") == 1) { return _par_particle(fp, fl); }
    if (_par_eq(mp, ml, "relativity") == 1) { return _par_relativity(fp, fl); }
    if (_par_eq(mp, ml, "nucleus") == 1) { return _par_nucleus(fp, fl); }
    if (_par_eq(mp, ml, "decay") == 1) { return _par_decay(fp, fl); }
    if (_par_eq(mp, ml, "timekeeping") == 1) { return _par_timekeeping(fp, fl); }
    if (_par_eq(mp, ml, "atomic") == 1) { return _par_atomic(fp, fl); }
    if (_par_eq(mp, ml, "reaction") == 1) { return _par_reaction(fp, fl); }
    if (_par_eq(mp, ml, "scattering") == 1) { return _par_scattering(fp, fl); }
    if (_par_eq(mp, ml, "bridge") == 1) { return _par_bridge(fp, fl); }
    return 0;
}

# The class-C bound for a function, in ulps; -1 when none is set yet (the rows are measured).
# The derivation is in docs/development/port-parity.md. Set a function's bound BEFORE its
# first comparison, from that evidence, and never raise it to make a row pass.
#
# The libm primitives get 2 ulp: each side documents < 1 ulp (Cyrius lib/math.cyr, ganita,
# fdlibm in Rust libm), so two implementations can differ by up to 2. That holds on x86_64
# ELF, x86_64 PE and aarch64, measured 2026-11-08 (max 1 ulp). hypot is no longer class C:
# its rows go to the port's bit-exact _tm_hypot and are class A.
#must_use
fn _par_c_bound(fp, fl): i64 {
    if (_par_eq(fp, fl, "libm::tan") == 1) { return 2; }
    if (_par_eq(fp, fl, "libm::exp") == 1) { return 2; }
    if (_par_eq(fp, fl, "libm::sinh") == 1) { return 2; }
    if (_par_eq(fp, fl, "libm::pow") == 1) { return 2; }
    # M2, by the port-parity rule: S = 0 (pow results nudged ±1 ulp on all 2,053 golden rows), 2 calls.
    if (_par_eq(fp, fl, "Nucleus::atomic_mass_amu") == 1) { return 2; }
    # M2: the output is the pow result itself, so S = 1 with 1 call: K = 2·1·1 + 2.
    if (_par_eq(fp, fl, "remaining_fraction") == 1) { return 4; }
    # M5: S = 2 (sin nudged ±1 ulp on all 21 golden rows), 1 call: K = 2·2·1 + 2.
    if (_par_eq(fp, fl, "sagnac_correction_ns") == 1) { return 6; }
    # M3: ln nudged ±1 ulp on every s-state golden row gives S = 4, 1 call: K = 2·4·1 + 2. The
    # l > 0 rows have no ln. lamb_shift_ev's s states are lamb_shift_nlj_ev's value.
    if (_par_eq(fp, fl, "lamb_shift_nlj_ev") == 1) { return 10; }
    if (_par_eq(fp, fl, "lamb_shift_ev") == 1) { return 10; }
    # M3: exp nudged ±1 ulp on every golden row: R = (N·P)·e gives S = 2, R²r² gives S = 8.
    if (_par_eq(fp, fl, "radial_wavefunction") == 1) { return 6; }
    if (_par_eq(fp, fl, "radial_probability_density") == 1) { return 18; }
    # M4: ganita's tan nudged ±1 ulp on every golden row: S = 4, 1 call: K = 2·4·1 + 2. The other
    # M4 functions use the port's bit-exact sin, cos and log, so they are class B.
    if (_par_eq(fp, fl, "rutherford_total_above_angle") == 1) { return 10; }
    return 0 - 1;
}

# 1 if the row (function and raw input field) is a divergence an ADR accepts. Each entry
# names its ADR. An accepted row is reported on every run and doesn't fail its module.
#must_use
fn _par_accepted(fp, fl, ip, il): i64 {
    # ADR 0007: ganita pow(-1, |y| > 2^64) gives +inf / +0 instead of 1 (filed upstream).
    if (_par_eq(fp, fl, "libm::pow") == 1 && _par_eq(ip, il, "f:bff0000000000000 f:7fefffffffffffff") == 1) {
        return 7;
    }
    return 0;
}

# The optics module needs prakash: tests/optics_parity.tcyr replays it.
#must_use
fn _par_skip(mp, ml): i64 { return _par_eq(mp, ml, "optics"); }

var exit_code = _par_main();
sys_exit_group(exit_code);
