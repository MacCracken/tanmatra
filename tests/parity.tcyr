# parity.tcyr — replays the golden corpus (tests/golden/*.tsv) against the port.
#
# Port plan §2 step 7. Format and comparison rules: scripts/oracle/README.md. The module
# list is tests/golden/modules.txt, which the generator writes.
#
# Every row of every module is one of:
# - ok: every output matched within its class;
# - FAILED: an output differs; the first few are printed with the row's note;
# - measured: class C, with no bound set yet for its function. The ulp distance is
#   recorded but not gated. Bounds are set per function before its comparison
#   (docs/development/port-parity.md);
# - accepted: a divergence an ADR accepts, listed by row in _par_accepted;
# - pending: its function isn't ported yet (no dispatcher entry).
#
# Per function it prints the row counts and the ulp histogram, which is the step 8
# baseline. The exit code is the number of modules with a failure, at most a handful, so
# the 8-bit exit status can't wrap.

include "tests/ulp.cyr"
include "src/error.cyr"
include "src/numerics.cyr"
include "src/constants.cyr"
include "src/particle_data.cyr"
include "src/particle.cyr"
include "src/relativity.cyr"
include "src/nucleus_data.cyr"
include "src/nucleus.cyr"
include "src/shell_model.cyr"
include "src/decay_data.cyr"
include "src/decay.cyr"

alloc_init();

# ── tokens ──────────────────────────────────────────────────────────────────────────
# Three token lists of up to _PAR_MAX tokens: the row's inputs, its wanted outputs, and what the port returned.
# Each slot is a kind byte ('f' 'i' 'e' 's' 'n' 'E' 'v'), a value word (f64 bits, an
# integer, or a pointer to text) and a text length.
var _PAR_MAX = 256;
var _par_in_k = 0;
var _par_in_v = 0;
var _par_in_l = 0;
var _par_in_n = 0;
var _par_want_k = 0;
var _par_want_v = 0;
var _par_want_l = 0;
var _par_want_n = 0;
var _par_got_k = 0;
var _par_got_v = 0;
var _par_got_l = 0;
var _par_got_n = 0;

# 1 if text [p, p + len) equals the C string `s`.
#must_use
fn _par_eq(p, len, s): i64 {
    if (len != strlen(s)) { return 0; }
    return memeq(p, s, len);
}

# The value of hex digit byte `c`, or -1.
#must_use
fn _par_hex_digit(c): i64 {
    if (c >= 48 && c <= 57) { return c - 48; }
    if (c >= 97 && c <= 102) { return c - 87; }
    if (c >= 65 && c <= 70) { return c - 55; }
    return 0 - 1;
}

# Parses [p, p + len) as unsigned hex. Returns the word; sets *ok to 0 on a bad digit.
fn _par_parse_hex(p, len, ok) {
    var v = 0;
    var k = 0;
    while (k < len) {
        var d = _par_hex_digit(load8(p + k));
        if (d < 0) { store64(ok, 0); return 0; }
        v = (v << 4) | d;
        k = k + 1;
    }
    return v;
}

# Parses [p, p + len) as a signed decimal. Sets *ok to 0 on a bad digit.
fn _par_parse_int(p, len, ok) {
    var k = 0;
    var neg = 0;
    if (len > 0 && load8(p) == 45) { neg = 1; k = 1; }
    if (k >= len) { store64(ok, 0); return 0; }
    var v = 0;
    while (k < len) {
        var c = load8(p + k);
        if (c < 48 || c > 57) { store64(ok, 0); return 0; }
        v = v * 10 + (c - 48);
        k = k + 1;
    }
    if (neg == 1) { return 0 - v; }
    return v;
}

# Parses the space-separated tokens of [p, p + len) into a token list. Returns the count,
# or -1 on a malformed token. `-` is the empty list.
fn _par_tokens(p, len, kinds, vals, lens): i64 {
    if (len == 1 && load8(p) == 45) { return 0; }
    var n = 0;
    var at = 0;
    while (at < len) {
        var end = at;
        while (end < len && load8(p + end) != 32) { end = end + 1; }
        var tp = p + at;
        var tl = end - at;
        if (tl < 2 || load8(tp + 1) != 58 || n >= _PAR_MAX) { return 0 - 1; }
        var kind = load8(tp);
        var body = tp + 2;
        var blen = tl - 2;
        var okw[8];
        store64(&okw, 1);
        var v = 0;
        if (kind == 102) {
            if (blen != 16) { return 0 - 1; }
            v = _par_parse_hex(body, blen, &okw);
        } elif (kind == 105 || kind == 118) {
            v = _par_parse_int(body, blen, &okw);
        } else {
            v = body;
        }
        if (load64(&okw) != 1) { return 0 - 1; }
        store64(kinds + n * 8, kind);
        store64(vals + n * 8, v);
        store64(lens + n * 8, blen);
        n = n + 1;
        at = end + 1;
    }
    return n;
}

# Input token k as a word (f64 bits or integer).
#must_use
fn _par_in(k): i64 { return load64(_par_in_v + k * 8); }

# Appends an f64 result word to the got list.
fn _par_got_f(bits) {
    var at = _par_got_n * 8;
    store64(_par_got_k + at, 102);
    store64(_par_got_v + at, bits);
    store64(_par_got_l + at, 16);
    _par_got_n = _par_got_n + 1;
}

# Appends an integer result to the got list.
fn _par_got_i(v) {
    var at = _par_got_n * 8;
    store64(_par_got_k + at, 105);
    store64(_par_got_v + at, v);
    store64(_par_got_l + at, 0);
    _par_got_n = _par_got_n + 1;
}

# Appends a sequence length (`v:`) to the got list.
fn _par_got_seq(n) {
    var at = _par_got_n * 8;
    store64(_par_got_k + at, 118);
    store64(_par_got_v + at, n);
    store64(_par_got_l + at, 0);
    _par_got_n = _par_got_n + 1;
}

# Appends an enum result to the got list, as its golden text ("Boson.Photon").
fn _par_got_e(name) {
    var at = _par_got_n * 8;
    store64(_par_got_k + at, 101);
    store64(_par_got_v + at, name);
    store64(_par_got_l + at, strlen(name));
    _par_got_n = _par_got_n + 1;
}

# Appends a four-momentum's components to the got list.
fn _par_got_fm(p: TmFourMomentum) {
    _par_got_f(p.energy);
    _par_got_f(p.px);
    _par_got_f(p.py);
    _par_got_f(p.pz);
}

# The TM_ value of input k's enum token (`e:Quark.Up` is TM_QUARK_UP), or -1. Each name maps
# by the rule TM_ + snake(enum) + _ + snake(variant), spelled out here (scripts/oracle/README.md).
fn _par_enum(k): i64 {
    var at = k * 8;
    if (load64(_par_in_k + at) != 101) { return 0 - 1; }
    var p = load64(_par_in_v + at);
    var l = load64(_par_in_l + at);
    if (_par_eq(p, l, "Quark.Up") == 1) { return TM_QUARK_UP; }
    if (_par_eq(p, l, "Quark.Down") == 1) { return TM_QUARK_DOWN; }
    if (_par_eq(p, l, "Quark.Charm") == 1) { return TM_QUARK_CHARM; }
    if (_par_eq(p, l, "Quark.Strange") == 1) { return TM_QUARK_STRANGE; }
    if (_par_eq(p, l, "Quark.Top") == 1) { return TM_QUARK_TOP; }
    if (_par_eq(p, l, "Quark.Bottom") == 1) { return TM_QUARK_BOTTOM; }
    if (_par_eq(p, l, "Lepton.Electron") == 1) { return TM_LEPTON_ELECTRON; }
    if (_par_eq(p, l, "Lepton.ElectronNeutrino") == 1) { return TM_LEPTON_ELECTRON_NEUTRINO; }
    if (_par_eq(p, l, "Lepton.Muon") == 1) { return TM_LEPTON_MUON; }
    if (_par_eq(p, l, "Lepton.MuonNeutrino") == 1) { return TM_LEPTON_MUON_NEUTRINO; }
    if (_par_eq(p, l, "Lepton.Tau") == 1) { return TM_LEPTON_TAU; }
    if (_par_eq(p, l, "Lepton.TauNeutrino") == 1) { return TM_LEPTON_TAU_NEUTRINO; }
    if (_par_eq(p, l, "Boson.Photon") == 1) { return TM_BOSON_PHOTON; }
    if (_par_eq(p, l, "Boson.Gluon") == 1) { return TM_BOSON_GLUON; }
    if (_par_eq(p, l, "Boson.WPlus") == 1) { return TM_BOSON_W_PLUS; }
    if (_par_eq(p, l, "Boson.WMinus") == 1) { return TM_BOSON_W_MINUS; }
    if (_par_eq(p, l, "Boson.Z") == 1) { return TM_BOSON_Z; }
    if (_par_eq(p, l, "Boson.Higgs") == 1) { return TM_BOSON_HIGGS; }
    if (_par_eq(p, l, "FundamentalForce.Strong") == 1) { return TM_FUNDAMENTAL_FORCE_STRONG; }
    if (_par_eq(p, l, "FundamentalForce.Electromagnetic") == 1) { return TM_FUNDAMENTAL_FORCE_ELECTROMAGNETIC; }
    if (_par_eq(p, l, "FundamentalForce.Weak") == 1) { return TM_FUNDAMENTAL_FORCE_WEAK; }
    if (_par_eq(p, l, "FundamentalForce.Gravity") == 1) { return TM_FUNDAMENTAL_FORCE_GRAVITY; }
    return 0 - 1;
}

# A TmBoson value's golden name, the inverse of _par_enum for bosons.
#must_use
fn _par_boson_name(b): i64 {
    if (b == TM_BOSON_PHOTON) { return "Boson.Photon"; }
    if (b == TM_BOSON_GLUON) { return "Boson.Gluon"; }
    if (b == TM_BOSON_W_PLUS) { return "Boson.WPlus"; }
    if (b == TM_BOSON_W_MINUS) { return "Boson.WMinus"; }
    if (b == TM_BOSON_Z) { return "Boson.Z"; }
    if (b == TM_BOSON_HIGGS) { return "Boson.Higgs"; }
    return "Boson.?";
}

# ── dispatch ────────────────────────────────────────────────────────────────────────
# Each module's dispatcher fills the got list for one row. It returns 1 when it handled
# the function, 0 when the function is pending (not ported), or -1 when the inputs are
# unusable (a defect, counted as a failure). Add a function the moment it's ported.

# `const` rows: the generated TM_ constants (src/constants.cyr).
fn _par_constants(fp, fl): i64 {
    if (_par_eq(fp, fl, "const") != 1 || _par_in_n != 1) { return 0; }
    var np = load64(_par_in_v);
    var nl = load64(_par_in_l);
    var x: f64 = 0.0;
    if (_par_eq(np, nl, "ELECTRON_MASS_MEV") == 1) { x = TM_ELECTRON_MASS_MEV; }
    elif (_par_eq(np, nl, "PROTON_MASS_MEV") == 1) { x = TM_PROTON_MASS_MEV; }
    elif (_par_eq(np, nl, "NEUTRON_MASS_MEV") == 1) { x = TM_NEUTRON_MASS_MEV; }
    elif (_par_eq(np, nl, "AMU_MEV") == 1) { x = TM_AMU_MEV; }
    elif (_par_eq(np, nl, "FINE_STRUCTURE") == 1) { x = TM_FINE_STRUCTURE; }
    elif (_par_eq(np, nl, "HBAR_EV_S") == 1) { x = TM_HBAR_EV_S; }
    elif (_par_eq(np, nl, "RYDBERG") == 1) { x = TM_RYDBERG; }
    elif (_par_eq(np, nl, "BOHR_RADIUS") == 1) { x = TM_BOHR_RADIUS; }
    elif (_par_eq(np, nl, "AVOGADRO") == 1) { x = TM_AVOGADRO; }
    elif (_par_eq(np, nl, "ELEMENTARY_CHARGE") == 1) { x = TM_ELEMENTARY_CHARGE; }
    elif (_par_eq(np, nl, "C") == 1) { x = TM_C; }
    elif (_par_eq(np, nl, "R0_FM") == 1) { x = TM_R0_FM; }
    elif (_par_eq(np, nl, "BOLTZMANN_EV") == 1) { x = TM_BOLTZMANN_EV; }
    elif (_par_eq(np, nl, "H_EV_S") == 1) { x = TM_H_EV_S; }
    elif (_par_eq(np, nl, "HBAR_MEV_S") == 1) { x = TM_HBAR_MEV_S; }
    elif (_par_eq(np, nl, "BOHR_MAGNETON_EV_T") == 1) { x = TM_BOHR_MAGNETON_EV_T; }
    elif (_par_eq(np, nl, "COULOMB_MEV_FM") == 1) { x = TM_COULOMB_MEV_FM; }
    elif (_par_eq(np, nl, "CLASSICAL_ELECTRON_RADIUS_FM") == 1) { x = TM_CLASSICAL_ELECTRON_RADIUS_FM; }
    elif (_par_eq(np, nl, "PROTON_G_FACTOR") == 1) { x = TM_PROTON_G_FACTOR; }
    elif (_par_eq(np, nl, "ELECTRON_ANOMALOUS_MOMENT") == 1) { x = TM_ELECTRON_ANOMALOUS_MOMENT; }
    elif (_par_eq(np, nl, "STANDARD_GRAVITY") == 1) { x = TM_STANDARD_GRAVITY; }
    elif (_par_eq(np, nl, "GM_EARTH") == 1) { x = TM_GM_EARTH; }
    elif (_par_eq(np, nl, "EARTH_ROTATION_RAD_S") == 1) { x = TM_EARTH_ROTATION_RAD_S; }
    elif (_par_eq(np, nl, "HBAR_C_MEV_FM") == 1) { x = TM_HBAR_C_MEV_FM; }
    elif (_par_eq(np, nl, "HC_EV_NM") == 1) { x = TM_HC_EV_NM; }
    elif (_par_eq(np, nl, "RYDBERG_EV") == 1) { x = TM_RYDBERG_EV; }
    elif (_par_eq(np, nl, "ELECTRON_MASS_U") == 1) { x = TM_ELECTRON_MASS_U; }
    elif (_par_eq(np, nl, "PROTON_MASS_U") == 1) { x = TM_PROTON_MASS_U; }
    elif (_par_eq(np, nl, "NEUTRON_MASS_U") == 1) { x = TM_NEUTRON_MASS_U; }
    elif (_par_eq(np, nl, "HYDROGEN_ATOM_MASS_U") == 1) { x = TM_HYDROGEN_ATOM_MASS_U; }
    elif (_par_eq(np, nl, "NUCLEAR_MAGNETON_EV_T") == 1) { x = TM_NUCLEAR_MAGNETON_EV_T; }
    elif (_par_eq(np, nl, "DEUTERON_G_FACTOR") == 1) { x = TM_DEUTERON_G_FACTOR; }
    elif (_par_eq(np, nl, "ATOMIC_UNIT_TIME_S") == 1) { x = TM_ATOMIC_UNIT_TIME_S; }
    elif (_par_eq(np, nl, "COULOMB_K_SI") == 1) { x = TM_COULOMB_K_SI; }
    else { return 0 - 1; }
    _par_got_f(x);
    return 1;
}

# `libm::` rows: the Cyrius math function each libm call maps to (port plan §5).
# libm::round needs the port's half-away helper (M5), so it is pending until then; libm::ldexp
# is the port's _tm_ldexp (M2), Rust libm's scalbn operation for operation.
fn _par_libm(fp, fl): i64 {
    var x: f64 = _par_in(0);
    if (_par_eq(fp, fl, "libm::sqrt") == 1) { var r: f64 = f64_sqrt(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "libm::fabs") == 1) { var r: f64 = f64_abs(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "libm::floor") == 1) { var r: f64 = f64_floor(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "libm::trunc") == 1) { var r: f64 = f64_trunc(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "libm::cbrt") == 1) { var r: f64 = ganita_f64_cbrt(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "libm::sin") == 1) { var r: f64 = f64_sin(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "libm::cos") == 1) { var r: f64 = f64_cos(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "libm::tan") == 1) { var r: f64 = ganita_f64_tan(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "libm::exp") == 1) { var r: f64 = f64_exp(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "libm::log") == 1) { var r: f64 = f64_ln(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "libm::sinh") == 1) { var r: f64 = ganita_f64_sinh(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "libm::ldexp") == 1) { var r: f64 = _tm_ldexp(x, _par_in(1)); _par_got_f(r); return 1; }
    var y: f64 = _par_in(1);
    if (_par_eq(fp, fl, "libm::pow") == 1) { var r: f64 = ganita_f64_pow(x, y); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "libm::hypot") == 1) { var r: f64 = _tm_hypot(x, y); _par_got_f(r); return 1; }
    return 0;
}

# `particle` rows: src/particle.cyr, one function per Rust enum method.
fn _par_particle(fp, fl): i64 {
    var v = _par_enum(0);
    if (v < 0) { return 0 - 1; }
    if (_par_eq(fp, fl, "Quark::mass_mev") == 1) { _par_got_f(quark_mass_mev(v)); return 1; }
    if (_par_eq(fp, fl, "Quark::charge") == 1) { _par_got_f(quark_charge(v)); return 1; }
    if (_par_eq(fp, fl, "Quark::generation") == 1) { _par_got_i(quark_generation(v)); return 1; }
    if (_par_eq(fp, fl, "Lepton::mass_mev") == 1) { _par_got_f(lepton_mass_mev(v)); return 1; }
    if (_par_eq(fp, fl, "Lepton::charge") == 1) { _par_got_f(lepton_charge(v)); return 1; }
    if (_par_eq(fp, fl, "Lepton::generation") == 1) { _par_got_i(lepton_generation(v)); return 1; }
    if (_par_eq(fp, fl, "Lepton::lifetime_seconds") == 1) { _par_got_f(lepton_lifetime_seconds(v)); return 1; }
    if (_par_eq(fp, fl, "Lepton::decay_width_mev") == 1) { _par_got_f(lepton_decay_width_mev(v)); return 1; }
    if (_par_eq(fp, fl, "Lepton::is_stable") == 1) { _par_got_i(lepton_is_stable(v)); return 1; }
    if (_par_eq(fp, fl, "Boson::mass_mev") == 1) { _par_got_f(boson_mass_mev(v)); return 1; }
    if (_par_eq(fp, fl, "Boson::spin") == 1) { _par_got_i(boson_spin(v)); return 1; }
    if (_par_eq(fp, fl, "Boson::charge") == 1) { _par_got_f(boson_charge(v)); return 1; }
    if (_par_eq(fp, fl, "Boson::decay_width_mev") == 1) { _par_got_f(boson_decay_width_mev(v)); return 1; }
    if (_par_eq(fp, fl, "Boson::lifetime_seconds") == 1) { _par_got_f(boson_lifetime_seconds(v)); return 1; }
    if (_par_eq(fp, fl, "Boson::is_stable") == 1) { _par_got_i(boson_is_stable(v)); return 1; }
    if (_par_eq(fp, fl, "FundamentalForce::relative_strength") == 1) {
        _par_got_f(fundamental_force_relative_strength(v));
        return 1;
    }
    if (_par_eq(fp, fl, "FundamentalForce::range_meters") == 1) {
        _par_got_f(fundamental_force_range_meters(v));
        return 1;
    }
    if (_par_eq(fp, fl, "FundamentalForce::mediator") == 1) {
        var n = fundamental_force_mediator_count(v);
        _par_got_seq(n);
        var k = 0;
        while (k < n) { _par_got_e(_par_boson_name(fundamental_force_mediator(v, k))); k = k + 1; }
        return 1;
    }
    return 0;
}

# The four-momentum in inputs k .. k + 3.
fn _par_fm(k): TmFourMomentum {
    var e: f64 = _par_in(k);
    var x: f64 = _par_in(k + 1);
    var y: f64 = _par_in(k + 2);
    var z: f64 = _par_in(k + 3);
    var p: TmFourMomentum = TmFourMomentum_new(e, x, y, z);
    return p;
}

# `relativity` rows: src/relativity.cyr.
fn _par_relativity(fp, fl): i64 {
    var a: f64 = _par_in(0);
    var b: f64 = _par_in(1);
    if (_par_eq(fp, fl, "lorentz_gamma") == 1) { _par_got_f(lorentz_gamma(a)); return 1; }
    if (_par_eq(fp, fl, "gamma_to_beta") == 1) { _par_got_f(gamma_to_beta(a)); return 1; }
    if (_par_eq(fp, fl, "beta_to_velocity") == 1) { _par_got_f(beta_to_velocity(a)); return 1; }
    if (_par_eq(fp, fl, "velocity_to_beta") == 1) { _par_got_f(velocity_to_beta(a)); return 1; }
    if (_par_eq(fp, fl, "de_broglie_wavelength_fm") == 1) { _par_got_f(de_broglie_wavelength_fm(a)); return 1; }
    if (_par_eq(fp, fl, "velocity_addition") == 1) { _par_got_f(velocity_addition(a, b)); return 1; }
    if (_par_eq(fp, fl, "relativistic_energy") == 1) { _par_got_f(relativistic_energy(a, b)); return 1; }
    if (_par_eq(fp, fl, "relativistic_momentum") == 1) { _par_got_f(relativistic_momentum(a, b)); return 1; }
    if (_par_eq(fp, fl, "FourMomentum::at_rest") == 1) {
        var r = TmFourMomentum_at_rest(a);
        _par_got_fm(r);
        return 1;
    }
    if (_par_eq(fp, fl, "FourMomentum::from_mass_and_momentum") == 1) {
        var r = TmFourMomentum_from_mass_and_momentum(a, b);
        _par_got_fm(r);
        return 1;
    }
    var p = _par_fm(0);
    if (_par_eq(fp, fl, "FourMomentum::new") == 1) { _par_got_fm(p); return 1; }
    if (_par_eq(fp, fl, "FourMomentum::momentum_magnitude") == 1) { _par_got_f(p.momentum_magnitude()); return 1; }
    if (_par_eq(fp, fl, "FourMomentum::invariant_mass") == 1) { _par_got_f(p.invariant_mass()); return 1; }
    if (_par_eq(fp, fl, "FourMomentum::beta") == 1) { _par_got_f(p.beta()); return 1; }
    if (_par_eq(fp, fl, "FourMomentum::gamma") == 1) { _par_got_f(p.gamma()); return 1; }
    if (_par_eq(fp, fl, "FourMomentum::kinetic_energy") == 1) { _par_got_f(p.kinetic_energy()); return 1; }
    var q = _par_fm(4);
    if (_par_eq(fp, fl, "FourMomentum::add") == 1) {
        var s: TmFourMomentum = p + q;
        _par_got_fm(s);
        return 1;
    }
    if (_par_eq(fp, fl, "invariant_mass_two_body") == 1) { _par_got_f(invariant_mass_two_body(p, q)); return 1; }
    return 0;
}

# Appends Option::None (`n:`) to the got list.
fn _par_got_none() {
    var at = _par_got_n * 8;
    store64(_par_got_k + at, 110);
    store64(_par_got_v + at, 0);
    store64(_par_got_l + at, 0);
    _par_got_n = _par_got_n + 1;
}

# Appends an error (`E:Variant`) to the got list, by its Rust variant name.
fn _par_got_err(code) {
    var name = tm_error_name(code);
    var at = _par_got_n * 8;
    store64(_par_got_k + at, 69);
    store64(_par_got_v + at, name);
    store64(_par_got_l + at, strlen(name));
    _par_got_n = _par_got_n + 1;
}

# Appends a text result (`s:`) to the got list.
fn _par_got_s(p, len) {
    var at = _par_got_n * 8;
    store64(_par_got_k + at, 115);
    store64(_par_got_v + at, p);
    store64(_par_got_l + at, len);
    _par_got_n = _par_got_n + 1;
}

# Appends an Option<f64>: the float for Some, `n:` for None.
fn _par_got_opt_f(t, v) {
    if (is_some(t) == 1) { _par_got_f(v); } else { _par_got_none(); }
}

# Appends a nucleus word as its golden tokens, `i:Z i:A`.
fn _par_got_nuc(p) {
    _par_got_i(nucleus_z(p));
    _par_got_i(nucleus_a(p));
}

# `nucleus` rows: src/nucleus.cyr and src/shell_model.cyr. A nucleus input is `i:Z i:A`.
fn _par_nucleus(fp, fl): i64 {
    if (_par_eq(fp, fl, "Nucleus::hydrogen_1") == 1) { _par_got_nuc(nucleus_hydrogen_1()); return 1; }
    if (_par_eq(fp, fl, "Nucleus::helium_4") == 1) { _par_got_nuc(nucleus_helium_4()); return 1; }
    if (_par_eq(fp, fl, "Nucleus::carbon_12") == 1) { _par_got_nuc(nucleus_carbon_12()); return 1; }
    if (_par_eq(fp, fl, "Nucleus::iron_56") == 1) { _par_got_nuc(nucleus_iron_56()); return 1; }
    if (_par_eq(fp, fl, "Nucleus::uranium_235") == 1) { _par_got_nuc(nucleus_uranium_235()); return 1; }
    if (_par_eq(fp, fl, "Nucleus::uranium_238") == 1) { _par_got_nuc(nucleus_uranium_238()); return 1; }
    if (_par_eq(fp, fl, "superallowed_ft_values") == 1) {
        var cnt = superallowed_ft_value_count();
        _par_got_seq(cnt);
        var k = 0;
        while (k < cnt) {
            var d = superallowed_ft_value(k);
            _par_got_i(nucleus_z(d.parent));
            _par_got_i(nucleus_a(d.parent));
            _par_got_i(nucleus_z(d.daughter));
            _par_got_i(nucleus_a(d.daughter));
            _par_got_f(d.ft_seconds);
            k = k + 1;
        }
        return 1;
    }
    if (_par_eq(fp, fl, "superallowed_average_ft") == 1) {
        var ft, unc = superallowed_average_ft();
        _par_got_f(ft);
        _par_got_f(unc);
        return 1;
    }
    if (_par_eq(fp, fl, "shell_model_levels") == 1) {
        var cnt = shell_model_level_count();
        _par_got_seq(cnt);
        var k = 0;
        while (k < cnt) {
            var lv = shell_model_level(k);
            _par_got_i(shell_level_n_shell(lv));
            _par_got_i(shell_level_l(lv));
            _par_got_i(shell_level_two_j(lv));
            k = k + 1;
        }
        return 1;
    }
    var x = _par_in(0);
    if (_par_eq(fp, fl, "is_magic_number") == 1) { _par_got_i(is_magic_number(x)); return 1; }
    if (_par_eq(fp, fl, "shell_closure_below") == 1) { _par_got_i(shell_closure_below(x)); return 1; }
    if (_par_eq(fp, fl, "next_shell_closure") == 1) {
        var t, v = next_shell_closure(x);
        if (is_some(t) == 1) { _par_got_i(v); } else { _par_got_none(); }
        return 1;
    }
    if (_par_eq(fp, fl, "shell_occupation") == 1) {
        var lvs[256];
        var occ[256];
        var cnt = shell_occupation(x, &lvs, &occ, 32);
        _par_got_seq(cnt);
        var k = 0;
        while (k < cnt) {
            var lv = load64(&lvs + k * 8);
            _par_got_i(shell_level_n_shell(lv));
            _par_got_i(shell_level_l(lv));
            _par_got_i(shell_level_two_j(lv));
            _par_got_i(load64(&occ + k * 8));
            k = k + 1;
        }
        return 1;
    }
    var y = _par_in(1);
    if (_par_eq(fp, fl, "Nucleus::new") == 1) {
        var t, v = nucleus_new(x, y);
        if (is_ok(t) == 1) { _par_got_i(nucleus_z(v)); _par_got_i(nucleus_a(v)); }
        else { _par_got_err(v); }
        return 1;
    }
    if (_par_in_n == 3) {
        var lv = shell_level_new(x, y, _par_in(2));
        if (_par_eq(fp, fl, "ShellLevel::degeneracy") == 1) { _par_got_i(shell_level_degeneracy(lv)); return 1; }
        if (_par_eq(fp, fl, "ShellLevel::j") == 1) { _par_got_f(shell_level_j(lv)); return 1; }
        if (_par_eq(fp, fl, "ShellLevel::label") == 1) {
            var lab = shell_level_label(lv);
            _par_got_s(str_data(lab), str_len(lab));
            return 1;
        }
        return 0;
    }
    if (_par_eq(fp, fl, "SuperallowedDecay::corrected_ft_seconds") == 1) {
        var sd: TmSuperallowedDecay;
        sd.parent = _tm_nuc(x, y);
        sd.daughter = _tm_nuc(_par_in(2), _par_in(3));
        var ftv: f64 = _par_in(4);
        sd.ft_seconds = ftv;
        var t, v = sd.corrected_ft_seconds();
        _par_got_opt_f(t, v);
        return 1;
    }
    var n = _tm_nuc(x, y);
    if (_par_eq(fp, fl, "Nucleus::binding_energy") == 1) { _par_got_f(nucleus_binding_energy(n)); return 1; }
    if (_par_eq(fp, fl, "Nucleus::binding_energy_shell_corrected") == 1) {
        _par_got_f(nucleus_binding_energy_shell_corrected(n));
        return 1;
    }
    if (_par_eq(fp, fl, "ground_state_spin_parity") == 1) {
        var tj, par = ground_state_spin_parity(n);
        _par_got_i(tj);
        _par_got_i(par);
        return 1;
    }
    if (_par_eq(fp, fl, "Nucleus::z") == 1) { _par_got_i(nucleus_z(n)); return 1; }
    if (_par_eq(fp, fl, "Nucleus::a") == 1) { _par_got_i(nucleus_a(n)); return 1; }
    if (_par_eq(fp, fl, "Nucleus::n") == 1) { _par_got_i(nucleus_n(n)); return 1; }
    if (_par_eq(fp, fl, "Nucleus::binding_energy_per_nucleon") == 1) {
        _par_got_f(nucleus_binding_energy_per_nucleon(n));
        return 1;
    }
    if (_par_eq(fp, fl, "Nucleus::mass_defect") == 1) { _par_got_f(nucleus_mass_defect(n)); return 1; }
    if (_par_eq(fp, fl, "Nucleus::nuclear_mass") == 1) { _par_got_f(nucleus_nuclear_mass(n)); return 1; }
    if (_par_eq(fp, fl, "Nucleus::atomic_mass_amu") == 1) { _par_got_f(nucleus_atomic_mass_amu(n)); return 1; }
    if (_par_eq(fp, fl, "Nucleus::nuclear_mass_amu") == 1) { _par_got_f(nucleus_nuclear_mass_amu(n)); return 1; }
    if (_par_eq(fp, fl, "Nucleus::nuclear_radius") == 1) { _par_got_f(nucleus_nuclear_radius(n)); return 1; }
    if (_par_eq(fp, fl, "Nucleus::is_magic") == 1) { _par_got_i(nucleus_is_magic(n)); return 1; }
    if (_par_eq(fp, fl, "Nucleus::is_doubly_magic") == 1) { _par_got_i(nucleus_is_doubly_magic(n)); return 1; }
    if (_par_eq(fp, fl, "Nucleus::experimental_mass_excess_kev") == 1) {
        var t, v = nucleus_experimental_mass_excess_kev(n);
        _par_got_opt_f(t, v);
        return 1;
    }
    if (_par_eq(fp, fl, "Nucleus::experimental_atomic_mass_amu") == 1) {
        var t, v = nucleus_experimental_atomic_mass_amu(n);
        _par_got_opt_f(t, v);
        return 1;
    }
    if (_par_eq(fp, fl, "Nucleus::charge_radius_fm") == 1) {
        var t, v = nucleus_charge_radius_fm(n);
        _par_got_opt_f(t, v);
        return 1;
    }
    if (_par_eq(fp, fl, "Nucleus::nuclear_moments") == 1) {
        var mom: TmNuclearMoments;
        if (nucleus_nuclear_moments(n, &mom) == 1) {
            _par_got_f(mom.magnetic_dipole_mu_n);
            _par_got_f(mom.electric_quadrupole_barn);
        } else {
            _par_got_none();
        }
        return 1;
    }
    return 0;
}

# A TmDecayMode value's golden name ("DecayMode.Alpha").
#must_use
fn _par_decay_mode_name(m): i64 {
    if (m == TM_DECAY_MODE_ALPHA) { return "DecayMode.Alpha"; }
    if (m == TM_DECAY_MODE_BETA_MINUS) { return "DecayMode.BetaMinus"; }
    if (m == TM_DECAY_MODE_BETA_PLUS) { return "DecayMode.BetaPlus"; }
    if (m == TM_DECAY_MODE_ELECTRON_CAPTURE) { return "DecayMode.ElectronCapture"; }
    if (m == TM_DECAY_MODE_GAMMA) { return "DecayMode.Gamma"; }
    if (m == TM_DECAY_MODE_SPONTANEOUS_FISSION) { return "DecayMode.SpontaneousFission"; }
    if (m == TM_DECAY_MODE_PROTON_EMISSION) { return "DecayMode.ProtonEmission"; }
    if (m == TM_DECAY_MODE_NEUTRON_EMISSION) { return "DecayMode.NeutronEmission"; }
    if (m == TM_DECAY_MODE_ISOMERIC_TRANSITION) { return "DecayMode.IsomericTransition"; }
    return "DecayMode.?";
}

# Appends a Result<f64>: the float for Ok, `E:` for Err.
fn _par_got_res_f(t, v) {
    if (is_ok(t) == 1) { _par_got_f(v); } else { _par_got_err(v); }
}

# Appends a Result<Nucleus>: `i:Z i:A` for Ok, `E:` for Err.
fn _par_got_res_n(t, v) {
    if (is_ok(t) == 1) { _par_got_nuc(v); } else { _par_got_err(v); }
}

# `decay` rows: src/decay.cyr.
fn _par_decay(fp, fl): i64 {
    if (_par_eq(fp, fl, "known_isotopes") == 1) { _par_got_seq(known_isotope_count()); return 1; }
    if (_par_eq(fp, fl, "known_isotopes[]") == 1) {
        var iso = known_isotope(_par_in(0));
        _par_got_nuc(iso.nucleus);
        _par_got_s(iso.name, strlen(iso.name));
        _par_got_f(iso.half_life_seconds);
        _par_got_e(_par_decay_mode_name(iso.primary_decay));
        _par_got_i(iso.is_isomer);
        _par_got_f(iso.excitation_energy_kev);
        return 1;
    }
    if (_par_eq(fp, fl, "bateman_chain") == 1) {
        var n = _par_in(0);
        var lam = alloc(n * 8 + 8);
        var pops = alloc(n * 8 + 8);
        var k = 0;
        while (k < n) { store64(lam + k * 8, _par_in(1 + k)); k = k + 1; }
        var n0: f64 = _par_in(1 + n);
        var t: f64 = _par_in(2 + n);
        var got = bateman_chain(lam, n, n0, t, pops);
        if (got < 0) { return 0 - 1; }
        _par_got_seq(got);
        k = 0;
        while (k < got) { _par_got_f(load64(pops + k * 8)); k = k + 1; }
        return 1;
    }
    var a: f64 = _par_in(0);
    var b: f64 = _par_in(1);
    if (_par_eq(fp, fl, "decay_constant") == 1) { var t, v = decay_constant(a); _par_got_res_f(t, v); return 1; }
    if (_par_eq(fp, fl, "activity_bq") == 1) { var t, v = activity_bq(a, b); _par_got_res_f(t, v); return 1; }
    if (_par_eq(fp, fl, "remaining_fraction") == 1) { _par_got_f(remaining_fraction(a, b)); return 1; }
    var nuc = _tm_nuc(_par_in(0), _par_in(1));
    if (_par_eq(fp, fl, "alpha_decay") == 1) { var t, v = alpha_decay(nuc); _par_got_res_n(t, v); return 1; }
    if (_par_eq(fp, fl, "beta_minus_decay") == 1) { var t, v = beta_minus_decay(nuc); _par_got_res_n(t, v); return 1; }
    if (_par_eq(fp, fl, "beta_plus_decay") == 1) { var t, v = beta_plus_decay(nuc); _par_got_res_n(t, v); return 1; }
    if (_par_eq(fp, fl, "decay_chain") == 1) {
        var ns[512];
        var ms[512];
        var cnt = decay_chain(nuc, _par_in(2), &ns, &ms, 64);
        _par_got_seq(cnt);
        var k2 = 0;
        while (k2 < cnt && k2 < 64) {
            _par_got_nuc(load64(&ns + k2 * 8));
            _par_got_e(_par_decay_mode_name(load64(&ms + k2 * 8)));
            k2 = k2 + 1;
        }
        return 1;
    }
    return 0;
}

# Routes a row to its module's dispatcher. 0 (pending) for a module with none yet.
fn _par_dispatch(mp, ml, fp, fl): i64 {
    _par_got_n = 0;
    if (_par_eq(mp, ml, "constants") == 1) { return _par_constants(fp, fl); }
    if (_par_eq(mp, ml, "libm") == 1) { return _par_libm(fp, fl); }
    if (_par_eq(mp, ml, "particle") == 1) { return _par_particle(fp, fl); }
    if (_par_eq(mp, ml, "relativity") == 1) { return _par_relativity(fp, fl); }
    if (_par_eq(mp, ml, "nucleus") == 1) { return _par_nucleus(fp, fl); }
    if (_par_eq(mp, ml, "decay") == 1) { return _par_decay(fp, fl); }
    return 0;
}

# The class-C bound for a function, in ulps; -1 when none is set yet (the rows are measured).
# The derivation is in docs/development/port-parity.md. Set a function's bound BEFORE its
# first comparison, from that evidence, and never raise it to make a row pass.
#
# The libm primitives get 2 ulp: each side documents < 1 ulp (Cyrius lib/math.cyr, ganita,
# fdlibm in Rust libm), so two implementations can differ by up to 2. That holds on x86_64
# ELF, x86_64 PE and aarch64, measured 2026-11-08 (max 1 ulp). hypot is no longer class C:
# its rows go to the port's bit-exact _tm_hypot and are class A.
#must_use
fn _par_c_bound(fp, fl): i64 {
    if (_par_eq(fp, fl, "libm::sin") == 1) { return 2; }
    if (_par_eq(fp, fl, "libm::cos") == 1) { return 2; }
    if (_par_eq(fp, fl, "libm::tan") == 1) { return 2; }
    if (_par_eq(fp, fl, "libm::exp") == 1) { return 2; }
    if (_par_eq(fp, fl, "libm::log") == 1) { return 2; }
    if (_par_eq(fp, fl, "libm::sinh") == 1) { return 2; }
    if (_par_eq(fp, fl, "libm::pow") == 1) { return 2; }
    # M2, by the port-parity rule: S = 0 (pow results nudged ±1 ulp on all 2,053 golden rows), 2 calls.
    if (_par_eq(fp, fl, "Nucleus::atomic_mass_amu") == 1) { return 2; }
    # M2: the output is the pow result itself, so S = 1 with 1 call: K = 2·1·1 + 2.
    if (_par_eq(fp, fl, "remaining_fraction") == 1) { return 4; }
    return 0 - 1;
}

# 1 if the row (function and raw input field) is a divergence an ADR accepts. Each entry
# names its ADR. An accepted row is reported on every run and doesn't fail its module.
#must_use
fn _par_accepted(fp, fl, ip, il): i64 {
    # ADR 0007: ganita pow(-1, |y| > 2^64) gives +inf / +0 instead of 1 (filed upstream).
    if (_par_eq(fp, fl, "libm::pow") == 1 && _par_eq(ip, il, "f:bff0000000000000 f:7fefffffffffffff") == 1) {
        return 7;
    }
    return 0;
}

# ── per-function statistics ─────────────────────────────────────────────────────────
# One slot per distinct fn name in the current module: name, class, row counts and an ulp
# histogram over the float outputs (0, 1, 2, 3–16, >16, NaN/inf mismatch).
var _PAR_FN_MAX = 96;
var _par_fn_p = 0;
var _par_fn_l = 0;
var _par_fn_cls = 0;
var _par_fn_rows = 0;
var _par_fn_ok = 0;
var _par_fn_fail = 0;
var _par_fn_meas = 0;
var _par_fn_pend = 0;
var _par_fn_acc = 0;
var _par_fn_h = 0;    # 6 buckets per fn
var _par_fn_max = 0;
var _par_fn_n = 0;

# The stats slot for fn [fp, fp + fl), created on first sight; -1 when the table is full.
fn _par_fn_slot(fp, fl, cls): i64 {
    var k = 0;
    while (k < _par_fn_n) {
        var at = k * 8;
        if (load64(_par_fn_l + at) == fl && memeq(load64(_par_fn_p + at), fp, fl) == 1) { return k; }
        k = k + 1;
    }
    if (_par_fn_n >= _PAR_FN_MAX) { return 0 - 1; }
    var at = _par_fn_n * 8;
    store64(_par_fn_p + at, fp);
    store64(_par_fn_l + at, fl);
    store64(_par_fn_cls + at, cls);
    store64(_par_fn_rows + at, 0);
    store64(_par_fn_ok + at, 0);
    store64(_par_fn_fail + at, 0);
    store64(_par_fn_meas + at, 0);
    store64(_par_fn_pend + at, 0);
    store64(_par_fn_acc + at, 0);
    store64(_par_fn_max + at, 0);
    var b = 0;
    while (b < 6) { store64(_par_fn_h + (_par_fn_n * 6 + b) * 8, 0); b = b + 1; }
    _par_fn_n = _par_fn_n + 1;
    return _par_fn_n - 1;
}

# Adds 1 to the i64 counter at `base + slot * 8`.
fn _par_bump(base, slot) {
    store64(base + slot * 8, load64(base + slot * 8) + 1);
}

# Records one float comparison's ulp distance in the slot's histogram and maximum.
fn _par_hist(slot, d) {
    var b = 5;
    if (d == 0) { b = 0; }
    elif (d == 1) { b = 1; }
    elif (d == 2) { b = 2; }
    elif (d <= 16) { b = 3; }
    elif (d < 0x7FFFFFFFFFFFFFFF) { b = 4; }
    _par_bump(_par_fn_h, slot * 6 + b);
    if (d > load64(_par_fn_max + slot * 8)) { store64(_par_fn_max + slot * 8, d); }
}

# ── row comparison ──────────────────────────────────────────────────────────────────
# Compares the got list with the wanted outputs under class `cls` ('A' 'B' 'C' 'D').
# Returns 1 ok, 0 failed, 2 measured (class C with no bound yet). Sets _par_outlier when a
# float is more than 16 ulp off, or a NaN / infinity disagrees.
var _par_outlier = 0;
fn _par_compare(slot, cls, fp, fl): i64 {
    _par_outlier = 0;
    if (_par_got_n != _par_want_n) { return 0; }
    var result = 1;
    var k = 0;
    while (k < _par_want_n) {
        var at = k * 8;
        var wk = load64(_par_want_k + at);
        var wv = load64(_par_want_v + at);
        var wl = load64(_par_want_l + at);
        var gk = load64(_par_got_k + at);
        var gv = load64(_par_got_v + at);
        var gl = load64(_par_got_l + at);
        if (wk != gk) { return 0; }
        if (wk == 102) {
            var d = ulp_distance(gv, wv);
            _par_hist(slot, d);
            if (d > 16) { _par_outlier = 1; }
            if (cls == 65) {
                if (ulp_bits_match(gv, wv) != 1) { result = 0; }
            } elif (cls == 66) {
                if (d > 2) { result = 0; }
            } elif (cls == 67) {
                var bound = _par_c_bound(fp, fl);
                if (bound < 0) {
                    if (result == 1) { result = 2; }
                } elif (d > bound) {
                    result = 0;
                }
            } else {
                if (ulp_rel_match(gv, wv, 0.000000000001) != 1) { result = 0; }
            }
        } elif (wk == 105 || wk == 118) {
            if (gv != wv) { result = 0; }
        } elif (wk != 110) {
            if (gl != wl || memeq(gv, wv, wl) != 1) { result = 0; }
        }
        k = k + 1;
    }
    return result;
}

# ── report ──────────────────────────────────────────────────────────────────────────

# Prints `n` right-aligned in a field of `width`.
fn _par_print_num(n, width) {
    var digits = 1;
    var t = n;
    while (t >= 10) { t = t / 10; digits = digits + 1; }
    while (digits < width) { print(" ", 1); digits = digits + 1; }
    fmt_int(n);
}

# Prints the text [p, p + len) padded to `width`.
fn _par_print_pad(p, len, width) {
    print(p, len);
    var k = len;
    while (k < width) { print(" ", 1); k = k + 1; }
}

# One line per function of the current module.
fn _par_report_fns() {
    var k = 0;
    while (k < _par_fn_n) {
        var at = k * 8;
        print("  ", 2);
        _par_print_pad(load64(_par_fn_p + at), load64(_par_fn_l + at), 40);
        var cls = load64(_par_fn_cls + at);
        var cb[8];
        store8(&cb, cls);
        print(&cb, 1);
        _par_print_num(load64(_par_fn_rows + at), 7);
        print(" rows: ", 7);
        fmt_int(load64(_par_fn_ok + at));
        print(" ok", 3);
        var f = load64(_par_fn_fail + at);
        if (f > 0) { print(", ", 2); fmt_int(f); print(" FAILED", 7); }
        var m = load64(_par_fn_meas + at);
        if (m > 0) { print(", ", 2); fmt_int(m); print(" measured", 9); }
        var p = load64(_par_fn_pend + at);
        if (p > 0) { print(", ", 2); fmt_int(p); print(" pending", 8); }
        var acc = load64(_par_fn_acc + at);
        if (acc > 0) { print(", ", 2); fmt_int(acc); print(" accepted", 9); }
        var hb = k * 6;
        var floats = 0;
        var b = 0;
        while (b < 6) { floats = floats + load64(_par_fn_h + (hb + b) * 8); b = b + 1; }
        if (floats > 0) {
            print("  | ulp 0:", 10);
            fmt_int(load64(_par_fn_h + hb * 8));
            print(" 1:", 3);
            fmt_int(load64(_par_fn_h + (hb + 1) * 8));
            print(" 2:", 3);
            fmt_int(load64(_par_fn_h + (hb + 2) * 8));
            print(" 3-16:", 6);
            fmt_int(load64(_par_fn_h + (hb + 3) * 8));
            print(" >16:", 5);
            fmt_int(load64(_par_fn_h + (hb + 4) * 8));
            print(" nan/inf:", 9);
            fmt_int(load64(_par_fn_h + (hb + 5) * 8));
            var mx = load64(_par_fn_max + at);
            if (mx < 0x7FFFFFFFFFFFFFFF) { print(" max:", 5); fmt_int(mx); }
        }
        println("");
        k = k + 1;
    }
}

# ── driver ──────────────────────────────────────────────────────────────────────────
var _par_rows_ok = 0;
var _par_rows_fail = 0;
var _par_rows_meas = 0;
var _par_rows_pend = 0;
var _par_rows_acc = 0;

# The index of the next byte `c` in [p + at, p + end), or `end`.
#must_use
fn _par_find(p, at, end, c): i64 {
    var k = at;
    while (k < end && load8(p + k) != c) { k = k + 1; }
    return k;
}

# Replays one module. Returns 1 if it has a failure (or can't be read), else 0.
fn _par_module(mp, ml): i64 {
    var path[128];
    var pre = "tests/golden/";
    var pl = strlen(pre);
    if (pl + ml + 5 > 127) { return 1; }
    memcpy(&path, pre, pl);
    memcpy(&path + pl, mp, ml);
    memcpy(&path + pl + ml, ".tsv", 4);
    store8(&path + pl + ml + 4, 0);

    var lenw[8];
    var buf = file_read_whole(&path, &lenw);
    var len = load64(&lenw);
    print("=== parity: ", 12);
    print(mp, ml);
    if (buf == 0) { println(" — cannot read the golden file"); return 1; }
    println(" ===");

    _par_fn_n = 0;
    var fails_shown = 0;
    var outliers_shown = 0;
    var mod_fail = 0;
    var line = 0;
    while (line < len) {
        var eol = _par_find(buf, line, len, 10);
        if (eol > line && load8(buf + line) != 35) {
            # fn <TAB> class <TAB> inputs <TAB> outputs <TAB> note
            var t1 = _par_find(buf, line, eol, 9);
            var t2 = _par_find(buf, t1 + 1, eol, 9);
            var t3 = _par_find(buf, t2 + 1, eol, 9);
            var t4 = _par_find(buf, t3 + 1, eol, 9);
            var fp = buf + line;
            var fl = t1 - line;
            var cls = load8(buf + t1 + 1);
            var bad = 0;
            if (t4 >= eol || t2 != t1 + 2) { bad = 1; }
            if (bad == 0) {
                _par_in_n = _par_tokens(buf + t2 + 1, t3 - t2 - 1, _par_in_k, _par_in_v, _par_in_l);
                _par_want_n = _par_tokens(buf + t3 + 1, t4 - t3 - 1, _par_want_k, _par_want_v, _par_want_l);
                if (_par_in_n < 0 || _par_want_n < 0) { bad = 1; }
            }
            var slot = _par_fn_slot(fp, fl, cls);
            if (slot < 0) { println("  too many functions in one module"); return 1; }
            _par_bump(_par_fn_rows, slot);
            var outcome = 0;
            if (bad == 0) {
                var h = _par_dispatch(mp, ml, fp, fl);
                if (h == 0) { outcome = 3; }
                elif (h == 1) { outcome = _par_compare(slot, cls, fp, fl); }
            }
            if (outcome == 1) { _par_bump(_par_fn_ok, slot); _par_rows_ok = _par_rows_ok + 1; }
            elif (outcome == 2) {
                _par_bump(_par_fn_meas, slot);
                _par_rows_meas = _par_rows_meas + 1;
                if (_par_outlier == 1 && outliers_shown < 10) {
                    print("  OUTLIER (measured, not gated): ", 33);
                    print(buf + t4 + 1, eol - t4 - 1);
                    println("");
                    ulp_print_pair(load64(_par_got_v), load64(_par_want_v));
                    outliers_shown = outliers_shown + 1;
                }
            }
            elif (outcome == 3) { _par_bump(_par_fn_pend, slot); _par_rows_pend = _par_rows_pend + 1; }
            elif (bad == 0 && _par_accepted(fp, fl, buf + t2 + 1, t3 - t2 - 1) > 0) {
                _par_bump(_par_fn_acc, slot);
                _par_rows_acc = _par_rows_acc + 1;
                print("  accepted (ADR ", 16);
                fmt_int(_par_accepted(fp, fl, buf + t2 + 1, t3 - t2 - 1));
                print("): ", 3);
                print(buf + t4 + 1, eol - t4 - 1);
                println("");
                ulp_print_pair(load64(_par_got_v), load64(_par_want_v));
            }
            else {
                _par_bump(_par_fn_fail, slot);
                _par_rows_fail = _par_rows_fail + 1;
                mod_fail = 1;
                if (fails_shown < 10) {
                    eprint("  FAIL: ", 8);
                    eprint(buf + t4 + 1, eol - t4 - 1);
                    eprint("\n", 1);
                    if (bad == 0 && _par_got_n > 0) {
                        ulp_print_pair(load64(_par_got_v), load64(_par_want_v));
                    }
                    fails_shown = fails_shown + 1;
                }
            }
        }
        line = eol + 1;
    }
    _par_report_fns();
    return mod_fail;
}

# The token and statistics buffers live on the heap: as statics they would push the test
# past the compiler's 128 KiB static-data advisory, and a warning fails the gate.
fn _par_alloc(): i64 {
    _par_in_k = alloc(2048);
    if (_par_in_k == 0) { println("parity: out of memory"); return 1; }
    _par_in_v = alloc(2048);
    if (_par_in_v == 0) { println("parity: out of memory"); return 1; }
    _par_in_l = alloc(2048);
    if (_par_in_l == 0) { println("parity: out of memory"); return 1; }
    _par_want_k = alloc(2048);
    if (_par_want_k == 0) { println("parity: out of memory"); return 1; }
    _par_want_v = alloc(2048);
    if (_par_want_v == 0) { println("parity: out of memory"); return 1; }
    _par_want_l = alloc(2048);
    if (_par_want_l == 0) { println("parity: out of memory"); return 1; }
    _par_got_k = alloc(2048);
    if (_par_got_k == 0) { println("parity: out of memory"); return 1; }
    _par_got_v = alloc(2048);
    if (_par_got_v == 0) { println("parity: out of memory"); return 1; }
    _par_got_l = alloc(2048);
    if (_par_got_l == 0) { println("parity: out of memory"); return 1; }
    _par_fn_p = alloc(768);
    if (_par_fn_p == 0) { println("parity: out of memory"); return 1; }
    _par_fn_l = alloc(768);
    if (_par_fn_l == 0) { println("parity: out of memory"); return 1; }
    _par_fn_cls = alloc(768);
    if (_par_fn_cls == 0) { println("parity: out of memory"); return 1; }
    _par_fn_rows = alloc(768);
    if (_par_fn_rows == 0) { println("parity: out of memory"); return 1; }
    _par_fn_ok = alloc(768);
    if (_par_fn_ok == 0) { println("parity: out of memory"); return 1; }
    _par_fn_fail = alloc(768);
    if (_par_fn_fail == 0) { println("parity: out of memory"); return 1; }
    _par_fn_meas = alloc(768);
    if (_par_fn_meas == 0) { println("parity: out of memory"); return 1; }
    _par_fn_pend = alloc(768);
    if (_par_fn_pend == 0) { println("parity: out of memory"); return 1; }
    _par_fn_acc = alloc(768);
    if (_par_fn_acc == 0) { println("parity: out of memory"); return 1; }
    _par_fn_h = alloc(4608);
    if (_par_fn_h == 0) { println("parity: out of memory"); return 1; }
    _par_fn_max = alloc(768);
    if (_par_fn_max == 0) { println("parity: out of memory"); return 1; }
    return 0;
}

# Replays every module in tests/golden/modules.txt and prints the summary. Returns the number
# of modules with a failure.
fn main(): i64 {
    if (_par_alloc() != 0) { return 1; }
    var lenw[8];
    var idx = file_read_whole("tests/golden/modules.txt", &lenw);
    if (idx == 0) { println("parity: cannot read tests/golden/modules.txt"); return 1; }
    var len = load64(&lenw);
    var failing = 0;
    var modules = 0;
    var line = 0;
    while (line < len) {
        var eol = _par_find(idx, line, len, 10);
        if (eol > line && load8(idx + line) != 35) {
            failing = failing + _par_module(idx + line, eol - line);
            modules = modules + 1;
        }
        line = eol + 1;
    }
    print("=== parity summary: ", 20);
    fmt_int(modules);
    print(" modules, ", 10);
    fmt_int(failing);
    print(" failing | rows: ", 17);
    fmt_int(_par_rows_ok);
    print(" ok, ", 5);
    fmt_int(_par_rows_fail);
    print(" failed, ", 9);
    fmt_int(_par_rows_meas);
    print(" measured, ", 11);
    fmt_int(_par_rows_pend);
    print(" pending, ", 10);
    fmt_int(_par_rows_acc);
    println(" accepted ===");
    return failing;
}

var exit_code = main();
sys_exit_group(exit_code);
