    TM_ELECTRON_AFFINITY_BOUND,  # Li (Z=3) AHH99
    TM_ELECTRON_AFFINITY_UNBOUND,  # Be (Z=4) AHH99 <0
    TM_ELECTRON_AFFINITY_BOUND,  # B (Z=5) AHH99
    TM_ELECTRON_AFFINITY_BOUND,  # C (Z=6) Bresteau 2016 (AHH99 1.262118(20))
    TM_ELECTRON_AFFINITY_UNBOUND,  # N (Z=7) AHH99 -0.07(2)
    TM_ELECTRON_AFFINITY_BOUND,  # O (Z=8) Kristiansson 2022
