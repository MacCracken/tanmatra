# tanmatra — atomic data: orbital types, filling order, exceptions, ionization energies, affinities, Bethe logs
#
# GENERATED by scripts/oracle from tanmatra 1.3.0 (rust-old/), libm 0.2.16. Do not edit.
# Regenerate: cargo run --release --locked --manifest-path scripts/oracle/Cargo.toml
#
# The tables come from the oracle's public API, except three private ones. The filling order and
# the Bethe logarithms are extracted from rust-old/src/atomic.rs; the 20 NIST exceptions are derived
# from electron_configuration. All three are proven against the oracle before this file is written
# (scripts/oracle/src/t_atomic.rs). tests/golden/atomic.tsv pins every use.

# Orbital angular momentum quantum number types.
enum TmOrbitalType {
    TM_ORBITAL_TYPE_S = 0;
    TM_ORBITAL_TYPE_P = 1;
    TM_ORBITAL_TYPE_D = 2;
    TM_ORBITAL_TYPE_F = 3;
}
const TM_ORBITAL_TYPE_COUNT = 4;

# Result of checking electric dipole selection rules for a transition.
enum TmTransitionType {
    TM_TRANSITION_TYPE_ELECTRIC_DIPOLE = 0;
    TM_TRANSITION_TYPE_FORBIDDEN = 1;
}
const TM_TRANSITION_TYPE_COUNT = 2;

# Electron affinity of a neutral atom.
#
# The kind only: Rust's `Bound(f64)` payload is electron_affinity_ev (port plan §5).
enum TmElectronAffinity {
    TM_ELECTRON_AFFINITY_BOUND = 0;
    TM_ELECTRON_AFFINITY_UNBOUND = 1;
    TM_ELECTRON_AFFINITY_UNKNOWN = 2;
}
const TM_ELECTRON_AFFINITY_COUNT = 3;

# Orbital angular momentum l. Indexed by TmOrbitalType; mirrors `OrbitalType::l`.
var TM_ORBITAL_TYPE_L: u8[4] = {
    0,  # S
    1,  # P
    2,  # D
    3,  # F
};

# Subshell capacity 2(2l + 1). Indexed by TmOrbitalType; mirrors `OrbitalType::max_electrons`.
var TM_ORBITAL_TYPE_MAX_ELECTRONS: u8[4] = {
    2,  # S
    6,  # P
    10,  # D
    14,  # F
};

# The letter symbol, as an ASCII code. Indexed by TmOrbitalType; mirrors `OrbitalType::symbol`.
var TM_ORBITAL_TYPE_SYMBOL: u8[4] = {
    115,  # 's'
    112,  # 'p'
    100,  # 'd'
    102,  # 'f'
};

