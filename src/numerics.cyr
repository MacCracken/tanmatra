# numerics.cyr — tanmatra's private floating-point helpers.
#
# Each helper reproduces exactly what the Rust oracle (rust-old/, libm 0.2.16) computes,
# where no Cyrius builtin or ganita function does. Port plan §5 and
# docs/development/port-parity.md.

# π as Rust's core::f64::consts::PI (0x400921FB54442D18). The shortest round-trip decimal.
const _TM_PI = 3.141592653589793;

# +∞ (0x7FF0000000000000), a compile-time constant.
const _TM_INF = 1.0 / 0.0;

# The quiet NaN Rust's f64::NAN is (0x7FF8000000000000). The parity rules match any NaN.
#must_use
fn _tm_nan(): f64 {
    var n: f64 = 0x7FF8000000000000;
    return n;
}

# The bit pattern of an f64, as an integer. The untyped parameter carries the word, and the
# `: i64` return types the caller's binding as an integer. A bare `var u = x;` copy of an
# f64 is f64-typed (6.6.11), so its `<` would be a float compare.
#must_use
fn _tm_bits(x): i64 { return x; }

# 1 if x is +∞ or -∞ (Rust f64::is_infinite).
#must_use
fn _tm_is_inf(x: f64): i64 {
    if ((_tm_bits(x) & 0x7FFFFFFFFFFFFFFF) == 0x7FF0000000000000) { return 1; }
    return 0;
}

# The low part of x², from a Dekker split at 2^27 + 1 (Rust libm hypot.rs `sq`).
#must_use
fn _tm_sq_lo(x: f64): f64 {
    var split: f64 = 134217729.0;
    var xc: f64 = x * split;
    var xh: f64 = (x - xc) + xc;
    var xl: f64 = x - xh;
    var hi: f64 = x * x;
    var lo: f64 = (((xh * xh) - hi) + ((2.0 * xh) * xl)) + (xl * xl);
    return lo;
}

# hypot(x, y) as Rust libm 0.2.16 computes it (musl's algorithm), operation for operation,
# so the result is bit-identical. ganita_f64_hypot is a different algorithm, up to 2 ulp
# away, and `invariant_mass` amplifies that past any bound (port-parity.md).
#must_use
fn _tm_hypot(xa: f64, ya: f64): f64 {
    var ux = _tm_bits(xa) & 0x7FFFFFFFFFFFFFFF;
    var uy = _tm_bits(ya) & 0x7FFFFFFFFFFFFFFF;
    if (ux < uy) { var t = ux; ux = uy; uy = t; }
    var ex = ux >> 52;
    var ey = uy >> 52;
    var x: f64 = ux;
    var y: f64 = uy;
    if (ey == 0x7FF) { return y; }
    if (ex == 0x7FF || uy == 0) { return x; }
    if (ex - ey > 64) { var s: f64 = x + y; return s; }
    var z: f64 = 1.0;
    var up: f64 = 0x6BB0000000000000;
    var dn: f64 = 0x1430000000000000;
    if (ex > 0x3FF + 510) { z = up; x = x * dn; y = y * dn; }
    elif (ey < 0x3FF - 450) { z = dn; x = x * up; y = y * up; }
    var hx: f64 = x * x;
    var lx: f64 = _tm_sq_lo(x);
    var hy: f64 = y * y;
    var ly: f64 = _tm_sq_lo(y);
    var sum: f64 = ((ly + lx) + hy) + hx;
    var r: f64 = z * f64_sqrt(sum);
    return r;
}

# ln 2 as Rust's core::f64::consts::LN_2 (0x3FE62E42FEFA39EF). The shortest round-trip decimal.
const _TM_LN2 = 0.6931471805599453;

# 1 if x is finite: neither ±∞ nor NaN (Rust f64::is_finite).
#must_use
fn _tm_is_finite(x: f64): i64 {
    if ((_tm_bits(x) & 0x7FF0000000000000) == 0x7FF0000000000000) { return 0; }
    return 1;
}

# x · 2^n as Rust libm 0.2.16's ldexp (its generic scalbn), operation for operation. Out of
# range n prescales by 2^1023, or by 2^-969 (2^-1022 · 2^53), at most twice, so the final scale
# 2^n is representable and the subnormal range rounds once. The final scale is built from bits.
#must_use
fn _tm_ldexp(x: f64, n): f64 {
    var y: f64 = x;
    var k = n;
    var big: f64 = 0x7FE0000000000000;
    var small: f64 = 0x0360000000000000;
    if (k > 1023) {
        y = y * big;
        k = k - 1023;
        if (k > 1023) {
            y = y * big;
            k = k - 1023;
            if (k > 1023) { k = 1023; }
        }
    } elif (k < 0 - 1022) {
        y = y * small;
        k = k + 969;
        if (k < 0 - 1022) {
            y = y * small;
            k = k + 969;
            if (k < 0 - 1022) { k = 0 - 1022; }
        }
    }
    var scale_bits = (1023 + k) << 52;
    var scale: f64 = scale_bits;
    var r: f64 = y * scale;
    return r;
}

# round(x), halves away from zero, as Rust libm 0.2.16 computes it (its generic round):
# trunc(x + copysign(0.5 − 0.25·ε, x)), where 0.5 − 0.25·ε is 0x3FDFFFFFFFFFFFFF, the double
# just below ½. Cyrius f64_round rounds halves to even, so it can't stand in.
#must_use
fn _tm_round_half_away(x: f64): f64 {
    var h: f64 = 0.49999999999999994;
    if (_tm_bits(x) < 0) { h = -h; }
    var r: f64 = f64_trunc(x + h);
    return r;
}

# x as i64 with Rust's `as` semantics: truncation toward zero, NaN → 0, and saturation at
# i64::MIN / i64::MAX.
#must_use
fn _tm_f64_to_i64_sat(x: f64): i64 {
    if (x != x) { return 0; }
    if (x >= 9223372036854775808.0) { return 0x7FFFFFFFFFFFFFFF; }
    if (x < -9223372036854775808.0) { return 0x8000000000000000; }
    return f64_to(x);
}

# ── log, sin and cos as Rust libm 0.2.16 computes them (M4) ───────────────────────────
#
# Transcribed operation for operation from libm-0.2.16/src/math/{log,sin,cos,k_sin,k_cos,
# rem_pio2}.rs, so the results are bit-identical on every target, which the port-parity rule
# requires for the ill-conditioned scattering and moderation formulas (port-parity.md, M4).
# f64_ln is x87 on x86_64 and fdlibm's branchy e_log.c on aarch64, while Rust's log is musl's
# single-expression form. f64_sin and f64_cos share Rust's kernels, but their argument reduction
# skips Rust's |x| ≤ 9π/4 fast paths. The coefficients are the Rust source's hex comments.

# ln(x): x = 2^k (1 + f) with √2/2 ≤ 1 + f < √2, then log(1 + f) from s = f/(2 + f) and a
# degree-14 Remez polynomial in s (fdlibm e_log.c, musl's form).
#must_use
fn _tm_log(xa: f64): f64 {
    var x: f64 = xa;
    var ui = _tm_bits(x);
    var hx = (ui >> 32) & 0xFFFFFFFF;
    var k = 0;
    if (hx < 0x00100000 || (hx >> 31) != 0) {
        if ((ui << 1) == 0) {
            var m1: f64 = -1.0;
            var ninf: f64 = m1 / (x * x);   # log(±0) = −∞
            return ninf;
        }
        if ((hx >> 31) != 0) {
            var nan: f64 = (x - x) / 0.0;   # log(negative) = NaN
            return nan;
        }
        k = 0 - 54;                         # subnormal: scale by 2^54
        var p54: f64 = 0x4350000000000000;
        x = x * p54;
        ui = _tm_bits(x);
        hx = (ui >> 32) & 0xFFFFFFFF;
    } elif (hx >= 0x7FF00000) {
        return x;
    } elif (hx == 0x3FF00000 && (ui << 32) == 0) {
        return 0.0;
    }
    hx = hx + (0x3FF00000 - 0x3FE6A09E);
    k = k + ((hx >> 20) - 0x3FF);
    hx = (hx & 0x000FFFFF) + 0x3FE6A09E;
    var mb = (hx << 32) | (ui & 0xFFFFFFFF);
    var m: f64 = mb;
    var ln2_hi: f64 = 0x3FE62E42FEE00000;
    var ln2_lo: f64 = 0x3DEA39EF35793C76;
    var lg1: f64 = 0x3FE5555555555593;
    var lg2: f64 = 0x3FD999999997FA04;
    var lg3: f64 = 0x3FD2492494229359;
    var lg4: f64 = 0x3FCC71C51D8E78AF;
    var lg5: f64 = 0x3FC7466496CB03DE;
    var lg6: f64 = 0x3FC39A09D078C69F;
    var lg7: f64 = 0x3FC2F112DF3E5244;
    var f: f64 = m - 1.0;
    var hfsq: f64 = (0.5 * f) * f;
    var s: f64 = f / (2.0 + f);
    var z: f64 = s * s;
    var w: f64 = z * z;
    var t1: f64 = w * (lg2 + (w * (lg4 + (w * lg6))));
    var t2: f64 = z * (lg1 + (w * (lg3 + (w * (lg5 + (w * lg7))))));
    var r: f64 = t2 + t1;
    var dk: f64 = f64_from(k);
    var out: f64 = ((((s * (hfsq + r)) + (dk * ln2_lo)) - hfsq) + f) + (dk * ln2_hi);
    return out;
}

# sin(x + y) for |x| ≤ ~π/4, y the tail of x; iy = 0 when there is no tail (k_sin.rs).
#must_use
fn _tm_k_sin(x: f64, y: f64, iy): f64 {
    var s1: f64 = 0xBFC5555555555549;
    var s2: f64 = 0x3F8111111110F8A6;
    var s3: f64 = 0xBF2A01A019C161D5;
    var s4: f64 = 0x3EC71DE357B1FE7D;
    var s5: f64 = 0xBE5AE5E68A2B9CEB;
    var s6: f64 = 0x3DE5D93A5ACFD57C;
    var z: f64 = x * x;
    var w: f64 = z * z;
    var r: f64 = (s2 + (z * (s3 + (z * s4)))) + ((z * w) * (s5 + (z * s6)));
    var v: f64 = z * x;
    if (iy == 0) {
        var a: f64 = x + (v * (s1 + (z * r)));
        return a;
    }
    var b: f64 = x - (((z * ((0.5 * y) - (v * r))) - y) - (v * s1));
    return b;
}

# cos(x + y) for |x| ≤ ~π/4, y the tail of x (k_cos.rs).
#must_use
fn _tm_k_cos(x: f64, y: f64): f64 {
    var c1: f64 = 0x3FA555555555554C;
    var c2: f64 = 0xBF56C16C16C15177;
    var c3: f64 = 0x3EFA01A019CB1590;
    var c4: f64 = 0xBE927E4F809C52AD;
    var c5: f64 = 0x3E21EE9EBDB4B1C4;
    var c6: f64 = 0xBDA8FAE9BE8838D4;
    var z: f64 = x * x;
    var w: f64 = z * z;
    var r: f64 = (z * (c1 + (z * (c2 + (z * c3))))) + ((w * w) * (c4 + (z * (c5 + (z * c6)))));
    var hz: f64 = 0.5 * z;
    var w2: f64 = 1.0 - hz;
    var c: f64 = w2 + (((1.0 - w2) - hz) + ((z * r) - (x * y)));
    return c;
}

# rem_pio2.rs `medium`: x = n·π/2 + (y0 + y1) by Cody–Waite with π/2 in three 33-bit words,
# the later words used only when the first cancels more than 16 (then 49) bits.
#must_use
fn _tm_rem_pio2_medium(x: f64, ix, yp): i64 {
    var inv_pio2: f64 = 0x3FE45F306DC9C883;
    var to_int: f64 = 0x4338000000000000;
    var pio2_1: f64 = 0x3FF921FB54400000;
    var pio2_1t: f64 = 0x3DD0B4611A626331;
    var pio2_2: f64 = 0x3DD0B4611A600000;
    var pio2_2t: f64 = 0x3BA3198A2E037073;
    var pio2_3: f64 = 0x3BA3198A2E000000;
    var pio2_3t: f64 = 0x397B839A252049C1;
    var tmp: f64 = (x * inv_pio2) + to_int;
    var f_n: f64 = tmp - to_int;
    var n = f64_to(f_n);
    var r: f64 = x - (f_n * pio2_1);
    var w: f64 = f_n * pio2_1t;
    var y0: f64 = r - w;
    var ex = ix >> 20;
    var ey = (_tm_bits(y0) >> 52) & 0x7FF;
    if (ex - ey > 16) {
        var t: f64 = r;
        w = f_n * pio2_2;
        r = t - w;
        w = (f_n * pio2_2t) - ((t - r) - w);
        y0 = r - w;
        ey = (_tm_bits(y0) >> 52) & 0x7FF;
        if (ex - ey > 49) {
            var t3: f64 = r;
            w = f_n * pio2_3;
            r = t3 - w;
            w = (f_n * pio2_3t) - ((t3 - r) - w);
            y0 = r - w;
        }
    }
    var y1: f64 = (r - y0) - w;
    store64(yp, y0);
    store64(yp + 8, y1);
    return n;
}

# One of rem_pio2.rs's direct reductions for |x| ≤ 9π/4: z = x ∓ k·PIO2_1, then the tail.
#must_use
fn _tm_rem_pio2_fast(x: f64, k, yp): i64 {
    var pio2_1: f64 = 0x3FF921FB54400000;
    var pio2_1t: f64 = 0x3DD0B4611A626331;
    var kf: f64 = f64_from(k);
    var h: f64 = kf * pio2_1;
    var t: f64 = kf * pio2_1t;
    if (_tm_bits(x) >= 0) {
        var z: f64 = x - h;
        var y0: f64 = z - t;
        var y1: f64 = (z - y0) - t;
        store64(yp, y0);
        store64(yp + 8, y1);
        return k;
    }
    var zn: f64 = x + h;
    var y0n: f64 = zn + t;
    var y1n: f64 = (zn - y0n) + t;
    store64(yp, y0n);
    store64(yp + 8, y1n);
    return 0 - k;
}

# x = n·π/2 + (y0 + y1) with |y0 + y1| ≤ ~π/4, y0 and y1 written to yp[0], yp[1]; returns n.
# rem_pio2.rs transcribed. Arguments at or past 2^20·π/2 go to the stdlib's Payne–Hanek
# reduction, `_f64_rem_pio2` (lib/math.cyr, FreeBSD k_rem_pio2.c, as Rust's rem_pio2_large is),
# which the libm.tsv rows above 2^20·π/2 pin bit for bit.
#must_use
fn _tm_rem_pio2(x: f64, yp): i64 {
    var ix = (_tm_bits(x) >> 32) & 0x7FFFFFFF;
    if (ix <= 0x400F6A7A) {                          # |x| ~≤ 5π/4
        if ((ix & 0xFFFFF) == 0x921FB) { return _tm_rem_pio2_medium(x, ix, yp); }
        if (ix <= 0x4002D97C) { return _tm_rem_pio2_fast(x, 1, yp); }
        return _tm_rem_pio2_fast(x, 2, yp);
    }
    if (ix <= 0x401C463B) {                          # |x| ~≤ 9π/4
        if (ix <= 0x4015FDBC) {
            if (ix == 0x4012D97C) { return _tm_rem_pio2_medium(x, ix, yp); }
            return _tm_rem_pio2_fast(x, 3, yp);
        }
        if (ix == 0x401921FB) { return _tm_rem_pio2_medium(x, ix, yp); }
        return _tm_rem_pio2_fast(x, 4, yp);
    }
    if (ix < 0x413921FB) { return _tm_rem_pio2_medium(x, ix, yp); }
    return _f64_rem_pio2(x, yp);
}

# sin(x) as Rust libm 0.2.16 computes it, bit for bit (sin.rs).
#must_use
fn _tm_sin(x: f64): f64 {
    var ix = (_tm_bits(x) >> 32) & 0x7FFFFFFF;
    if (ix <= 0x3FE921FB) {
        if (ix < 0x3E500000) { return x; }           # |x| < 2^-26
        var k0: f64 = _tm_k_sin(x, 0.0, 0);
        return k0;
    }
    if (ix >= 0x7FF00000) {
        var nan: f64 = x - x;
        return nan;
    }
    var y: i64[2];
    var n = _tm_rem_pio2(x, &y) & 3;
    var y0: f64 = load64(&y);
    var y1: f64 = load64(&y + 8);
    var r: f64 = 0.0;
    if (n == 0) { r = _tm_k_sin(y0, y1, 1); }
    elif (n == 1) { r = _tm_k_cos(y0, y1); }
    elif (n == 2) {
        var a: f64 = _tm_k_sin(y0, y1, 1);
        r = -a;
    } else {
        var b: f64 = _tm_k_cos(y0, y1);
        r = -b;
    }
    return r;
}

# cos(x) as Rust libm 0.2.16 computes it, bit for bit (cos.rs).
#must_use
fn _tm_cos(x: f64): f64 {
    var ix = (_tm_bits(x) >> 32) & 0x7FFFFFFF;
    if (ix <= 0x3FE921FB) {
        if (ix < 0x3E46A09E) { return 1.0; }         # |x| < 2^-27·√2
        var k0: f64 = _tm_k_cos(x, 0.0);
        return k0;
    }
    if (ix >= 0x7FF00000) {
        var nan: f64 = x - x;
        return nan;
    }
    var y: i64[2];
    var n = _tm_rem_pio2(x, &y) & 3;
    var y0: f64 = load64(&y);
    var y1: f64 = load64(&y + 8);
    var r: f64 = 0.0;
    if (n == 0) { r = _tm_k_cos(y0, y1); }
    elif (n == 1) {
        var a: f64 = _tm_k_sin(y0, y1, 1);
        r = -a;
    } elif (n == 2) {
        var b: f64 = _tm_k_cos(y0, y1);
        r = -b;
    } else {
        r = _tm_k_sin(y0, y1, 1);
    }
    return r;
}
