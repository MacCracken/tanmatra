# The leap-second table is derived from the oracle's leap_seconds_at, and the 1961–1971 segments are
# extracted from rust-old/src/timekeeping.rs. Both are proven against the oracle before this file is
# written (scripts/oracle/src/t_timekeeping.rs). tests/golden/timekeeping.tsv pins every use.

# Atomic frequency standards used to define or approximate the SI second.
#
# Each variant represents a real atomic transition used in precision
# timekeeping. The cesium-133 hyperfine transition defines the SI second
# (CGPM 1967, reaffirmed 2019). The Rb and optical standards are secondary
# representations of the second (CIPM 2025 recommended values).
enum TmFrequencyStandard {
    TM_FREQUENCY_STANDARD_CESIUM133 = 0;
    TM_FREQUENCY_STANDARD_RUBIDIUM87 = 1;
    TM_FREQUENCY_STANDARD_HYDROGEN_MASER = 2;
    TM_FREQUENCY_STANDARD_STRONTIUM_OPTICAL = 3;
    TM_FREQUENCY_STANDARD_YTTERBIUM_OPTICAL = 4;
}
const TM_FREQUENCY_STANDARD_COUNT = 5;

# Atomic and astronomical time scales.
#
# These represent the standard time scales used in precision timekeeping,
# geodesy, and astronomy. Conversions between them are defined by
# IAU resolutions and BIPM conventions.
enum TmTimeScale {
    TM_TIME_SCALE_TAI = 0;
    TM_TIME_SCALE_UTC = 1;
    TM_TIME_SCALE_TT = 2;
    TM_TIME_SCALE_GPS = 3;
    TM_TIME_SCALE_TCB = 4;
    TM_TIME_SCALE_TCG = 5;
}
const TM_TIME_SCALE_COUNT = 6;

# Transition frequency, Hz (Cs exact by definition; Rb, Sr, Yb CIPM 2025; H Hellwig et al. 1970).
# Indexed by TmFrequencyStandard; mirrors `FrequencyStandard::transition_frequency_hz`.
var TM_FREQUENCY_STANDARD_TRANSITION_FREQUENCY_HZ: f64[5] = {
    9192631770.0,  # Cesium133
    6834682610.904313,  # Rubidium87
    1420405751.7667,  # HydrogenMaser
    429228004229873.0,  # StrontiumOptical
    518295836590863.6,  # YtterbiumOptical
};

# Fractional instability (Allan deviation) at τ = 1 s, sourced per technology.
# Indexed by TmFrequencyStandard; mirrors `FrequencyStandard::fractional_stability`.
var TM_FREQUENCY_STANDARD_FRACTIONAL_STABILITY: f64[5] = {
    0.000000000012,  # Cesium133
    0.00000000002,  # Rubidium87
    0.00000000000015,  # HydrogenMaser
    0.000000000000000048,  # StrontiumOptical
    0.00000000000000014,  # YtterbiumOptical
};

# TT − TAI offset in seconds (IAU 1991, exact).
const TM_TAI_TT_OFFSET_S = 32.184;

# TAI − GPS offset in seconds (exact).
const TM_TAI_GPS_OFFSET_S = 19.0;

# L_G (IAU 2000 Resolution B1.9, defining constant): dTT/dTCG = 1 − L_G.
const TM_LG_RATE = 0.0000000006969290134;

# L_C (IERS Conventions 2010, Table 1.1): average rate of TCB relative to TCG,
# ⟨dTCB/dTCG⟩ = 1 + L_C.
const TM_LC_RATE = 0.0000000148082686741;

# L_B (IAU 2006 Resolution B3, defining constant): dTDB/dTCB = 1 − L_B.
const TM_LB_RATE = 0.00000001550519768;

# TDB0 (IAU 2006 Resolution B3, defining constant), in seconds.
const TM_TDB0_S = -0.0000655;

# T0: 1977-01-01T00:00:00 TAI as a TT (= TCG = TCB) Julian date
# (IERS Conventions 2010, eq. 10.1).
const TM_T0_JD = 2443144.5003725;

# Date (year, month, day) until which the leap-second table is known to be
