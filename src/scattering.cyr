# scattering.cyr — scattering theory: Rutherford and Mott, partial waves, Born for a screened
# Coulomb potential, electron scattering with a nuclear form factor, Compton (Klein–Nishina)
# and Bethe–Heitler pair production (port of rust-old/src/scattering.rs).
#
# Rust's operation order is kept, parenthesized. sin, cos and ln are `_tm_sin`, `_tm_cos` and
# `_tm_log`, Rust libm's own algorithms bit for bit (numerics.cyr). The port-parity rule needs
# that here: the Mott factor at β → 1, the form factor near its zeros and Klein–Nishina's closed
# form just above γ = 1e-2 turn a 1-ulp primitive difference into thousands of ulp. So every
# function but rutherford_total_above_angle (ganita's tan, class C) is class B. Phase-shift
# slices are an address and a count. Integer arguments outside Rust's u32 give NaN.

# ── Coulomb scattering ──────────────────────────────────────────────────────────────

# Z₁Z₂αħc as Rust computes it: ((Z₁·Z₂)·α)·ħc.
#must_use
fn _tm_z1z2_alpha_hbarc(z_proj, z_target): f64 {
    var a: f64 = ((f64_from(z_proj) * f64_from(z_target)) * TM_FINE_STRUCTURE) * TM_HBAR_C_MEV_FM;
    return a;
}

# The Rutherford cross section dσ/dΩ = (Z₁Z₂αħc/(4T))² / sin⁴(θ/2), fm²/sr, for a point charge
# on a point nucleus at centre-of-mass kinetic energy T (MeV). 0.0 for T ≤ 0; +∞ when
# sin⁴(θ/2) < 1e-30 (the forward divergence). Mirrors `rutherford_differential`.
#must_use
fn rutherford_differential(z_proj, z_target, energy_cm_mev: f64, theta_rad: f64): f64 {
    if (_tm_u32_ok(z_proj) != 1 || _tm_u32_ok(z_target) != 1) { return _tm_nan(); }
    if (energy_cm_mev <= 0.0) { return 0.0; }
    var sin_half: f64 = _tm_sin(theta_rad / 2.0);
    var sin4: f64 = ((sin_half * sin_half) * sin_half) * sin_half;
    if (sin4 < 0.000000000000000000000000000001) { return _TM_INF; }
    var k: f64 = _tm_z1z2_alpha_hbarc(z_proj, z_target);
    var a: f64 = k / (4.0 * energy_cm_mev);
    var s: f64 = (a * a) / sin4;
    return s;
}

# The Mott spin factor 1 − β² sin²(θ/2) for a relativistic spin-½ projectile on a spinless,
# infinitely heavy point charge (the projectile's magnetic moment, not identical-particle
# exchange): multiply the Rutherford result by it. Mirrors `mott_correction_factor`.
#must_use
fn mott_correction_factor(beta: f64, theta_rad: f64): f64 {
    var sin_half: f64 = _tm_sin(theta_rad / 2.0);
    var f: f64 = 1.0 - (((beta * beta) * sin_half) * sin_half);
    return f;
}

# The Rutherford cross section beyond θ_min, π b² = π (Z₁Z₂e²/(2T))² cot²(θ_min/2), fm². +∞ for
# T ≤ 0, θ_min ≤ 0 or tan²(θ_min/2) < 1e-30. Mirrors `rutherford_total_above_angle`.
#must_use
fn rutherford_total_above_angle(z_proj, z_target, energy_cm_mev: f64, theta_min_rad: f64): f64 {
    if (_tm_u32_ok(z_proj) != 1 || _tm_u32_ok(z_target) != 1) { return _tm_nan(); }
    if (energy_cm_mev <= 0.0 || theta_min_rad <= 0.0) { return _TM_INF; }
    var k: f64 = _tm_z1z2_alpha_hbarc(z_proj, z_target);
    var a: f64 = k / (4.0 * energy_cm_mev);
    var tan_half: f64 = ganita_f64_tan(theta_min_rad / 2.0);
    var tan2: f64 = tan_half * tan_half;
    if (tan2 < 0.000000000000000000000000000001) { return _TM_INF; }
    var s: f64 = (((4.0 * _TM_PI) * a) * a) / tan2;
    return s;
}

# The head-on (θ = π) distance of closest approach d = Z₁Z₂αħc/T, fm: 5 MeV α on Au is ≈ 45.5 fm.
# +∞ for T ≤ 0. Mirrors `distance_of_closest_approach`.
#must_use
fn distance_of_closest_approach(z_proj, z_target, energy_cm_mev: f64): f64 {
    if (_tm_u32_ok(z_proj) != 1 || _tm_u32_ok(z_target) != 1) { return _tm_nan(); }
    if (energy_cm_mev <= 0.0) { return _TM_INF; }
    var k: f64 = _tm_z1z2_alpha_hbarc(z_proj, z_target);
    var d: f64 = k / energy_cm_mev;
    return d;
}

# The Sommerfeld parameter η = Z₁Z₂α/β; η ≫ 1 is the classical (Rutherford) regime. +∞ for
# β ≤ 0. Mirrors `sommerfeld_parameter`.
#must_use
fn sommerfeld_parameter(z_proj, z_target, beta: f64): f64 {
    if (_tm_u32_ok(z_proj) != 1 || _tm_u32_ok(z_target) != 1) { return _tm_nan(); }
    if (beta <= 0.0) { return _TM_INF; }
    var eta: f64 = ((f64_from(z_proj) * f64_from(z_target)) * TM_FINE_STRUCTURE) / beta;
    return eta;
}

# ── partial waves ───────────────────────────────────────────────────────────────────

# The Legendre polynomial P_l(x) by the recurrence (l + 1) P_{l+1} = (2l + 1) x P_l − l P_{l−1};
# x should be in [−1, 1]. Mirrors `legendre_polynomial`.
#must_use
fn legendre_polynomial(l, x: f64): f64 {
    if (_tm_u32_ok(l) != 1) { return _tm_nan(); }
    if (l == 0) { return 1.0; }
    if (l == 1) { return x; }
    var p_prev: f64 = 1.0;
    var p_curr: f64 = x;
    var n = 1;
    while (n < l) {
        var nf: f64 = f64_from(n);
        var p_next: f64 = (((((2.0 * nf) + 1.0) * x) * p_curr) - (nf * p_prev)) / (nf + 1.0);
        p_prev = p_curr;
        p_curr = p_next;
        n = n + 1;
    }
    return p_curr;
}

# The total cross section from phase shifts, σ = (4π/k²) Σ_l (2l + 1) sin² δ_l, fm², for the
# `count` shifts δ_l (rad) at `phase_shifts`; k in fm⁻¹. 0.0 for k ≤ 0. Mirrors
# `partial_wave_cross_section`, which takes a slice.
#must_use
fn partial_wave_cross_section(k_inv_fm: f64, phase_shifts, count): f64 {
    if (k_inv_fm <= 0.0) { return 0.0; }
    var k2: f64 = k_inv_fm * k_inv_fm;
    var sum: f64 = 0.0;
    var l = 0;
    while (l < count) {
        var delta: f64 = load64(phase_shifts + l * 8);
        var sin_d: f64 = _tm_sin(delta);
        sum = sum + ((((2.0 * f64_from(l)) + 1.0) * sin_d) * sin_d);
        l = l + 1;
    }
    var s: f64 = ((4.0 * _TM_PI) * sum) / k2;
    return s;
}

# The differential cross section |f(θ)|², fm²/sr, with f(θ) = (1/k) Σ_l (2l + 1) e^{iδ_l} sin δ_l
# P_l(cos θ), for the `count` shifts at `phase_shifts`. 0.0 for k ≤ 0. Mirrors
# `partial_wave_differential`, which takes a slice.
#must_use
fn partial_wave_differential(k_inv_fm: f64, phase_shifts, count, theta_rad: f64): f64 {
    if (k_inv_fm <= 0.0) { return 0.0; }
    var cos_theta: f64 = _tm_cos(theta_rad);
    var re_f: f64 = 0.0;
    var im_f: f64 = 0.0;
    var l = 0;
    while (l < count) {
        var delta: f64 = load64(phase_shifts + l * 8);
        var sin_d: f64 = _tm_sin(delta);
        var cos_d: f64 = _tm_cos(delta);
        var pl: f64 = legendre_polynomial(l, cos_theta);
        var weight: f64 = ((2.0 * f64_from(l)) + 1.0) * pl;
        re_f = re_f + ((weight * sin_d) * cos_d);
        im_f = im_f + ((weight * sin_d) * sin_d);
        l = l + 1;
    }
    var s: f64 = ((re_f * re_f) + (im_f * im_f)) / (k_inv_fm * k_inv_fm);
    return s;
}

# ── Born approximation for a screened Coulomb potential ─────────────────────────────

# The Thomas–Fermi screening length a_TF = 0.88534 a₀ / Z^(1/3), fm (Ziegler, Biersack &
# Littmark 1985); 0.0 for Z = 0. Mirrors `thomas_fermi_screening_fm`.
#must_use
fn thomas_fermi_screening_fm(z): f64 {
    if (_tm_u32_ok(z) != 1) { return _tm_nan(); }
    if (z == 0) { return 0.0; }
    var a0_fm: f64 = TM_BOHR_RADIUS * 1000000000000000.0;
    var c: f64 = ganita_f64_cbrt(f64_from(z));
    var a: f64 = (0.88534 * a0_fm) / c;
    return a;
}

# The first-Born cross section for a screened Coulomb (Yukawa) potential V = (Z₁Z₂αħc/r) e^{−r/a},
# fm²/sr, non-relativistic: dσ/dΩ = [2μ Z₁Z₂α/(ħc (q² + 1/a²))]², ħ²k² = 2μT, q = 2k sin(θ/2); the
# rest masses (MeV/c²) give μ. 0.0 for T, a or a mass ≤ 0; +∞ when q² + 1/a² < 1e-30. Mirrors
# `born_screened_coulomb_with_masses`.
#must_use
fn born_screened_coulomb_with_masses(z_proj, z_target, mass_proj_mev: f64, mass_target_mev: f64, energy_cm_mev: f64,
    theta_rad: f64, screening_fm: f64): f64 {
    if (_tm_u32_ok(z_proj) != 1 || _tm_u32_ok(z_target) != 1) { return _tm_nan(); }
    if (energy_cm_mev <= 0.0 || screening_fm <= 0.0 || mass_proj_mev <= 0.0 || mass_target_mev <= 0.0) { return 0.0; }
    var mu: f64 = (mass_proj_mev * mass_target_mev) / (mass_proj_mev + mass_target_mev);
    var sin_half: f64 = _tm_sin(theta_rad / 2.0);
    var k2: f64 = ((2.0 * mu) * energy_cm_mev) / (TM_HBAR_C_MEV_FM * TM_HBAR_C_MEV_FM);
    var q2: f64 = ((4.0 * k2) * sin_half) * sin_half;
    var denom: f64 = q2 + (1.0 / (screening_fm * screening_fm));
    if (denom < 0.000000000000000000000000000001) { return _TM_INF; }
    var numer: f64 = ((((2.0 * mu) * f64_from(z_proj)) * f64_from(z_target)) * TM_FINE_STRUCTURE) / TM_HBAR_C_MEV_FM;
    var s: f64 = (numer * numer) / (denom * denom);
    return s;
}

# A rest mass estimated from Z: m_p for Z ≤ 1, else 2Z u (rough for heavy nuclei).
#must_use
fn _tm_mass_from_z(z): f64 {
    if (z <= 1) { return TM_PROTON_MASS_MEV; }
    var m: f64 = (f64_from(z) * 2.0) * TM_AMU_MEV;
    return m;
}

# born_screened_coulomb_with_masses with the masses estimated from Z (m_p for Z = 1, 2Z u
# otherwise; Au is then A ≈ 158, not 197). Mirrors `born_screened_coulomb`.
#must_use
fn born_screened_coulomb(z_proj, z_target, energy_cm_mev: f64, theta_rad: f64, screening_fm: f64): f64 {
    if (_tm_u32_ok(z_proj) != 1 || _tm_u32_ok(z_target) != 1) { return _tm_nan(); }
    var m1: f64 = _tm_mass_from_z(z_proj);
    var m2: f64 = _tm_mass_from_z(z_target);
    var s: f64 = born_screened_coulomb_with_masses(z_proj, z_target, m1, m2, energy_cm_mev, theta_rad, screening_fm);
    return s;
}

# ── electron scattering ─────────────────────────────────────────────────────────────

# The Mott cross section for electrons of kinetic energy T (MeV) on a spinless, infinitely
# heavy point nucleus, fm²/sr: (Zαħc/(2pcβ))² (1 − β² sin²(θ/2)) / sin⁴(θ/2), with pc and β
# exact from T (first Born, Zα ≪ 1, no recoil). 0.0 for T ≤ 0; +∞ when sin⁴(θ/2) < 1e-30.
# Mirrors `mott_electron_differential`.
#must_use
fn mott_electron_differential(z_target, electron_energy_mev: f64, theta_rad: f64): f64 {
    if (_tm_u32_ok(z_target) != 1) { return _tm_nan(); }
    if (electron_energy_mev <= 0.0) { return 0.0; }
    var sin_half: f64 = _tm_sin(theta_rad / 2.0);
    var sin2: f64 = sin_half * sin_half;
    var sin4: f64 = sin2 * sin2;
    if (sin4 < 0.000000000000000000000000000001) { return _TM_INF; }
    var t: f64 = electron_energy_mev;
    var total: f64 = t + TM_ELECTRON_MASS_MEV;
    var pc: f64 = f64_sqrt(t * (t + (2.0 * TM_ELECTRON_MASS_MEV)));
    var beta: f64 = pc / total;
    var a: f64 = ((f64_from(z_target) * TM_FINE_STRUCTURE) * TM_HBAR_C_MEV_FM) / ((2.0 * pc) * beta);
    var s: f64 = ((a * a) * (1.0 - ((beta * beta) * sin2))) / sin4;
    return s;
}

# The form factor of a uniformly charged sphere of radius R (fm) at momentum transfer q (fm⁻¹),
# F = 3 (sin qR − qR cos qR)/(qR)³; below |qR| = 0.5 the Taylor series Σ (−1)ⁿ 3(2n+2) x²ⁿ/(2n+3)!,
# where the closed form cancels. Mirrors `nuclear_form_factor_uniform`.
#must_use
fn nuclear_form_factor_uniform(q_inv_fm: f64, radius_fm: f64): f64 {
    var qr: f64 = q_inv_fm * radius_fm;
    if (f64_abs(qr) < 0.5) {
        var x2: f64 = qr * qr;
        var term: f64 = 1.0;
        var sum: f64 = 1.0;
        var n = 1;
        while (n <= 10) {
            var nf: f64 = f64_from(n);
            var mx2: f64 = -x2;
            term = term * (mx2 / ((2.0 * nf) * ((2.0 * nf) + 3.0)));
            sum = sum + term;
            n = n + 1;
        }
        return sum;
    }
    var sin_qr: f64 = _tm_sin(qr);
    var cos_qr: f64 = _tm_cos(qr);
    var qr3: f64 = (qr * qr) * qr;
    var f: f64 = (3.0 * (sin_qr - (qr * cos_qr))) / qr3;
    return f;
}

# The Mott cross section times |F(q)|², fm²/sr, with the uniform-sphere radius R = 1.2 A^(1/3) fm
# and q = 2p sin(θ/2)/(ħc), p from the kinetic energy. Mirrors `mott_electron_with_form_factor`.
#must_use
fn mott_electron_with_form_factor(z_target, a_target, electron_energy_mev: f64, theta_rad: f64): f64 {
    if (_tm_u32_ok(a_target) != 1) { return _tm_nan(); }
    var mott: f64 = mott_electron_differential(z_target, electron_energy_mev, theta_rad);
    var sin_half: f64 = _tm_sin(theta_rad / 2.0);
    var t: f64 = electron_energy_mev;
    var pc: f64 = f64_sqrt(t * (t + (2.0 * TM_ELECTRON_MASS_MEV)));
    var q: f64 = ((2.0 * pc) * sin_half) / TM_HBAR_C_MEV_FM;
    var c: f64 = ganita_f64_cbrt(f64_from(a_target));
    var radius: f64 = 1.2 * c;
    var ff: f64 = nuclear_form_factor_uniform(q, radius);
    var s: f64 = (mott * ff) * ff;
    return s;
}

# ── Compton scattering ──────────────────────────────────────────────────────────────

# The Compton energy ratio ω'/ω = 1/[1 + (E_γ/m_e c²)(1 − cos θ)]. Mirrors
# `compton_energy_ratio`.
#must_use
fn compton_energy_ratio(photon_energy_mev: f64, theta_rad: f64): f64 {
    var gamma: f64 = photon_energy_mev / TM_ELECTRON_MASS_MEV;
    var cos_theta: f64 = _tm_cos(theta_rad);
    var r: f64 = 1.0 / (1.0 + (gamma * (1.0 - cos_theta)));
    return r;
}

# The Klein–Nishina cross section dσ/dΩ = (r_e²/2)(ω'/ω)²[ω/ω' + ω'/ω − sin²θ], fm²/sr. 0.0 for
# E_γ ≤ 0. Mirrors `klein_nishina_differential`.
#must_use
fn klein_nishina_differential(photon_energy_mev: f64, theta_rad: f64): f64 {
    if (photon_energy_mev <= 0.0) { return 0.0; }
    var ratio: f64 = compton_energy_ratio(photon_energy_mev, theta_rad);
    var inv_ratio: f64 = 1.0 / ratio;
    var sin_theta: f64 = _tm_sin(theta_rad);
    var re2_half: f64 = (TM_CLASSICAL_ELECTRON_RADIUS_FM * TM_CLASSICAL_ELECTRON_RADIUS_FM) / 2.0;
    var s: f64 = ((re2_half * ratio) * ratio) * ((inv_ratio + ratio) - (sin_theta * sin_theta));
    return s;
}

# The total Klein–Nishina cross section, fm²: σ = 2π r_e² {[(1+γ)/γ³][2γ(1+γ)/(1+2γ) − ln(1+2γ)]
# + ln(1+2γ)/(2γ) − (1+3γ)/(1+2γ)²}, γ = E_γ/m_e c². Below γ = 1e-2, where that cancels, the
# series σ_T (1 − 2γ + 26γ²/5 − 133γ³/10 + 1144γ⁴/35); σ_T = (8/3)π r_e² at γ → 0. 0.0 for E_γ ≤ 0.
# Mirrors `klein_nishina_total`.
#must_use
fn klein_nishina_total(photon_energy_mev: f64): f64 {
    if (photon_energy_mev <= 0.0) { return 0.0; }
    var re2: f64 = TM_CLASSICAL_ELECTRON_RADIUS_FM * TM_CLASSICAL_ELECTRON_RADIUS_FM;
    var g: f64 = photon_energy_mev / TM_ELECTRON_MASS_MEV;
    if (g < 0.01) {
        var thomson: f64 = ((8.0 * _TM_PI) * re2) / 3.0;
        var p: f64 = (1.0 - (2.0 * g)) + (((26.0 / 5.0) * g) * g);
        p = p - ((((133.0 / 10.0) * g) * g) * g);
        p = p + (((((1144.0 / 35.0) * g) * g) * g) * g);
        var s: f64 = thomson * p;
        return s;
    }
    var g2: f64 = g * g;
    var g3: f64 = g2 * g;
    var one_plus_2g: f64 = 1.0 + (2.0 * g);
    var ln_term: f64 = _tm_log(one_plus_2g);
    var term1: f64 = ((1.0 + g) / g3) * ((((2.0 * g) * (1.0 + g)) / one_plus_2g) - ln_term);
    var term2: f64 = ln_term / (2.0 * g);
    var term3: f64 = (1.0 + (3.0 * g)) / (one_plus_2g * one_plus_2g);
    var t: f64 = ((2.0 * _TM_PI) * re2) * ((term1 + term2) - term3);
    return t;
}

# ── pair production ─────────────────────────────────────────────────────────────────

# The Bethe–Heitler pair-production cross section in the field of a point nucleus, fm² per atom
# (first Born, unscreened), in Maximon's analytic forms (J. Res. NBS 72B, 79 (1968), as tabulated
# by Hubbell, Gimm & Øverbø 1980), k = E_γ/m_e c²:
# - 2 < k < 4: (2π/3) Z²α r_e² ((k−2)/k)³ [1 + ε/2 + 23ε²/40 + 11ε³/60 + 29ε⁴/960],
#   ε = (2k − 4)/(2 + k + 2√(2k));
# - k ≥ 4: Z²α r_e² {(28/9) ln 2k − 218/27 + (2/k)²[6 ln 2k − 7/2 + (2/3) ln³ 2k − ln² 2k
#   − (π²/3) ln 2k + 2ζ(3) + π²/6] − (2/k)⁴[(3/16) ln 2k + 1/8] − (2/k)⁶[(29/2304) ln 2k − 77/13824]}.
# The branches join at k = 4 and σ > 0 above threshold. No screening, Coulomb correction or
# triplet production. 0.0 at or below threshold (and for NaN). Mirrors
# `pair_production_cross_section`.
#must_use
fn pair_production_cross_section(z_target, photon_energy_mev: f64): f64 {
    if (_tm_u32_ok(z_target) != 1) { return _tm_nan(); }
    var k: f64 = photon_energy_mev / TM_ELECTRON_MASS_MEV;
    if (k != k || k <= 2.0) { return 0.0; }
    var zf: f64 = f64_from(z_target);
    var z2: f64 = zf * zf;
    var re: f64 = TM_CLASSICAL_ELECTRON_RADIUS_FM;
    var prefactor: f64 = ((z2 * TM_FINE_STRUCTURE) * re) * re;
    if (k < 4.0) {
        var root: f64 = f64_sqrt(2.0 * k);
        var eps: f64 = ((2.0 * k) - 4.0) / ((2.0 + k) + (2.0 * root));
        var ratio: f64 = (k - 2.0) / k;
        var series: f64 = (1.0 + (eps / 2.0)) + (((23.0 * eps) * eps) / 40.0);
        series = series + ((((11.0 * eps) * eps) * eps) / 60.0);
        series = series + (((((29.0 * eps) * eps) * eps) * eps) / 960.0);
        var lo: f64 = ((((prefactor * ((2.0 * _TM_PI) / 3.0)) * ratio) * ratio) * ratio) * series;
        return lo;
    }
    var l: f64 = _tm_log(2.0 * k);
    var r2: f64 = (2.0 / k) * (2.0 / k);
    var pi2: f64 = _TM_PI * _TM_PI;
    var inner: f64 = ((6.0 * l) - 3.5) + ((((2.0 / 3.0) * l) * l) * l);
    inner = (inner - (l * l)) - ((pi2 / 3.0) * l);
    inner = (inner + (2.0 * _TM_ZETA3)) + (pi2 / 6.0);
    var bracket: f64 = (((28.0 / 9.0) * l) - (218.0 / 27.0)) + (r2 * inner);
    bracket = bracket - ((r2 * r2) * (((3.0 / 16.0) * l) + 0.125));
    bracket = bracket - (((r2 * r2) * r2) * (((29.0 / 2304.0) * l) - (77.0 / 13824.0)));
    var hi: f64 = prefactor * bracket;
    return hi;
}
