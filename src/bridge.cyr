# bridge.cyr — cross-crate bridges (port of rust-old/src/bridge.rs, in part; port plan §6).
#
# Ported: the chrono bridge (datetime interop). Like the Rust bridge, its functions take plain
# values and have no datetime dependency. A stdlib lib/chrono.cyr datetime `dt` (Unix
# nanoseconds) supplies them:
#   year = dt_year(dt), month = dt_month(dt),
#   UTC seconds since this crate's 1958-01-01 epoch = dt_epoch_secs(dt) + 378,691,200.
# The 378,691,200 s are 4,383 days (12 years of 365 days plus the leap days of 1960, 1964 and
# 1968) from 1958-01-01 to the Unix epoch. tests/bridge.tcyr checks the recipe for every month
# 1972–2035. ⚠ It holds from 1970 on only: lib/chrono.cyr 6.7.18's calendar counts forward from
# the Unix epoch, so it decodes or parses an earlier date wrongly, without an error. Before 1972
# the bridge's ΔAT is 0 anyway.
#
# Rust's jyotish bridge `tai_to_tt` only calls `timekeeping::tai_to_tt`, so in Cyrius's one
# flat namespace it is timekeeping.cyr's `tai_to_tt`.
#
# Deferred until each consumer is in Cyrius (port plan §1): the bijli, kimiya, hisab-mimamsa
# and falak bridges, the prakash-labelled helpers, kiran/joshua's SimulationClock and bhava's
# TimeContext.
#
# Like leap_seconds_at, which they wrap, the three functions accept any integer year and month.
# Rust takes an i32 year and a u8 month, so values outside those ranges have no Rust
# counterpart; the lookup extends the table naturally there.

# ── chrono bridge (datetime interop) ─────────────────────────────────────────────────

# ΔAT = TAI − UTC in whole seconds at a UTC year and month (1–12): 0 before 1972 (for 1961–1971
# use tai_minus_utc_seconds_mjd). Mirrors `bridge::utc_date_to_tai_offset`.
#must_use
fn utc_date_to_tai_offset(year, month): i64 {
    return leap_seconds_at(year, month);
}

# UTC = TAI − ΔAT, in seconds since the 1958-01-01 epoch. The caller supplies the UTC year and
# month for the leap-second lookup. Mirrors `bridge::tai_to_utc_seconds`.
#must_use
fn tai_to_utc_seconds(tai_seconds: f64, utc_year, utc_month): f64 {
    var d: f64 = f64_from(leap_seconds_at(utc_year, utc_month));
    var r: f64 = tai_seconds - d;
    return r;
}

# TAI = UTC + ΔAT, in seconds since the 1958-01-01 epoch. Mirrors `bridge::utc_to_tai_seconds`.
#must_use
fn utc_to_tai_seconds(utc_seconds: f64, year, month): f64 {
    var d: f64 = f64_from(leap_seconds_at(year, month));
    var r: f64 = utc_seconds + d;
    return r;
}
