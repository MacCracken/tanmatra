# Bethe logarithms ln k₀(n, l) for hydrogen (Drake & Swainson,
# Phys. Rev. A 41, 1243 (1990)).
#
# Indexed by n(n − 1)/2 + l for n = 1..=4, l < n.
# ln k₀(n, l).
var _TM_BETHE_LOG: f64[10] = {
    2.984128556,  # 1s
    2.811769893,  # 2s
    -0.030016709,  # 2p
    2.767663612,  # 3s
    -0.038190229,  # 3p
    -0.005232148,  # 3d
    2.74981184,  # 4s
    -0.041954895,  # 4p
    -0.006740939,  # 4d
    -0.001733661,  # 4f
};

# --- atomic_config.cyr ---

# atomic_config.cyr — orbital types, quantum numbers, electron configurations, ionization
# energies and electron affinities (port of the configuration half of rust-old/src/atomic.rs).
#
# - A configuration is an array of `struct TmOrbitalFilling { n; orbital; electrons; }`, Rust's
#   OrbitalFilling with its public fields: `var cfg: TmOrbitalFilling[20];`. Reach entry k through
#   a typed pointer, `var base: *TmOrbitalFilling = &cfg;` then `base + k`, which steps by sizeof
#   (24 bytes). `&cfg + k` is an untyped address and steps by BYTES; passing `&cfg` to a
#   `*TmOrbitalFilling` parameter is fine. Every u32 field round-trips, unlike a packed word.
# - electron_configuration fills a caller array and returns the count. Twenty entries always
#   suffice: the filling order has 20 subshells.
# - The tables are the generated atomic_data.cyr. Everything here is integer logic or a table
#   read, so the golden rows are class A.
# - Integer arguments are Rust's u32 (or i32). A value outside that type is not one Rust can be
#   called with: a fallible function returns its Err, an infallible f64 one NaN, and a
#   TransitionType one TM_TRANSITION_TYPE_FORBIDDEN.

# 1 if x is a u32 value. Branch-free, so #inline replays it at each call.
#must_use
#inline
fn _tm_u32_ok(x): i64 { return (x >= 0) & (x <= 0xFFFFFFFF); }

# 1 if x is an i32 value. Branch-free, so #inline replays it at each call.
#must_use
#inline
fn _tm_i32_ok(x): i64 { return (x >= (0 - 2147483648)) & (x <= 2147483647); }

# ── OrbitalType ─────────────────────────────────────────────────────────────────────

# The angular momentum quantum number l. Mirrors `OrbitalType::l`.
#must_use
fn orbital_type_l(o): i64 {
    if (_tm_in_range(o, TM_ORBITAL_TYPE_COUNT) != 1) { return 0 - 1; }
    return TM_ORBITAL_TYPE_L[o];
}

# The subshell capacity 2(2l + 1). Mirrors `OrbitalType::max_electrons`.
#must_use
fn orbital_type_max_electrons(o): i64 {
    if (_tm_in_range(o, TM_ORBITAL_TYPE_COUNT) != 1) { return 0 - 1; }
    return TM_ORBITAL_TYPE_MAX_ELECTRONS[o];
}

# The letter symbol as an ASCII code ('s' is 115). Mirrors `OrbitalType::symbol`, which
# returns a char.
#must_use
fn orbital_type_symbol(o): i64 {
    if (_tm_in_range(o, TM_ORBITAL_TYPE_COUNT) != 1) { return 0 - 1; }
    return TM_ORBITAL_TYPE_SYMBOL[o];
}

# ── QuantumNumbers ──────────────────────────────────────────────────────────────────

# A validated set of quantum numbers (n, l, ml, ms), ms stored as +1 or −1 for ±1/2. Mirrors
# `QuantumNumbers`.
struct TmQuantumNumbers {
    n: i64;
    l: i64;
    ml: i64;
    ms: i64;
}

impl TmQuantumNumbers {
    # Validates (n, l, ml, ms), writes them to *out and returns Ok(out); or
    # Err(TM_ERR_INVALID_QUANTUM_NUMBERS) when n < 1, l ≥ n, |ml| > l or ms is not ±1, leaving
    # *out untouched. A 32-byte struct can't ride a value-form Result, so this mirrors
    # `QuantumNumbers::new` through an out-pointer.
    #must_use
    fn new(n, l, ml, ms, out: *TmQuantumNumbers): Result {
        if (_tm_u32_ok(n) != 1 || _tm_u32_ok(l) != 1 || _tm_i32_ok(ml) != 1 || _tm_i32_ok(ms) != 1) {
            return Err(TM_ERR_INVALID_QUANTUM_NUMBERS);
        }
        if (n == 0 || l >= n) { return Err(TM_ERR_INVALID_QUANTUM_NUMBERS); }
        var aml = ml;
        if (ml < 0) { aml = 0 - ml; }
        if (aml > l) { return Err(TM_ERR_INVALID_QUANTUM_NUMBERS); }
        if (ms != 1 && ms != (0 - 1)) { return Err(TM_ERR_INVALID_QUANTUM_NUMBERS); }
        out.n = n;
        out.l = l;
        out.ml = ml;
        out.ms = ms;
        return Ok(out);
    }
}

# ── OrbitalFilling ──────────────────────────────────────────────────────────────────

# A configuration entry: `electrons` in subshell (n, orbital), orbital a TmOrbitalType. Mirrors
# `OrbitalFilling`.
struct TmOrbitalFilling {
    n: i64;
    orbital: i64;
    electrons: i64;
}

# ── electron configurations ─────────────────────────────────────────────────────────

# Rust's set_subshell over the `count` entries at cfg: subshell (n, orbital) gets `electrons`,
# or is appended when absent and electrons > 0. Returns the new count.
#must_use
fn _tm_set_subshell(cfg: *TmOrbitalFilling, count, n, orbital, electrons): i64 {
    var k = 0;
    while (k < count) {
        var e: *TmOrbitalFilling = cfg + k;
        if (e.n == n && e.orbital == orbital) {
            e.electrons = electrons;
            return count;
        }
        k = k + 1;
    }
    if (electrons > 0) {
        var f: *TmOrbitalFilling = cfg + count;
        f.n = n;
        f.orbital = orbital;
        f.electrons = electrons;
        return count + 1;
    }
    return count;
}

# The ground-state configuration of element Z: the Aufbau filling in Madelung order (n + l,
# then n), with the 20 NIST exceptions (Cr, Cu, Nb, Mo, Ru, Rh, Pd, Ag, La, Ce, Gd, Pt, Au, Ac,
# Th, Pa, U, Np, Cm, Lr). Writes up to `cap` entries to out[] and returns Ok(count) — 20
# entries always suffice — or Err(TM_ERR_INVALID_ATOMIC_NUMBER) unless 1 ≤ Z ≤ 118. Mirrors
# `electron_configuration`.
#must_use
fn electron_configuration(z, out: *TmOrbitalFilling, cap): Result {
    if (z < 1 || z > 118) { return Err(TM_ERR_INVALID_ATOMIC_NUMBER); }
    var cfg: TmOrbitalFilling[21];   # the 20 subshells, plus the one an exception may append
    var base: *TmOrbitalFilling = &cfg;
    var count = 0;
    var remaining = z;
    var k = 0;
    while (k < _TM_FILLING_ORDER_COUNT && remaining > 0) {
        var orbital = _TM_FILLING_ORDER_ORBITAL[k];
        var max = TM_ORBITAL_TYPE_MAX_ELECTRONS[orbital];
        var fill = remaining;
        if (remaining >= max) { fill = max; }
        var e: *TmOrbitalFilling = base + count;
        e.n = _TM_FILLING_ORDER_N[k];
        e.orbital = orbital;
        e.electrons = fill;
        count = count + 1;
        remaining = remaining - fill;
        k = k + 1;
    }
    var x = 0;
    while (x < _TM_CONFIG_EXCEPTION_COUNT) {
        if (_TM_CONFIG_EXCEPTION_Z[x] == z) {
            var e1 = _TM_CONFIG_EXCEPTION_ELECTRONS1[x];
            var e2 = _TM_CONFIG_EXCEPTION_ELECTRONS2[x];
            count = _tm_set_subshell(base, count, _TM_CONFIG_EXCEPTION_N1[x], _TM_CONFIG_EXCEPTION_ORBITAL1[x], e1);
            count = _tm_set_subshell(base, count, _TM_CONFIG_EXCEPTION_N2[x], _TM_CONFIG_EXCEPTION_ORBITAL2[x], e2);
        }
        x = x + 1;
    }
    # Drop the subshells an exception emptied (Rust's retain).
    var n = 0;
    k = 0;
    while (k < count) {
        var src: *TmOrbitalFilling = base + k;
        if (src.electrons > 0) {
            if (n < cap) {
                var dst: *TmOrbitalFilling = out + n;
                dst.n = src.n;
                dst.orbital = src.orbital;
                dst.electrons = src.electrons;
            }
            n = n + 1;
        }
        k = k + 1;
    }
    return Ok(n);
}

# Appends entries [from, to) of cfg to the builder, as "1s2 2s2 2p6".
fn _tm_format_entries(sb, cfg: *TmOrbitalFilling, from, to) {
    var k = from;
    while (k < to) {
        var e: *TmOrbitalFilling = cfg + k;
        if (k > from) { str_builder_putc(sb, 32); }
        str_builder_add_int(sb, e.n);
        var c = orbital_type_symbol(e.orbital);
        if (c < 0) { c = 63; }
        str_builder_putc(sb, c);
        str_builder_add_int(sb, e.electrons);
        k = k + 1;
    }
}

# The configuration's `len` entries at cfg as text, e.g. "1s2 2s2 2p6 3s2 3p6 4s2 3d6" for
# iron. An orbital that is not a TmOrbitalType prints as '?'. Mirrors `format_configuration`.
#must_use
fn format_configuration(cfg: *TmOrbitalFilling, len): Str {
    var sb = str_builder_new();
    _tm_format_entries(sb, cfg, 0, len);
    return str_builder_build(sb);
}

# The configuration in noble-gas core notation, e.g. "[Ar] 4s2 3d6" for iron (Z = 26). The core
# is the largest of He, Ne, Ar, Kr, Xe, Rn below Z; the entries up to the one that completes
# its electron count are replaced by it. Z ≤ 2 gives the plain format. Mirrors
# `format_configuration_short`.
#must_use
fn format_configuration_short(cfg: *TmOrbitalFilling, len, z): Str {
    var core = 0;
    var core_z = 0;
    if (z > 86) { core = "[Rn]"; core_z = 86; }
    elif (z > 54) { core = "[Xe]"; core_z = 54; }
    elif (z > 36) { core = "[Kr]"; core_z = 36; }
    elif (z > 18) { core = "[Ar]"; core_z = 18; }
    elif (z > 10) { core = "[Ne]"; core_z = 10; }
    elif (z > 2) { core = "[He]"; core_z = 2; }
    else { return format_configuration(cfg, len); }
    var electrons = 0;
    var start = 0;
    var k = 0;
    while (k < len) {
        var e: *TmOrbitalFilling = cfg + k;
        electrons = electrons + e.electrons;
        if (electrons >= core_z) {
            start = k + 1;
            break;
        }
        k = k + 1;
    }
    var sb = str_builder_new();
    str_builder_add_cstr(sb, core);
    if (start < len) {
        str_builder_putc(sb, 32);
        _tm_format_entries(sb, cfg, start, len);
    }
    return str_builder_build(sb);
}

# ── ionization energies and electron affinities ─────────────────────────────────────

# The first ionization energy in eV: NIST ASD for Z = 1–108, relativistic calculations
# (Smits et al. 2023) for Z = 109–118. Err(TM_ERR_INVALID_ATOMIC_NUMBER) unless 1 ≤ Z ≤ 118.
# Mirrors `ionization_energy_ev`.
#must_use
fn ionization_energy_ev(z): Result {
    if (z < 1 || z > 118) { return Err(TM_ERR_INVALID_ATOMIC_NUMBER); }
    var ie: f64 = _TM_IONIZATION_ENERGY_EV[z - 1];
    return Ok(ie);
}

# The kind of the neutral atom's electron affinity: Ok(TM_ELECTRON_AFFINITY_BOUND, _UNBOUND
# or _UNKNOWN), or Err(TM_ERR_INVALID_ATOMIC_NUMBER) unless 1 ≤ Z ≤ 118. The bound value is
# electron_affinity_ev(z): a `: stack` enum can't nest inside a value-form Result, so Rust's
# `Bound(f64)` payload travels there (port plan §5). Mirrors `electron_affinity`.
#must_use
fn electron_affinity(z): Result {
    if (z < 1 || z > 118) { return Err(TM_ERR_INVALID_ATOMIC_NUMBER); }
    return Ok(_TM_ELECTRON_AFFINITY_KIND[z - 1]);
}

# The electron affinity in eV, the energy released by X + e⁻ → X⁻: 0.0 both when no bound
# anion exists and when no value is known (electron_affinity tells them apart).
# Err(TM_ERR_INVALID_ATOMIC_NUMBER) unless 1 ≤ Z ≤ 118. Mirrors `electron_affinity_ev`.
#must_use
fn electron_affinity_ev(z): Result {
    if (z < 1 || z > 118) { return Err(TM_ERR_INVALID_ATOMIC_NUMBER); }
    var ev: f64 = _TM_ELECTRON_AFFINITY_EV[z - 1];
    return Ok(ev);
}

# --- atomic_hydrogenic.cyr ---

# atomic_hydrogenic.cyr — hydrogen-like atoms: Rydberg lines with and without the reduced
# mass, first-order fine structure, the named series, Landé g, the Zeeman and Stark shifts,
# radial wavefunctions, E1 selection rules and the Einstein coefficients (port of the
# hydrogenic part of rust-old/src/atomic.rs).
#
# Every formula keeps Rust's evaluation order, parenthesized, so the golden rows of the
# arithmetic functions are bit-identical (class B). The radial functions use exp (class C),
# and the Einstein coefficients the exact radial dipole integral, a double sum of pow terms
# (class D). Integer arguments follow atomic_config.cyr: outside Rust's u32 / i32 a fallible
# function returns its Err and an infallible one NaN. Where Rust's u32 arithmetic would
# overflow (2n − 1 for n ≥ 2^31), the port computes exactly in i64.

# ── spectral lines ──────────────────────────────────────────────────────────────────

# Vacuum wavelength, nm, of the hydrogen-like line n1 ↔ n2 for an infinitely heavy nucleus:
# 1/λ = R∞ Z² |1/n1² − 1/n2²|. Hα is 656.112 nm here and 656.470 nm with the proton's mass
# (spectral_line_vacuum_nm). Err(TM_ERR_INVALID_ATOMIC_NUMBER) for Z = 0;
# Err(TM_ERR_INVALID_QUANTUM_NUMBERS) for n1 or n2 = 0, or n1 = n2. Mirrors `spectral_line_nm`.
#must_use
fn spectral_line_nm(z, n1, n2): Result {
    if (z == 0 || _tm_u32_ok(z) != 1) { return Err(TM_ERR_INVALID_ATOMIC_NUMBER); }
    if (n1 == 0 || n2 == 0 || _tm_u32_ok(n1) != 1 || _tm_u32_ok(n2) != 1) {
        return Err(TM_ERR_INVALID_QUANTUM_NUMBERS);
    }
    if (n1 == n2) { return Err(TM_ERR_INVALID_QUANTUM_NUMBERS); }
    var lower = n1;
    var upper = n2;
    if (n1 > n2) { lower = n2; upper = n1; }
    var zf: f64 = f64_from(z);
    var lo: f64 = f64_from(lower);
    var up: f64 = f64_from(upper);
    var inv: f64 = ((TM_RYDBERG * zf) * zf) * ((1.0 / (lo * lo)) - (1.0 / (up * up)));
    var nm: f64 = 1000000000.0 / inv;
    return Ok(nm);
}

# The reduced-mass factor μ/m_e = 1/(1 + m_e/M) of a hydrogen-like ion (Z, A). M is the
# AME2020 atomic mass less Z electron masses when tabulated, else the semi-empirical nuclear
# mass; the proton mass for ¹H. Err as nucleus_new for an invalid (Z, A). Mirrors
# `reduced_mass_factor`.
#must_use
fn reduced_mass_factor(z, a): Result {
    var t, nuc = nucleus_new(z, a);
    if (is_err_result(t) == 1) { return Err(nuc); }
    var m: f64 = TM_PROTON_MASS_MEV;
    if (z != 1 || a != 1) {
        var ot, ov = nucleus_experimental_atomic_mass_amu(nuc);
        if (is_some(ot) == 1) {
            var amu: f64 = ov;
            m = (amu * TM_AMU_MEV) - (f64_from(z) * TM_ELECTRON_MASS_MEV);
        } else {
            m = nucleus_nuclear_mass(nuc);
        }
    }
    var r: f64 = 1.0 / (1.0 + (TM_ELECTRON_MASS_MEV / m));
    return Ok(r);
}

# Vacuum wavelength, nm, with the nuclear reduced-mass correction: λ∞ / (μ/m_e). Hydrogen Hα:
# 656.470 nm. Errors as spectral_line_nm, then reduced_mass_factor. Mirrors
# `spectral_line_vacuum_nm`.
#must_use
fn spectral_line_vacuum_nm(z, a, n1, n2): Result {
    var t1, v1 = spectral_line_nm(z, n1, n2);
    if (is_err_result(t1) == 1) { return Err(v1); }
    var t2, v2 = reduced_mass_factor(z, a);
    if (is_err_result(t2) == 1) { return Err(v2); }
    var nm: f64 = v1;
    var mu: f64 = v2;
    var r: f64 = nm / mu;
    return Ok(r);
}

# Energy, eV (negative: bound), of the hydrogen-like level (n, j) with the first-order fine
# structure, infinite nuclear mass:
# E = −R∞hc Z²/n² × [1 + (αZ)²/n² × (n/(j + 1/2) − 3/4)], j passed as 2j.
# Err(TM_ERR_INVALID_QUANTUM_NUMBERS) for n = 0, or 2j not odd in 1..=2n − 1. Mirrors
# `hydrogen_level_energy_ev`.
#must_use
fn hydrogen_level_energy_ev(z, n, two_j): Result {
    if (_tm_u32_ok(z) != 1) { return Err(TM_ERR_INVALID_ATOMIC_NUMBER); }
    if (n == 0 || _tm_u32_ok(n) != 1 || _tm_u32_ok(two_j) != 1) { return Err(TM_ERR_INVALID_QUANTUM_NUMBERS); }
    if ((two_j & 1) == 0 || two_j > 2 * n - 1) { return Err(TM_ERR_INVALID_QUANTUM_NUMBERS); }
    var zf: f64 = f64_from(z);
    var nf: f64 = f64_from(n);
    var jph: f64 = (f64_from(two_j) + 1.0) / 2.0;
    var ry: f64 = TM_RYDBERG_EV;
    var e0: f64 = ((-ry * zf) * zf) / (nf * nf);
    var az: f64 = TM_FINE_STRUCTURE * zf;
    var corr: f64 = 1.0 + (((az * az) / (nf * nf)) * ((nf / jph) - 0.75));
    var e: f64 = e0 * corr;
    return Ok(e);
}

# Wavelength, nm, of the line between two first-order fine-structure levels (n1, 2j1) and
# (n2, 2j2): hc / |E2 − E1|. Errors as hydrogen_level_energy_ev, and
# Err(TM_ERR_INVALID_QUANTUM_NUMBERS) when |ΔE| < 1e-30 eV. Mirrors `spectral_line_fine_nm`.
#must_use
fn spectral_line_fine_nm(z, n1, two_j1, n2, two_j2): Result {
    var t1, v1 = hydrogen_level_energy_ev(z, n1, two_j1);
    if (is_err_result(t1) == 1) { return Err(v1); }
    var t2, v2 = hydrogen_level_energy_ev(z, n2, two_j2);
    if (is_err_result(t2) == 1) { return Err(v2); }
    var e1: f64 = v1;
    var e2: f64 = v2;
    var d: f64 = f64_abs(e2 - e1);
    if (d < 0.000000000000000000000000000001) { return Err(TM_ERR_INVALID_QUANTUM_NUMBERS); }
    var nm: f64 = TM_HC_EV_NM / d;
    return Ok(nm);
}

# ── named series ────────────────────────────────────────────────────────────────────

# The series n → `lower` for n = lower + 1 ..= n_max: writes up to `cap` (n, λ nm) pairs to
# n_out[] (i64) and nm_out[] (f64) and returns Ok(count), count = n_max − lower.
# Err(TM_ERR_INVALID_QUANTUM_NUMBERS) when n_max ≤ lower, then Err(TM_ERR_INVALID_ATOMIC_NUMBER)
# for Z = 0, as Rust's first spectral_line_nm call.
#must_use
fn _tm_series(z, lower, n_max, n_out, nm_out, cap): Result {
    if (n_max <= lower || _tm_u32_ok(n_max) != 1) { return Err(TM_ERR_INVALID_QUANTUM_NUMBERS); }
    if (z == 0 || _tm_u32_ok(z) != 1) { return Err(TM_ERR_INVALID_ATOMIC_NUMBER); }
    var count = n_max - lower;
    var k = 0;
    while (k < count && k < cap) {
        var n = lower + 1 + k;
        var t, v = spectral_line_nm(z, lower, n);
        store64(n_out + k * 8, n);
        store64(nm_out + k * 8, v);
        k = k + 1;
    }
    return Ok(count);
}

# Lyman series n → 1 (ultraviolet, 91.2–121.6 nm) for n = 2 ..= n_max, as _tm_series: Ok(count)
# with up to `cap` pairs in n_out[] / nm_out[]. Err(TM_ERR_INVALID_QUANTUM_NUMBERS) for
# n_max < 2. Mirrors the Vec `lyman_series` returns.
#must_use
fn lyman_series(z, n_max, n_out, nm_out, cap): Result {
    var t, v = _tm_series(z, 1, n_max, n_out, nm_out, cap);
    if (is_err_result(t) == 1) { return Err(v); }
    return Ok(v);
}

# Balmer series n → 2 (visible and near-UV, 364.6–656.3 nm) for n = 3 ..= n_max. As
# lyman_series; Err for n_max < 3. Mirrors `balmer_series`.
#must_use
fn balmer_series(z, n_max, n_out, nm_out, cap): Result {
    var t, v = _tm_series(z, 2, n_max, n_out, nm_out, cap);
    if (is_err_result(t) == 1) { return Err(v); }
    return Ok(v);
}

# Paschen series n → 3 (near-infrared, 820.4–1875 nm) for n = 4 ..= n_max. As lyman_series;
# Err for n_max < 4. Mirrors `paschen_series`.
#must_use
fn paschen_series(z, n_max, n_out, nm_out, cap): Result {
    var t, v = _tm_series(z, 3, n_max, n_out, nm_out, cap);
    if (is_err_result(t) == 1) { return Err(v); }
    return Ok(v);
}

# Brackett series n → 4 (infrared, 1458–4051 nm) for n = 5 ..= n_max. As lyman_series; Err for
# n_max < 5. Mirrors `brackett_series`.
#must_use
fn brackett_series(z, n_max, n_out, nm_out, cap): Result {
    var t, v = _tm_series(z, 4, n_max, n_out, nm_out, cap);
    if (is_err_result(t) == 1) { return Err(v); }
    return Ok(v);
}

# Pfund series n → 5 (far-infrared, 2279–7460 nm) for n = 6 ..= n_max. As lyman_series; Err
# for n_max < 6. Mirrors `pfund_series`.
#must_use
fn pfund_series(z, n_max, n_out, nm_out, cap): Result {
    var t, v = _tm_series(z, 5, n_max, n_out, nm_out, cap);
    if (is_err_result(t) == 1) { return Err(v); }
    return Ok(v);
}

# ── Zeeman and Stark effects ────────────────────────────────────────────────────────

# The Landé g-factor of a single-electron level, g_J = 1 + [J(J+1) + S(S+1) − L(L+1)]/[2J(J+1)]
# with S = 1/2, L = l and J = j (passed as 2j). 0.0 when j is not l ± 1/2. Mirrors
# `lande_g_factor`.
#must_use
fn lande_g_factor(l, two_j): f64 {
    if (_tm_u32_ok(l) != 1 || _tm_u32_ok(two_j) != 1) { return _tm_nan(); }
    if (two_j + 1 != 2 * l + 2 && two_j + 1 != 2 * l) { return 0.0; }
    var j: f64 = f64_from(two_j) / 2.0;
    var lf: f64 = f64_from(l);
    var s: f64 = 0.5;
    var jj: f64 = j * (j + 1.0);
    if (jj < 0.000000000000000000000000000001) { return 0.0; }
    var g: f64 = 1.0 + (((jj + (s * (s + 1.0))) - (lf * (lf + 1.0))) / (2.0 * jj));
    return g;
}

# The weak-field (anomalous) Zeeman shift, eV: ΔE = m_j g_J μ_B B, with m_j passed as 2m_j
# (not validated, as in Rust). Mirrors `zeeman_splitting_ev`.
#must_use
fn zeeman_splitting_ev(l, two_j, two_mj, b_tesla: f64): f64 {
    if (_tm_i32_ok(two_mj) != 1) { return _tm_nan(); }
    var mj: f64 = f64_from(two_mj) / 2.0;
    var g: f64 = lande_g_factor(l, two_j);
    var e: f64 = ((mj * g) * TM_BOHR_MAGNETON_EV_T) * b_tesla;
    return e;
}

# The linear Stark shift of hydrogen, eV: ΔE = (3/2) n k e a₀ F, k = n₁ − n₂ the parabolic
# index (|k| ≤ n − 1) and F in V/m. 0.0 for n = 0 or |k| > n − 1. Mirrors
# `stark_shift_hydrogen_ev`.
#must_use
fn stark_shift_hydrogen_ev(n, parabolic_index, e_field_v_per_m: f64): f64 {
    if (_tm_u32_ok(n) != 1 || _tm_i32_ok(parabolic_index) != 1) { return _tm_nan(); }
    var ak = parabolic_index;
    if (ak < 0) { ak = 0 - ak; }
    if (n == 0 || ak > n - 1) { return 0.0; }
    var e: f64 = (((1.5 * f64_from(n)) * f64_from(parabolic_index)) * TM_BOHR_RADIUS) * e_field_v_per_m;
    return e;
}

# ── radial wavefunctions ────────────────────────────────────────────────────────────

# Writes the n coefficients c_i (index = power of ρ) of P(ρ) = ρ^l L_{n−l−1}^{(2l+1)}(ρ) to
# coeffs[] and returns the normalization N of R_nl = N P(ρ) e^{−ρ/2}, ρ = 2Zr/(n a₀), in
# a₀^{−3/2}: Rust's hydrogen_radial_polynomial, operation for operation. Needs 1 ≤ n ≤ 60,
# l < n.
#must_use
fn _tm_radial_poly(z, n, l, coeffs): f64 {
    var k = n - l - 1;
    var alpha = 2 * l + 1;
    var i = 0;
    while (i < n) { store64(coeffs + i * 8, 0.0); i = i + 1; }
    # L_k^α(x) = Σ_i (−1)^i C(k+α, k−i) x^i / i!
    i = 0;
    while (i <= k) {
        var binom: f64 = 1.0;
        var top = k + alpha;
        var choose = k - i;
        var t = 0;
        while (t < choose) {
            binom = binom * (f64_from(top - t) / f64_from(t + 1));
            t = t + 1;
        }
        var fact: f64 = 1.0;
        t = 1;
        while (t <= i) {
            fact = fact * f64_from(t);
            t = t + 1;
        }
        var sign: f64 = 1.0;
        if ((i & 1) == 1) { sign = -1.0; }
        var c: f64 = (sign * binom) / fact;
        store64(coeffs + (l + i) * 8, c);
        i = i + 1;
    }
    # N = sqrt((2Z/n)³ (n−l−1)! / (2n (n+l)!)), the factorial ratio as 1/Π_{i=n−l}^{n+l} i.
    var zf: f64 = f64_from(z);
    var nf: f64 = f64_from(n);
    var ratio: f64 = 1.0;
    var u = n - l;
    while (u <= n + l) {
        ratio = ratio / f64_from(u);
        u = u + 1;
    }
    var scale: f64 = (2.0 * zf) / nf;
    var norm: f64 = f64_sqrt((((scale * scale) * scale) * ratio) / (2.0 * nf));
    return norm;
}

# The radial wavefunction R_nl(r) of a hydrogen-like atom, infinite nuclear mass, in a₀^{−3/2}:
# R_nl = N ρ^l e^{−ρ/2} L_{n−l−1}^{(2l+1)}(ρ), ρ = 2Zr/(n a₀), normalized so ∫ R² r² dr = 1;
# r in units of a₀. Err(TM_ERR_INVALID_QUANTUM_NUMBERS) unless 1 ≤ n ≤ 60 and l < n, then
# Err(TM_ERR_INVALID_ATOMIC_NUMBER) for Z = 0. Mirrors `radial_wavefunction`.
#must_use
fn radial_wavefunction(z, n, l, r_bohr: f64): Result {
    if (n < 1 || n > 60) { return Err(TM_ERR_INVALID_QUANTUM_NUMBERS); }
    if (l < 0 || l >= n) { return Err(TM_ERR_INVALID_QUANTUM_NUMBERS); }
    if (z == 0 || _tm_u32_ok(z) != 1) { return Err(TM_ERR_INVALID_ATOMIC_NUMBER); }
    var c[480];
    var norm: f64 = _tm_radial_poly(z, n, l, &c);
    var rho: f64 = ((2.0 * f64_from(z)) * r_bohr) / f64_from(n);
    var poly: f64 = 0.0;
    var k = n - 1;
    while (k >= 0) {
        var ck: f64 = load64(&c + k * 8);
        poly = (poly * rho) + ck;
        k = k - 1;
    }
    var mrho: f64 = -rho;
    var e: f64 = f64_exp(mrho / 2.0);
    var r: f64 = (norm * poly) * e;
    return Ok(r);
}

# The radial probability density |R_nl(r)|² r², per unit r (a₀⁻¹). Errors as
# radial_wavefunction. Mirrors `radial_probability_density`.
#must_use
fn radial_probability_density(z, n, l, r_bohr: f64): Result {
    var t, v = radial_wavefunction(z, n, l, r_bohr);
    if (is_err_result(t) == 1) { return Err(v); }
    var rnl: f64 = v;
    var p: f64 = ((rnl * rnl) * r_bohr) * r_bohr;
    return Ok(p);
}

# ⟨n l | r | n2 l2⟩ = ∫ R_nl R_n2l2 r³ dr, exactly, in units of a₀/Z: Rust's
# radial_dipole_integral. Each term is c1_i c2_j (2/n)^i (2/n2)^j p!/c^{p+1}, p = i + j + 3,
# c = 1/n + 1/n2. The pow factors are computed once per i and per j, and p!/c^{p+1} as the
# running product (1/c)(1/c)(2/c)···(p/c): the same calls and the same multiplications as
# Rust's loops, so the same bits, without recomputing them per term.
#must_use
fn _tm_radial_dipole(n, l, n2, l2): f64 {
    var c1[480];
    var c2[480];
    var norm1: f64 = _tm_radial_poly(1, n, l, &c1);
    var norm2: f64 = _tm_radial_poly(1, n2, l2, &c2);
    var s1: f64 = 2.0 / f64_from(n);
    var s2: f64 = 2.0 / f64_from(n2);
    var decay: f64 = (1.0 / f64_from(n)) + (1.0 / f64_from(n2));
    var p1[480];
    var p2[480];
    var i = 0;
    while (i < n) {
        var pa: f64 = ganita_f64_pow(s1, f64_from(i));
        store64(&p1 + i * 8, pa);
        i = i + 1;
    }
    var j = 0;
    while (j < n2) {
        var pb: f64 = ganita_f64_pow(s2, f64_from(j));
        store64(&p2 + j * 8, pb);
        j = j + 1;
    }
    var integ[976];   # p!/c^{p+1} for p = 0 ..= n + n2 + 1 ≤ 121
    var run: f64 = 1.0 / decay;
    store64(&integ, run);
    var p = 1;
    while (p <= n + n2 + 1) {
        run = run * (f64_from(p) / decay);
        store64(&integ + p * 8, run);
        p = p + 1;
    }
    var total: f64 = 0.0;
    i = 0;
    while (i < n) {
        var a: f64 = load64(&c1 + i * 8);
        if (a != 0.0) {
            var ap: f64 = load64(&p1 + i * 8);
            j = 0;
            while (j < n2) {
                var b: f64 = load64(&c2 + j * 8);
                if (b != 0.0) {
                    var bp: f64 = load64(&p2 + j * 8);
                    var integral: f64 = load64(&integ + (i + j + 3) * 8);
                    total = total + ((((a * b) * ap) * bp) * integral);
                }
                j = j + 1;
            }
        }
        i = i + 1;
    }
    var r: f64 = (norm1 * norm2) * total;
    return r;
}

# ── selection rules and transition probabilities ────────────────────────────────────

# TM_TRANSITION_TYPE_ELECTRIC_DIPOLE when |l1 − l2| = 1 (E1-allowed for a hydrogen-like atom),
# else TM_TRANSITION_TYPE_FORBIDDEN. Mirrors `check_selection_rules`.
#must_use
fn check_selection_rules(l1, l2): i64 {
    if (_tm_u32_ok(l1) != 1 || _tm_u32_ok(l2) != 1) { return TM_TRANSITION_TYPE_FORBIDDEN; }
    var d = l1 - l2;
    if (d == 1 || d == (0 - 1)) { return TM_TRANSITION_TYPE_ELECTRIC_DIPOLE; }
    return TM_TRANSITION_TYPE_FORBIDDEN;
}

# As check_selection_rules, also requiring Δm_l ∈ {−1, 0, 1}. Mirrors
# `check_selection_rules_full`.
#must_use
fn check_selection_rules_full(l1, ml1, l2, ml2): i64 {
    if (_tm_i32_ok(ml1) != 1 || _tm_i32_ok(ml2) != 1) { return TM_TRANSITION_TYPE_FORBIDDEN; }
    if (check_selection_rules(l1, l2) != TM_TRANSITION_TYPE_ELECTRIC_DIPOLE) { return TM_TRANSITION_TYPE_FORBIDDEN; }
    var dm = ml1 - ml2;
    if (dm >= (0 - 1) && dm <= 1) { return TM_TRANSITION_TYPE_ELECTRIC_DIPOLE; }
    return TM_TRANSITION_TYPE_FORBIDDEN;
}

# The Einstein A coefficient, s⁻¹, of the E1 transition (n_u, l_u) → (n_l, l_l) in a
# hydrogen-like ion, summed over final and averaged over initial substates (infinite nuclear
# mass, non-relativistic): A = (4/3) α³ ω³ max(l_u, l_l)/(2l_u + 1) |⟨n_l l_l|r|n_u l_u⟩|² in
# atomic units, with the exact radial integral, so A ∝ Z⁴. H Lyα: 6.2684e8 s⁻¹ (times μ/m_e,
# 6.2649e8, as NIST ASD). Err(TM_ERR_INVALID_QUANTUM_NUMBERS) for Δl ≠ ±1, n_u ≤ n_l, n_l = 0,
# l ≥ n on either level or n_u > 60; then Err(TM_ERR_INVALID_ATOMIC_NUMBER) for Z = 0. Mirrors
# `einstein_a_coefficient`.
#must_use
fn einstein_a_coefficient(z, n_upper, l_upper, n_lower, l_lower): Result {
    if (_tm_u32_ok(z) != 1) { return Err(TM_ERR_INVALID_ATOMIC_NUMBER); }
    if (_tm_u32_ok(n_upper) != 1 || _tm_u32_ok(n_lower) != 1) { return Err(TM_ERR_INVALID_QUANTUM_NUMBERS); }
    if (check_selection_rules(l_upper, l_lower) == TM_TRANSITION_TYPE_FORBIDDEN) {
        return Err(TM_ERR_INVALID_QUANTUM_NUMBERS);
    }
    if (n_upper <= n_lower) { return Err(TM_ERR_INVALID_QUANTUM_NUMBERS); }
    if (n_lower == 0 || l_upper >= n_upper || l_lower >= n_lower || n_upper > 60) {
        return Err(TM_ERR_INVALID_QUANTUM_NUMBERS);
    }
    if (z == 0) { return Err(TM_ERR_INVALID_ATOMIC_NUMBER); }
    var zf: f64 = f64_from(z);
    var nu: f64 = f64_from(n_upper);
    var nl: f64 = f64_from(n_lower);
    var omega: f64 = ((zf * zf) * 0.5) * ((1.0 / (nl * nl)) - (1.0 / (nu * nu)));
    var dip: f64 = _tm_radial_dipole(n_upper, l_upper, n_lower, l_lower);
    var radial: f64 = dip / zf;
    var l_max = l_upper;
    if (l_lower > l_upper) { l_max = l_lower; }
    var angular: f64 = f64_from(l_max) / f64_from(2 * l_upper + 1);
    var alpha3: f64 = (TM_FINE_STRUCTURE * TM_FINE_STRUCTURE) * TM_FINE_STRUCTURE;
    var rate: f64 = ((((((4.0 / 3.0) * alpha3) * omega) * omega) * omega) * angular) * radial;
    rate = rate * radial;
    var a: f64 = rate / TM_ATOMIC_UNIT_TIME_S;
    return Ok(a);
}

# The Einstein B coefficient for stimulated emission, m³/(J·s²): B₂₁ = A₂₁ c³/(8π h ν³), ν the
# transition frequency (infinite nuclear mass), for the spectral energy density per unit
# frequency; absorption follows from g₁B₁₂ = g₂B₂₁. Errors as einstein_a_coefficient. Mirrors
# `einstein_b_coefficient`.
#must_use
fn einstein_b_coefficient(z, n_upper, l_upper, n_lower, l_lower): Result {
    var t, v = einstein_a_coefficient(z, n_upper, l_upper, n_lower, l_lower);
    if (is_err_result(t) == 1) { return Err(v); }
    var a21: f64 = v;
    var zf: f64 = f64_from(z);
    var n1: f64 = f64_from(n_lower);
    var n2: f64 = f64_from(n_upper);
    var de: f64 = ((TM_RYDBERG_EV * zf) * zf) * ((1.0 / (n1 * n1)) - (1.0 / (n2 * n2)));
    var freq: f64 = de / TM_H_EV_S;
    var hj: f64 = TM_H_EV_S * TM_ELEMENTARY_CHARGE;
    if (freq <= 0.0) { return Ok(0.0); }
    var f3: f64 = freq * (freq * freq);   # Rust's powi(3), as LLVM expands it
    var num: f64 = ((a21 * TM_C) * TM_C) * TM_C;
    var b: f64 = num / (((8.0 * _TM_PI) * hj) * f3);
    return Ok(b);
}

# --- atomic_qed.cyr ---

# atomic_qed.cyr — QED and relativistic corrections to hydrogen-like levels: the one-loop Lamb
# shift with Bethe logarithms, vacuum polarization, the exact Dirac energies, the hyperfine
# splitting, the free and bound electron g-factors, the strong-field Zeeman shift and the Breit
# interaction (port of the last part of rust-old/src/atomic.rs).
#
# Rust's evaluation order is kept, parenthesized. Only the Lamb shift calls a transcendental
# (ln, for s states): class C. Everything else is arithmetic and sqrt: class B, bit-identical.
# Rust's powi(4) is (x·x)·(x·x), as LLVM expands it. Integer arguments follow atomic_config.cyr.

# (Zα)⁴ by Rust's powi(4) expansion.
#must_use
fn _tm_pow4(x: f64): f64 {
    var x2: f64 = x * x;
    var x4: f64 = x2 * x2;
    return x4;
}

# (α/π)(Zα)⁴ m_e c² / n³ in eV: the common prefactor of the Lamb shift and the vacuum
# polarization, in Rust's order.
#must_use
fn _tm_qed_prefactor(za: f64, nf: f64): f64 {
    var za4: f64 = _tm_pow4(za);
    var p: f64 = ((((TM_FINE_STRUCTURE / _TM_PI) * za4) * TM_ELECTRON_MASS_MEV) * 1000000.0) / ((nf * nf) * nf);
    return p;
}

# ── QED corrections ─────────────────────────────────────────────────────────────────

# The one-loop QED (Lamb) shift, eV, of the hydrogen-like level (n, l, j), j passed as 2j,
# infinite nuclear mass:
#   ΔE = (α/π)(Zα)⁴ m_e c²/n³ × [A₄₁ ln(Zα)⁻² + A₄₀ + Zα A₅₀],
#   self-energy A₄₁ = 4/3 δ_l0, A₄₀ = −(4/3) ln k₀(n,l) + 10/9 δ_l0 − (1 − δ_l0)/(2κ(2l+1)),
#   A₅₀ = (139/32 − 2 ln 2) π δ_l0; vacuum polarization (Uehling) A₄₀ = −4/15 δ_l0,
#   A₅₀ = (5/48) π δ_l0; κ = −(l+1) for j = l + 1/2 and l for j = l − 1/2
# (Eides, Grotch & Shelyuto, Phys. Rep. 342, 63 (2001); CODATA 2018). About 0.2% for hydrogen
# (2S½ − 2P½: 1059.6 MHz against 1057.845 MHz measured), 3% for He⁺, invalid at high Z.
# Err(TM_ERR_INVALID_QUANTUM_NUMBERS) for n = 0, l ≥ n, j ≠ l ± 1/2, or n > 4 (the Bethe
# logarithms of Drake & Swainson 1990 are tabulated for n ≤ 4). Mirrors `lamb_shift_nlj_ev`.
#must_use
fn lamb_shift_nlj_ev(z, n, l, two_j): Result {
    if (_tm_u32_ok(z) != 1) { return Err(TM_ERR_INVALID_ATOMIC_NUMBER); }
    if (_tm_u32_ok(n) != 1 || _tm_u32_ok(l) != 1 || _tm_u32_ok(two_j) != 1) {
        return Err(TM_ERR_INVALID_QUANTUM_NUMBERS);
    }
    if (n == 0 || l >= n || (two_j != 2 * l + 1 && two_j + 1 != 2 * l)) { return Err(TM_ERR_INVALID_QUANTUM_NUMBERS); }
    if (n > 4) { return Err(TM_ERR_INVALID_QUANTUM_NUMBERS); }
    var ln_k0: f64 = _TM_BETHE_LOG[(n * (n - 1)) / 2 + l];
    var za: f64 = f64_from(z) * TM_FINE_STRUCTURE;
    var nf: f64 = f64_from(n);
    var prefactor: f64 = _tm_qed_prefactor(za, nf);
    var coefficient: f64 = 0.0;
    if (l == 0) {
        var lg: f64 = f64_ln(1.0 / (za * za));
        var a41: f64 = (4.0 / 3.0) * lg;
        var a40: f64 = ((((-4.0) / 3.0) * ln_k0) + (10.0 / 9.0)) - (4.0 / 15.0);
        var a50: f64 = (((139.0 / 32.0) - (2.0 * _TM_LN2)) * _TM_PI) + ((5.0 / 48.0) * _TM_PI);
        coefficient = (a41 + a40) + (za * a50);
    } else {
        var lf: f64 = f64_from(l);
        var kappa: f64 = lf;
        if (two_j == 2 * l + 1) {
            var lp: f64 = lf + 1.0;
            kappa = -lp;
        }
        coefficient = (((-4.0) / 3.0) * ln_k0) - (1.0 / ((2.0 * kappa) * ((2.0 * lf) + 1.0)));
    }
    var e: f64 = prefactor * coefficient;
    return Ok(e);
}

# The one-loop QED (Lamb) shift, eV, of the hydrogen-like (n, l) level: nS½'s for s states,
# and for l > 0 the (2j+1)-weighted mean over j = l ± 1/2, where the κ terms cancel. 0.0 where
# lamb_shift_nlj_ev returns an Err (n = 0, l ≥ n, n > 4). Mirrors `lamb_shift_ev`.
#must_use
fn lamb_shift_ev(z, n, l): f64 {
    if (_tm_u32_ok(z) != 1 || _tm_u32_ok(n) != 1 || _tm_u32_ok(l) != 1) { return _tm_nan(); }
    if (l == 0) {
        var t0, v0 = lamb_shift_nlj_ev(z, n, 0, 1);
        if (is_ok(t0) == 1) {
            var s: f64 = v0;
            return s;
        }
        return 0.0;
    }
    var lo: f64 = 0.0;
    var hi: f64 = 0.0;
    var t1, v1 = lamb_shift_nlj_ev(z, n, l, 2 * l - 1);
    if (is_ok(t1) == 1) {
        var x1: f64 = v1;
        lo = x1;
    }
    var t2, v2 = lamb_shift_nlj_ev(z, n, l, 2 * l + 1);
    if (is_ok(t2) == 1) {
        var x2: f64 = v2;
        hi = x2;
    }
    var lf: f64 = f64_from(l);
    var e: f64 = (((2.0 * lf) * lo) + (((2.0 * lf) + 2.0) * hi)) / ((4.0 * lf) + 2.0);
    return e;
}

# The vacuum polarization (Uehling) shift, eV, of a hydrogen-like s level, infinite nuclear
# mass: ΔE_VP = (α/π)(Zα)⁴ m_e c²/n³ × [−4/15 + (5π/48) Zα]. Hydrogen 2S: −26.89 MHz. 0.0 for
# l > 0, where these terms vanish, and for n = 0. Mirrors `vacuum_polarization_ev`.
#must_use
fn vacuum_polarization_ev(z, n, l): f64 {
    if (_tm_u32_ok(z) != 1 || _tm_u32_ok(n) != 1 || _tm_u32_ok(l) != 1) { return _tm_nan(); }
    if (n == 0 || l >= n || l != 0) { return 0.0; }
    var za: f64 = f64_from(z) * TM_FINE_STRUCTURE;
    var nf: f64 = f64_from(n);
    var p: f64 = _tm_qed_prefactor(za, nf);
    var e: f64 = p * (((-4.0) / 15.0) + (((5.0 * _TM_PI) / 48.0) * za));
    return e;
}

# ── the Dirac equation ──────────────────────────────────────────────────────────────

# The exact Dirac energy, MeV (rest mass plus binding), of the hydrogen-like level (n, j), j
# passed as 2j: E = m_e c² / √(1 + [αZ/(n − δ)]²), δ = j + 1/2 − √((j + 1/2)² − (αZ)²).
# Err(TM_ERR_INVALID_QUANTUM_NUMBERS) for n = 0, 2j not odd in 1..=2n − 1, a supercritical
# αZ ≥ j + 1/2, or n − δ ≤ 0. Mirrors `dirac_energy_mev`.
#must_use
fn dirac_energy_mev(z, n, two_j): Result {
    if (_tm_u32_ok(z) != 1) { return Err(TM_ERR_INVALID_ATOMIC_NUMBER); }
    if (n == 0 || _tm_u32_ok(n) != 1 || _tm_u32_ok(two_j) != 1) { return Err(TM_ERR_INVALID_QUANTUM_NUMBERS); }
    if (two_j == 0 || (two_j & 1) == 0 || two_j > 2 * n - 1) { return Err(TM_ERR_INVALID_QUANTUM_NUMBERS); }
    var zf: f64 = f64_from(z);
    var nf: f64 = f64_from(n);
    var jph: f64 = (f64_from(two_j) + 1.0) / 2.0;
    var az: f64 = TM_FINE_STRUCTURE * zf;
    var az2: f64 = az * az;
    var disc: f64 = (jph * jph) - az2;
    if (disc <= 0.0) { return Err(TM_ERR_INVALID_QUANTUM_NUMBERS); }
    var delta: f64 = jph - f64_sqrt(disc);
    var n_eff: f64 = nf - delta;
    if (n_eff <= 0.0) { return Err(TM_ERR_INVALID_QUANTUM_NUMBERS); }
    var ratio: f64 = az / n_eff;
    var energy: f64 = TM_ELECTRON_MASS_MEV / f64_sqrt(1.0 + (ratio * ratio));
    return Ok(energy);
}

# The Dirac binding energy, eV: m_e c² − E_nj (positive when bound). Errors as
# dirac_energy_mev. Mirrors `dirac_binding_energy_ev`.
#must_use
fn dirac_binding_energy_ev(z, n, two_j): Result {
    var t, v = dirac_energy_mev(z, n, two_j);
    if (is_err_result(t) == 1) { return Err(v); }
    var ed: f64 = v;
    var b: f64 = (TM_ELECTRON_MASS_MEV - ed) * 1000000.0;
    return Ok(b);
}

# The total relativistic correction, eV: the Dirac binding energy less the non-relativistic
# ½α²m_ec² Z²/n², from the same constants, so every order of the fine structure is included.
# Errors as dirac_energy_mev. Mirrors `relativistic_correction_ev`.
#must_use
fn relativistic_correction_ev(z, n, two_j): Result {
    var t, v = dirac_binding_energy_ev(z, n, two_j);
    if (is_err_result(t) == 1) { return Err(v); }
    var bd: f64 = v;
    var zf: f64 = f64_from(z);
    var nf: f64 = f64_from(n);
    var ry: f64 = (((0.5 * TM_FINE_STRUCTURE) * TM_FINE_STRUCTURE) * TM_ELECTRON_MASS_MEV) * 1000000.0;
    var bn: f64 = ((ry * zf) * zf) / (nf * nf);
    var d: f64 = bd - bn;
    return Ok(d);
}

# ── hyperfine structure ─────────────────────────────────────────────────────────────

# The magnetic-dipole hyperfine splitting, eV, of an s state of a hydrogen-like ion, between
# F = I ± 1/2: ΔE = A (I + 1/2), A = (4/3) α⁴ Z³ g_I (m_e/m_p) m_e c²/n³ (Fermi contact term,
# leading order). Deuterium 1s (I = 1, g_d = 0.8574382335): 327.23 MHz (measured 327.384).
# 0.0 for n = 0 or I ≤ 0. Mirrors `hyperfine_splitting_spin_ev`.
#must_use
fn hyperfine_splitting_spin_ev(z, n, nuclear_g_factor: f64, nuclear_spin: f64): f64 {
    if (_tm_u32_ok(z) != 1 || _tm_u32_ok(n) != 1) { return _tm_nan(); }
    if (n == 0 || nuclear_spin <= 0.0) { return 0.0; }
    var zf: f64 = f64_from(z);
    var nf: f64 = f64_from(n);
    var fs: f64 = TM_FINE_STRUCTURE;
    var alpha4: f64 = ((fs * fs) * fs) * fs;
    var mass_ratio: f64 = TM_ELECTRON_MASS_MEV / TM_PROTON_MASS_MEV;
    var a: f64 = ((((((4.0 / 3.0) * alpha4) * zf) * zf) * zf) * mass_ratio) * nuclear_g_factor;
    a = ((a * TM_ELECTRON_MASS_MEV) * 1000000.0) / ((nf * nf) * nf);
    var e: f64 = a * (nuclear_spin + 0.5);
    return e;
}

# The hyperfine splitting, eV, of an s state with a spin-1/2 nucleus (hydrogen 1s: 5.8776e-6
# eV, 1421.2 MHz; measured 1420.406 MHz). hyperfine_splitting_spin_ev with I = 1/2. Mirrors
# `hyperfine_splitting_ev`.
#must_use
fn hyperfine_splitting_ev(z, n, nuclear_g_factor: f64): f64 {
    var e: f64 = hyperfine_splitting_spin_ev(z, n, nuclear_g_factor, 0.5);
    return e;
}

# ── g-factors, strong-field Zeeman, Breit ───────────────────────────────────────────

# The free-electron g-factor with QED, g_e = 2(1 + a_e) = 2.00231930436092 (CODATA 2022).
# Mirrors `electron_g_factor`.
#must_use
fn electron_g_factor(): f64 {
    var g: f64 = 2.0 * (1.0 + TM_ELECTRON_ANOMALOUS_MOMENT);
    return g;
}

# The bound-electron g-factor of the 1s state of a hydrogen-like ion: Breit's Dirac value
# (2/3)(1 + 2√(1 − (αZ)²)) times the free-electron (1 + a_e). 0.0 when (αZ)² ≥ 1. Mirrors
# `bound_electron_g_factor`.
#must_use
fn bound_electron_g_factor(z): f64 {
    if (_tm_u32_ok(z) != 1) { return _tm_nan(); }
    var az: f64 = TM_FINE_STRUCTURE * f64_from(z);
    var az2: f64 = az * az;
    if (az2 >= 1.0) { return 0.0; }
    var breit: f64 = (2.0 / 3.0) * (1.0 + (2.0 * f64_sqrt(1.0 - az2)));
    var g: f64 = breit * (1.0 + TM_ELECTRON_ANOMALOUS_MOMENT);
    return g;
}

# The strong-field (Paschen–Back) Zeeman shift, eV, with the QED g_e: ΔE = (m_l + g_e m_s) μ_B B,
# ms passed as ±1 for ±1/2. For weak fields use zeeman_splitting_ev. Mirrors
# `anomalous_zeeman_splitting_ev`.
#must_use
fn anomalous_zeeman_splitting_ev(b_tesla: f64, ml, ms): f64 {
    if (_tm_i32_ok(ml) != 1 || _tm_i32_ok(ms) != 1) { return _tm_nan(); }
    var g_e: f64 = electron_g_factor();
    var ms_half: f64 = f64_from(ms) / 2.0;
    var e: f64 = ((f64_from(ml) + (g_e * ms_half)) * TM_BOHR_MAGNETON_EV_T) * b_tesla;
    return e;
}

# The leading-order Breit (magnetic) interaction of the 1s² ¹S₀ ground state of a helium-like
# ion, eV: ΔE = α² Z³/4 E_h, the spin–spin contact term with unscreened hydrogenic orbitals
# (Bethe & Salpeter §38–39); the leading term of the 1/Z expansion, most useful for Z ≈ 10–40.
# Mirrors `breit_interaction_ev`.
#must_use
fn breit_interaction_ev(z): f64 {
    if (_tm_u32_ok(z) != 1) { return _tm_nan(); }
    var zf: f64 = f64_from(z);
    var hartree: f64 = 2.0 * TM_RYDBERG_EV;
    var e: f64 = (((((TM_FINE_STRUCTURE * TM_FINE_STRUCTURE) * zf) * zf) * zf) / 4.0) * hartree;
    return e;
}

