# --- nucleus.cyr ---

# nucleus.cyr — nuclear structure: the semi-empirical mass formula with the Myers–Swiatecki
# shell term, masses, radii, AME2020 / charge-radius / moment lookups, superallowed ft
# (port of rust-old/src/nucleus.rs; the shell model is in shell_model.cyr).
#
# A Nucleus is a packed word, z | (a << 32): the bytes of Rust's struct { z: u32, a: u32 }.
# A small struct can't round-trip through a value-form Result (a cyrius defect, filed as
# 2026-11-08-small-struct-result-payload-read-as-address), and a word can. Build one with
# nucleus_new (validated, a Result) or a preset.
#
# Every formula keeps Rust's operation order, with cbrt and sqrt correctly rounded on both
# sides, so the golden rows are class B (bit-identical expected). atomic_mass_amu goes
# through pow and is class C.

# A nucleus word from Z and A, without validation (presets and table reads).
#must_use
fn _tm_nuc(z, a): i64 {
    return z | (a << 32);
}

# A nucleus with atomic number z and mass number a. Err(TM_ERR_INVALID_ATOMIC_NUMBER) when
# z < 1; Err(TM_ERR_INVALID_MASS_NUMBER) when a < z. Rust's u32 bounds both from above:
# beyond 2^32 − 1 they are the same errors. Mirrors `Nucleus::new`.
#must_use
fn nucleus_new(z, a): Result {
    if (z < 1 || z > 0xFFFFFFFF) { return Err(TM_ERR_INVALID_ATOMIC_NUMBER); }
    if (a < z || a > 0xFFFFFFFF) { return Err(TM_ERR_INVALID_MASS_NUMBER); }
    return Ok(_tm_nuc(z, a));
}

# Atomic number Z (protons). Mirrors `Nucleus::z`.
#must_use
fn nucleus_z(n): i64 { return n & 0xFFFFFFFF; }

# Mass number A (nucleons). Mirrors `Nucleus::a`.
#must_use
fn nucleus_a(n): i64 { return n >> 32; }

# Neutron number N = A − Z. Mirrors `Nucleus::n`.
#must_use
fn nucleus_n(n): i64 { return nucleus_a(n) - nucleus_z(n); }

# Hydrogen-1 (the proton). Mirrors `Nucleus::hydrogen_1`.
#must_use
fn nucleus_hydrogen_1(): i64 { return _tm_nuc(1, 1); }

# Helium-4 (the alpha particle). Mirrors `Nucleus::helium_4`.
#must_use
fn nucleus_helium_4(): i64 { return _tm_nuc(2, 4); }

# Carbon-12. Mirrors `Nucleus::carbon_12`.
#must_use
fn nucleus_carbon_12(): i64 { return _tm_nuc(6, 12); }

# Iron-56. Mirrors `Nucleus::iron_56`.
#must_use
fn nucleus_iron_56(): i64 { return _tm_nuc(26, 56); }

# Uranium-235. Mirrors `Nucleus::uranium_235`.
#must_use
fn nucleus_uranium_235(): i64 { return _tm_nuc(92, 235); }

# Uranium-238. Mirrors `Nucleus::uranium_238`.
#must_use
fn nucleus_uranium_238(): i64 { return _tm_nuc(92, 238); }

# 1 if `n` is a nuclear magic number: 2, 8, 20, 28, 50, 82, 126. Mirrors `is_magic_number`.
#must_use
fn is_magic_number(n): i64 {
    if (n == 2 || n == 8 || n == 20 || n == 28 || n == 50 || n == 82 || n == 126) { return 1; }
    return 0;
}

# ── semi-empirical mass formula ─────────────────────────────────────────────────────

# The pairing term δ: +a_p/√A even-even, −a_p/√A odd-odd, 0 odd A (rust pairing_term).
#must_use
fn _tm_pairing_term(z, a): f64 {
    var n = a - z;
    var af: f64 = f64_from(a);
    var denom: f64 = f64_sqrt(af);
    if (denom == 0.0) { return 0.0; }
    if ((z & 1) == 0 && (n & 1) == 0) {
        var p: f64 = _TM_SEMF_A_P / denom;
        return p;
    }
    if ((z & 1) == 1 && (n & 1) == 1) {
        var neg: f64 = -_TM_SEMF_A_P;
        var m: f64 = neg / denom;
        return m;
    }
    return 0.0;
}

# Binding energy B(Z, A) in MeV, Bethe–Weizsäcker with the AME2020-fitted coefficients:
# a_v A − a_s A^(2/3) − a_c Z(Z − 1)/A^(1/3) − a_a (A − 2Z)²/A + δ. 0 for a single nucleon.
# Mirrors `Nucleus::binding_energy`.
#must_use
fn nucleus_binding_energy(n): f64 {
    var a = nucleus_a(n);
    var z = nucleus_z(n);
    if (a == 1) { return 0.0; }
    var af: f64 = f64_from(a);
    var zf: f64 = f64_from(z);
    var c: f64 = ganita_f64_cbrt(af);
    var a23: f64 = c * c;
    var volume: f64 = _TM_SEMF_A_V * af;
    var surface: f64 = _TM_SEMF_A_S * a23;
    var coulomb: f64 = ((_TM_SEMF_A_C * zf) * (zf - 1.0)) / c;
    var d: f64 = af - (2.0 * zf);
    var asym: f64 = (_TM_SEMF_A_A * (d * d)) / af;
    var delta: f64 = _tm_pairing_term(z, a);
    var b: f64 = (((volume - surface) - coulomb) - asym) + delta;
    return b;
}

# x^(5/3) as x · cbrt(x)², the oracle's form (rust pow_five_thirds).
#must_use
fn _tm_five_thirds(x: f64): f64 {
    var c: f64 = ganita_f64_cbrt(x);
    var r: f64 = (x * c) * c;
    return r;
}

# Myers–Swiatecki F(count) for one nucleon species, between the magic numbers M around it
# (rust myers_swiatecki_f).
#must_use
fn _tm_ms_f(count): f64 {
    var k = 0;
    while (k < 8) {
        var lo = _TM_MS_MAGIC[k];
        var hi = _TM_MS_MAGIC[k + 1];
        if (count <= hi) {
            var lo_f: f64 = f64_from(lo);
            var hi_f: f64 = f64_from(hi);
            var nf: f64 = f64_from(count);
            var lo53: f64 = _tm_five_thirds(lo_f);
            var q: f64 = (0.6 * (_tm_five_thirds(hi_f) - lo53)) / (hi_f - lo_f);
            var r: f64 = (q * (nf - lo_f)) - (0.6 * (_tm_five_thirds(nf) - lo53));
            return r;
        }
        k = k + 1;
    }
    return 0.0;
}

# The Myers–Swiatecki shell term S(N, Z) in MeV, positive where less bound
# (rust myers_swiatecki_shell_term).
#must_use
fn _tm_ms_shell_term(z, n): f64 {
    var af: f64 = f64_from(z + n);
    var c: f64 = ganita_f64_cbrt(af / 2.0);
    var half: f64 = c * c;
    var ca: f64 = ganita_f64_cbrt(af);
    var inner: f64 = ((_tm_ms_f(n) + _tm_ms_f(z)) / half) - (_TM_MS_SHELL_SMALL_C * ca);
    var s: f64 = _TM_MS_SHELL_C * inner;
    return s;
}

# Binding energy with the Myers–Swiatecki shell correction, B − S(N, Z), MeV; 0 for a single
# nucleon. Mirrors `Nucleus::binding_energy_shell_corrected`.
#must_use
fn nucleus_binding_energy_shell_corrected(n): f64 {
    if (nucleus_a(n) == 1) { return 0.0; }
    var b: f64 = nucleus_binding_energy(n);
    var s: f64 = _tm_ms_shell_term(nucleus_z(n), nucleus_n(n));
    var r: f64 = b - s;
    return r;
}

# Binding energy per nucleon B/A, MeV. Mirrors `Nucleus::binding_energy_per_nucleon`.
#must_use
fn nucleus_binding_energy_per_nucleon(n): f64 {
    var b: f64 = nucleus_binding_energy(n);
    var r: f64 = b / f64_from(nucleus_a(n));
    return r;
}

# Mass defect in MeV/c², which is the binding energy itself. Mirrors `Nucleus::mass_defect`.
#must_use
fn nucleus_mass_defect(n): f64 {
    var b: f64 = nucleus_binding_energy(n);
    return b;
}

# Nuclear mass M = Z m_p + N m_n − B, MeV/c². Mirrors `Nucleus::nuclear_mass`.
#must_use
fn nucleus_nuclear_mass(n): f64 {
    var zf: f64 = f64_from(nucleus_z(n));
    var nf: f64 = f64_from(nucleus_n(n));
    var b: f64 = nucleus_binding_energy(n);
    var m: f64 = ((zf * TM_PROTON_MASS_MEV) + (nf * TM_NEUTRON_MASS_MEV)) - b;
    return m;
}

# Atomic mass in u, M_atom = M_nucleus + Z m_e − B_e(Z), with the electron binding
# B_e = 14.4381 Z^2.39 + 1.55468e-6 Z^5.35 eV (Lunney, Pearson & Thibault 2003, eq. A4).
# Mirrors `Nucleus::atomic_mass_amu`.
#must_use
fn nucleus_atomic_mass_amu(n): f64 {
    var zf: f64 = f64_from(nucleus_z(n));
    var p1: f64 = ganita_f64_pow(zf, 2.39);
    var p2: f64 = ganita_f64_pow(zf, 5.35);
    var eb: f64 = ((14.4381 * p1) + (0.00000155468 * p2)) * 0.000001;
    var m: f64 = nucleus_nuclear_mass(n);
    var r: f64 = ((m + (zf * TM_ELECTRON_MASS_MEV)) - eb) / TM_AMU_MEV;
    return r;
}

# Nuclear mass in u. Mirrors `Nucleus::nuclear_mass_amu`.
#must_use
fn nucleus_nuclear_mass_amu(n): f64 {
    var m: f64 = nucleus_nuclear_mass(n);
    var r: f64 = m / TM_AMU_MEV;
    return r;
}

# Nuclear radius R = r₀ A^(1/3), fm. Mirrors `Nucleus::nuclear_radius`.
#must_use
fn nucleus_nuclear_radius(n): f64 {
    var c: f64 = ganita_f64_cbrt(f64_from(nucleus_a(n)));
    var r: f64 = TM_R0_FM * c;
    return r;
}

# 1 if Z or N is magic. Mirrors `Nucleus::is_magic`.
#must_use
fn nucleus_is_magic(n): i64 {
    if (is_magic_number(nucleus_z(n)) == 1 || is_magic_number(nucleus_n(n)) == 1) { return 1; }
    return 0;
}

# 1 if Z and N are both magic. Mirrors `Nucleus::is_doubly_magic`.
#must_use
fn nucleus_is_doubly_magic(n): i64 {
    if (is_magic_number(nucleus_z(n)) == 1 && is_magic_number(nucleus_n(n)) == 1) { return 1; }
    return 0;
}

# ── tabulated data ──────────────────────────────────────────────────────────────────

# The AME2020 row of nucleus n, or -1.
#must_use
fn _tm_ame_row(n): i64 {
    var z = nucleus_z(n);
    var a = nucleus_a(n);
    var k = 0;
    while (k < TM_AME2020_COUNT) {
        if (TM_AME2020_Z[k] == z && TM_AME2020_A[k] == a) { return k; }
        k = k + 1;
    }
    return 0 - 1;
}

# The AME2020 mass excess in keV: Some(f64), or None when the nuclide isn't tabulated.
# Mirrors `Nucleus::experimental_mass_excess_kev`.
#must_use
fn nucleus_experimental_mass_excess_kev(n): Option {
    var k = _tm_ame_row(n);
    if (k < 0) { return None(); }
    var me: f64 = TM_AME2020_MASS_EXCESS_KEV[k];
    return Some(me);
}

# The AME2020 atomic mass in u, A + excess / (931494.10242 keV): Some(f64), or None.
# Mirrors `Nucleus::experimental_atomic_mass_amu`.
#must_use
fn nucleus_experimental_atomic_mass_amu(n): Option {
    var k = _tm_ame_row(n);
    if (k < 0) { return None(); }
    var me: f64 = TM_AME2020_MASS_EXCESS_KEV[k];
    var m: f64 = f64_from(nucleus_a(n)) + (me / _TM_AME2020_U_KEV);
    return Some(m);
}

# The RMS charge radius in fm (Angeli & Marinova 2013): Some(f64), or None. Mirrors
# `Nucleus::charge_radius_fm`.
#must_use
fn nucleus_charge_radius_fm(n): Option {
    var z = nucleus_z(n);
    var a = nucleus_a(n);
    var k = 0;
    while (k < TM_CHARGE_RADII_COUNT) {
        if (TM_CHARGE_RADII_Z[k] == z && TM_CHARGE_RADII_A[k] == a) {
            var r: f64 = TM_CHARGE_RADII_FM[k];
            return Some(r);
        }
        k = k + 1;
    }
    return None();
}

# Nuclear electromagnetic moments (Stone 2019 / 2021). Mirrors `NuclearMoments`.
struct TmNuclearMoments {
    magnetic_dipole_mu_n: f64;
    electric_quadrupole_barn: f64;
}

# Writes the nucleus's magnetic dipole (μ_N) and electric quadrupole (barn) moments to *out
# and returns 1, or returns 0 when the nuclide isn't tabulated. A 16-byte struct can't ride
# a value-form Option, so this mirrors `Nucleus::nuclear_moments` through an out-pointer.
#must_use
fn nucleus_nuclear_moments(n, out: *TmNuclearMoments): i64 {
    var z = nucleus_z(n);
    var a = nucleus_a(n);
    var k = 0;
    while (k < TM_NUCLEAR_MOMENTS_COUNT) {
        if (TM_NUCLEAR_MOMENTS_Z[k] == z && TM_NUCLEAR_MOMENTS_A[k] == a) {
            var mu: f64 = TM_NUCLEAR_MOMENTS_MU_N[k];
            var q: f64 = TM_NUCLEAR_MOMENTS_Q_BARN[k];
            out.magnetic_dipole_mu_n = mu;
            out.electric_quadrupole_barn = q;
            return 1;
        }
        k = k + 1;
    }
    return 0;
}

# ── superallowed 0+ → 0+ beta decay ─────────────────────────────────────────────────

# A superallowed transition: parent and daughter nucleus words and the measured ft, s.
# Mirrors `SuperallowedDecay`.
struct TmSuperallowedDecay {
    parent: i64;
    daughter: i64;
    ft_seconds: f64;
}

impl TmSuperallowedDecay {
    # The corrected Ft = ft(1 + δ'_R)(1 + δ_NS − δ_C), s, of this parent → daughter pair
    # (Hardy & Towner 2020, Table XVI): Some(f64), or None when the pair isn't tabulated.
    # Mirrors `SuperallowedDecay::corrected_ft_seconds`.
    #must_use
    fn corrected_ft_seconds(self): Option {
        var k = 0;
        while (k < TM_SUPERALLOWED_COUNT) {
            var p = _tm_nuc(TM_SUPERALLOWED_PARENT_Z[k], TM_SUPERALLOWED_PARENT_A[k]);
            var d = _tm_nuc(TM_SUPERALLOWED_DAUGHTER_Z[k], TM_SUPERALLOWED_DAUGHTER_A[k]);
            if (p == self.parent && d == self.daughter) {
                var big: f64 = TM_SUPERALLOWED_CORRECTED_FT_SECONDS[k];
                return Some(big);
            }
            k = k + 1;
        }
        return None();
    }
}

# How many superallowed transitions are tabulated. With superallowed_ft_value(k) this mirrors
# the Vec `superallowed_ft_values` returns.
#must_use
fn superallowed_ft_value_count(): i64 { return TM_SUPERALLOWED_COUNT; }

# The k-th tabulated superallowed transition, in Hardy & Towner's order; k must be in range.
#must_use
fn superallowed_ft_value(k): TmSuperallowedDecay {
    var d: TmSuperallowedDecay;
    d.parent = _tm_nuc(TM_SUPERALLOWED_PARENT_Z[k], TM_SUPERALLOWED_PARENT_A[k]);
    d.daughter = _tm_nuc(TM_SUPERALLOWED_DAUGHTER_Z[k], TM_SUPERALLOWED_DAUGHTER_A[k]);
    d.ft_seconds = TM_SUPERALLOWED_FT_SECONDS[k];
    return d;
}

# The world-average corrected Ft and its total uncertainty, s: (3072.24, 1.85) (Hardy &
# Towner 2020, eq. 22), as a pair `var ft, unc = superallowed_average_ft();`. Mirrors
# `superallowed_average_ft`.
#must_use
fn superallowed_average_ft() {
    var ft: f64 = TM_SUPERALLOWED_AVERAGE_FT_SECONDS;
    var unc: f64 = TM_SUPERALLOWED_AVERAGE_FT_UNCERTAINTY;
    return (ft, unc);
}

# --- shell_model.cyr ---

# shell_model.cyr — the nuclear shell model: Mayer–Jensen levels, occupation, closures and
# ground-state J^π (port of the shell-model half of rust-old/src/nucleus.rs).
#
# A ShellLevel is `struct TmShellLevel { n_shell; l; two_j; }`, Rust's struct with its public
# u32 fields, and an impl for degeneracy, j and label. (Through M3 it was a 21-bit packed word,
# which a hand-built level with a field ≥ 2^21 broke.) An array of levels is reached through a
# typed pointer, `var base: *TmShellLevel = &lvs;` then `base + k`; `&lvs + k` steps by bytes.
# The tables are the generated nucleus_data.cyr. Everything here is integer logic, so the golden
# rows are class A.

# A nuclear shell-model single-particle level (n_shell, l, 2j), j = l ± 1/2. Mirrors
# `ShellLevel`.
struct TmShellLevel {
    n_shell: i64;
    l: i64;
    two_j: i64;
}

impl TmShellLevel {
    # A shell level from its quantum numbers (n_shell, l, 2j). Mirrors constructing `ShellLevel`.
    #must_use
    fn new(n_shell, l, two_j): TmShellLevel {
        var lv: TmShellLevel;
        lv.n_shell = n_shell;
        lv.l = l;
        lv.two_j = two_j;
        return lv;
    }

    # The degeneracy 2j + 1. Mirrors `ShellLevel::degeneracy`.
    #must_use
    fn degeneracy(self): i64 { return self.two_j + 1; }

    # j as an f64. Mirrors `ShellLevel::j`.
    #must_use
    fn j(self): f64 {
        var j: f64 = f64_from(self.two_j) / 2.0;
        return j;
    }

    # The spectroscopic label, e.g. "1s1/2" or "1h11/2"; l > 6 is '?'. Mirrors `ShellLevel::label`.
    #must_use
    fn label(self): Str {
        var l = self.l;
        var c = 63;
        if (l == 0) { c = 115; }
        elif (l == 1) { c = 112; }
        elif (l == 2) { c = 100; }
        elif (l == 3) { c = 102; }
        elif (l == 4) { c = 103; }
        elif (l == 5) { c = 104; }
        elif (l == 6) { c = 105; }
        var sb = str_builder_new();
        str_builder_add_int(sb, self.n_shell);
        str_builder_putc(sb, c);
        str_builder_add_int(sb, self.two_j);
        str_builder_add_cstr(sb, "/2");
        return str_builder_build(sb);
    }
}

# How many Mayer–Jensen levels are tabulated (32, through 3f7/2). With shell_model_level(k)
# this mirrors the slice `shell_model_levels` returns.
#must_use
fn shell_model_level_count(): i64 { return TM_SHELL_LEVEL_COUNT; }

# The k-th Mayer–Jensen level in energy order, or (0, 0, 0) when k is out of range.
#must_use
fn shell_model_level(k): TmShellLevel {
    var lv: TmShellLevel;
    lv.n_shell = 0;
    lv.l = 0;
    lv.two_j = 0;
    if (k >= 0 && k < TM_SHELL_LEVEL_COUNT) {
        lv.n_shell = TM_SHELL_LEVEL_N_SHELL[k];
        lv.l = TM_SHELL_LEVEL_L[k];
        lv.two_j = TM_SHELL_LEVEL_TWO_J[k];
    }
    return lv;
}

# Fills the Mayer–Jensen levels with `nucleon_count` nucleons in order. It writes up to `cap`
# (level, occupation) pairs to levels_out[] (TmShellLevel) and occ_out[] (i64) and returns how
# many levels hold nucleons. Mirrors the Vec `shell_occupation` returns. 32 entries always
# suffice.
#must_use
fn shell_occupation(nucleon_count, levels_out: *TmShellLevel, occ_out, cap): i64 {
    var remaining = nucleon_count;
    var n = 0;
    var k = 0;
    while (k < TM_SHELL_LEVEL_COUNT && remaining > 0) {
        var two_j = TM_SHELL_LEVEL_TWO_J[k];
        var deg = two_j + 1;
        var fill = remaining;
        if (remaining >= deg) { fill = deg; }
        if (n < cap) {
            var d: *TmShellLevel = levels_out + n;
            d.n_shell = TM_SHELL_LEVEL_N_SHELL[k];
            d.l = TM_SHELL_LEVEL_L[k];
            d.two_j = two_j;
            store64(occ_out + n * 8, fill);
        }
        n = n + 1;
        remaining = remaining - fill;
        k = k + 1;
    }
    return n;
}

# l of level k of the empirical proton (species 0) or neutron (species 1) filling order.
#must_use
fn _tm_order_l(species, k): i64 {
    if (species == 0) { return _TM_PROTON_ORDER_L[k]; }
    return _TM_NEUTRON_ORDER_L[k];
}

# 2j of level k of the species' order.
#must_use
fn _tm_order_two_j(species, k): i64 {
    if (species == 0) { return _TM_PROTON_ORDER_TWO_J[k]; }
    return _TM_NEUTRON_ORDER_TWO_J[k];
}

# The index in the species' order of the level holding the last of `count` nucleons, and how
# many occupy it, as a pair. Past the table (count > 184), it is the last listed level with
# occupation 1: rust last_filled_level, then `unwrap_or_else`. The walk reads only the 2j column.
fn _tm_last_filled(species, count) {
    var remaining = count;
    var k = 0;
    while (k < 32) {
        var deg = _tm_order_two_j(species, k) + 1;
        if (remaining <= deg) { return (k, remaining); }
        remaining = remaining - deg;
        k = k + 1;
    }
    return (31, 1);
}

# +1 for even l, −1 for odd.
#must_use
fn _tm_parity_of(l): i64 {
    if ((l & 1) == 0) { return 1; }
    return 0 - 1;
}

# The ground-state spin and parity in the extreme single-particle shell model, as a pair
# `var two_j, parity = ground_state_spin_parity(n);` (parity +1 or −1):
# - even-even: 0+;
# - odd A: the unpaired nucleon's level, in the empirical proton / neutron orders;
# - odd-odd: parity (−1)^(l_p + l_n), with spin by the Brennan–Bernstein rules. A particle–hole
#   pair gives j_p + j_n − 1; otherwise the Nordheim number gives |j_p − j_n| or j_p + j_n.
# Mirrors `ground_state_spin_parity`.
#must_use
fn ground_state_spin_parity(n) {
    var z = nucleus_z(n);
    var nn = nucleus_n(n);
    var z_odd = z & 1;
    var n_odd = nn & 1;
    if (z_odd == 0 && n_odd == 0) { return (0, 1); }
    if (z_odd == 1 && n_odd == 0) {
        var p, po = _tm_last_filled(0, z);
        return (_tm_order_two_j(0, p), _tm_parity_of(_tm_order_l(0, p)));
    }
    if (z_odd == 0 && n_odd == 1) {
        var q, qo = _tm_last_filled(1, nn);
        return (_tm_order_two_j(1, q), _tm_parity_of(_tm_order_l(1, q)));
    }
    var pk, p_occ = _tm_last_filled(0, z);
    var nk, n_occ = _tm_last_filled(1, nn);
    var pj = _tm_order_two_j(0, pk);
    var nj = _tm_order_two_j(1, nk);
    var pl = _tm_order_l(0, pk);
    var nl = _tm_order_l(1, nk);
    var parity = _tm_parity_of(pl + nl);
    var p_hole = 0;
    if (p_occ > (pj + 1) / 2) { p_hole = 1; }
    var n_hole = 0;
    if (n_occ > (nj + 1) / 2) { n_hole = 1; }
    var sign_p = pj - 2 * pl;
    var sign_n = nj - 2 * nl;
    var two_j = pj + nj;
    if (p_hole != n_hole) {
        two_j = pj + nj - 2;
    } elif (sign_p + sign_n == 0) {
        two_j = pj - nj;
        if (two_j < 0) { two_j = 0 - two_j; }
    }
    return (two_j, parity);
}

# The shell closure at or below `nucleon_count` (0 below the first, 2). Mirrors
# `shell_closure_below`.
#must_use
fn shell_closure_below(nucleon_count): i64 {
    var result = 0;
    var k = 0;
    while (k < TM_SHELL_CLOSURE_COUNT) {
        var c = TM_SHELL_CLOSURES[k];
        if (c <= nucleon_count) { result = c; } else { return result; }
        k = k + 1;
    }
    return result;
}

# The next shell closure above `nucleon_count`: Some(closure), or None past 184. Mirrors
# `next_shell_closure`.
#must_use
fn next_shell_closure(nucleon_count): Option {
    var k = 0;
    while (k < TM_SHELL_CLOSURE_COUNT) {
        var c = TM_SHELL_CLOSURES[k];
        if (c > nucleon_count) { return Some(c); }
        k = k + 1;
    }
    return None();
}

# --- decay_data.cyr ---

# tanmatra — decay modes and the known-isotope table (NUBASE2020, 1 y = 365.2422 d)
#
# GENERATED by scripts/oracle from tanmatra 1.3.0 (rust-old/), libm 0.2.16. Do not edit.
# Regenerate: cargo run --release --locked --manifest-path scripts/oracle/Cargo.toml
#
# Generated from the oracle's known_isotopes(); tests/golden/decay.tsv pins every field.

# Radioactive decay modes.
enum TmDecayMode {
    TM_DECAY_MODE_ALPHA = 0;
