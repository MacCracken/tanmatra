    var ln2_lo: f64 = 0x3DEA39EF35793C76;
    var lg1: f64 = 0x3FE5555555555593;
    var lg2: f64 = 0x3FD999999997FA04;
    var lg3: f64 = 0x3FD2492494229359;
    var lg4: f64 = 0x3FCC71C51D8E78AF;
    var lg5: f64 = 0x3FC7466496CB03DE;
