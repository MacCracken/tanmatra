# --- particle.cyr ---

# particle.cyr — Standard Model particles and forces (port of rust-old/src/particle.rs).
#
# Rust's enum methods become functions of the enum value, e.g. `Quark::mass_mev(q)` is
# `quark_mass_mev(q)`. Every tabulated value is read from the generated particle_data.cyr
# (PDG 2024), so none is typed here. Rust can't hold an out-of-range enum; a Cyrius caller
# can, and gets NaN from an f64 property, -1 from an integer one and 0 from a predicate.

# 1 if `v` is a valid value of an enum with `count` members.
#must_use
fn _tm_in_range(v, count): i64 {
    if (v >= 0 && v < count) { return 1; }
    return 0;
}

# ── Quark ───────────────────────────────────────────────────────────────────────────

# Quark mass in MeV/c² (PDG 2024). Mirrors `Quark::mass_mev`.
#must_use
fn quark_mass_mev(q): f64 {
    if (_tm_in_range(q, TM_QUARK_COUNT) != 1) { return _tm_nan(); }
    var m: f64 = TM_QUARK_MASS_MEV[q];
    return m;
}

# Electric charge in units of e. Mirrors `Quark::charge`.
#must_use
fn quark_charge(q): f64 {
    if (_tm_in_range(q, TM_QUARK_COUNT) != 1) { return _tm_nan(); }
    var c: f64 = TM_QUARK_CHARGE[q];
    return c;
}

# Generation (1, 2 or 3). Mirrors `Quark::generation`.
#must_use
fn quark_generation(q): i64 {
    if (_tm_in_range(q, TM_QUARK_COUNT) != 1) { return 0 - 1; }
    return TM_QUARK_GENERATION[q];
}

# ── Lepton ──────────────────────────────────────────────────────────────────────────

# Lepton mass in MeV/c². Mirrors `Lepton::mass_mev`.
#must_use
fn lepton_mass_mev(l): f64 {
    if (_tm_in_range(l, TM_LEPTON_COUNT) != 1) { return _tm_nan(); }
    var m: f64 = TM_LEPTON_MASS_MEV[l];
    return m;
}

# Electric charge in units of e. Mirrors `Lepton::charge`.
#must_use
fn lepton_charge(l): f64 {
    if (_tm_in_range(l, TM_LEPTON_COUNT) != 1) { return _tm_nan(); }
    var c: f64 = TM_LEPTON_CHARGE[l];
    return c;
}

# Generation (1, 2 or 3). Mirrors `Lepton::generation`.
#must_use
fn lepton_generation(l): i64 {
    if (_tm_in_range(l, TM_LEPTON_COUNT) != 1) { return 0 - 1; }
    return TM_LEPTON_GENERATION[l];
}

# Mean lifetime in seconds; +∞ for stable leptons (PDG 2024). Mirrors
# `Lepton::lifetime_seconds`.
#must_use
fn lepton_lifetime_seconds(l): f64 {
    if (_tm_in_range(l, TM_LEPTON_COUNT) != 1) { return _tm_nan(); }
    var t: f64 = TM_LEPTON_LIFETIME_SECONDS[l];
    return t;
}

# Decay width Γ = ħ/τ in MeV; 0 for stable leptons. Mirrors `Lepton::decay_width_mev`.
#must_use
fn lepton_decay_width_mev(l): f64 {
    var tau: f64 = lepton_lifetime_seconds(l);
    if (_tm_is_inf(tau) == 1) { return 0.0; }
    var w: f64 = TM_HBAR_MEV_S / tau;
    return w;
}

# 1 if the lepton is stable (the electron and the three neutrinos). Mirrors
# `Lepton::is_stable`.
#must_use
fn lepton_is_stable(l): i64 {
    if (_tm_in_range(l, TM_LEPTON_COUNT) != 1) { return 0; }
    if (TM_LEPTON_IS_STABLE[l]) { return 1; }
    return 0;
}

# ── Boson ───────────────────────────────────────────────────────────────────────────

# Boson mass in MeV/c² (PDG 2024). Mirrors `Boson::mass_mev`.
#must_use
fn boson_mass_mev(b): f64 {
    if (_tm_in_range(b, TM_BOSON_COUNT) != 1) { return _tm_nan(); }
    var m: f64 = TM_BOSON_MASS_MEV[b];
    return m;
}

# Spin in units of ħ. Mirrors `Boson::spin`.
#must_use
fn boson_spin(b): i64 {
    if (_tm_in_range(b, TM_BOSON_COUNT) != 1) { return 0 - 1; }
    return TM_BOSON_SPIN[b];
}

# Electric charge in units of e. Mirrors `Boson::charge`.
#must_use
fn boson_charge(b): f64 {
    if (_tm_in_range(b, TM_BOSON_COUNT) != 1) { return _tm_nan(); }
    var c: f64 = TM_BOSON_CHARGE[b];
    return c;
}

# Total decay width in MeV; 0 for stable bosons (PDG 2024). Mirrors
# `Boson::decay_width_mev`.
#must_use
fn boson_decay_width_mev(b): f64 {
    if (_tm_in_range(b, TM_BOSON_COUNT) != 1) { return _tm_nan(); }
    var w: f64 = TM_BOSON_DECAY_WIDTH_MEV[b];
    return w;
}

# Mean lifetime τ = ħ/Γ in seconds; +∞ for stable bosons. Mirrors
# `Boson::lifetime_seconds`.
#must_use
fn boson_lifetime_seconds(b): f64 {
    var width: f64 = boson_decay_width_mev(b);
    if (width <= 0.0) { return _TM_INF; }
    var t: f64 = TM_HBAR_MEV_S / width;
    return t;
}

# 1 if the boson is stable (the photon and the gluon). Mirrors `Boson::is_stable`.
#must_use
fn boson_is_stable(b): i64 {
    if (_tm_in_range(b, TM_BOSON_COUNT) != 1) { return 0; }
    if (TM_BOSON_IS_STABLE[b]) { return 1; }
    return 0;
}

# ── FundamentalForce ────────────────────────────────────────────────────────────────

# Coupling strength relative to the strong force. Mirrors
# `FundamentalForce::relative_strength`.
#must_use
fn fundamental_force_relative_strength(f): f64 {
    if (_tm_in_range(f, TM_FUNDAMENTAL_FORCE_COUNT) != 1) { return _tm_nan(); }
    var s: f64 = TM_FUNDAMENTAL_FORCE_RELATIVE_STRENGTH[f];
    return s;
}

# Effective range in meters; +∞ for the long-range forces. Mirrors
# `FundamentalForce::range_meters`.
#must_use
fn fundamental_force_range_meters(f): f64 {
    if (_tm_in_range(f, TM_FUNDAMENTAL_FORCE_COUNT) != 1) { return _tm_nan(); }
    var r: f64 = TM_FUNDAMENTAL_FORCE_RANGE_METERS[f];
    return r;
}

# How many gauge bosons mediate the force (0 for gravity: no Standard Model mediator).
# With `fundamental_force_mediator`, this mirrors the slice `FundamentalForce::mediator`
# returns.
#must_use
fn fundamental_force_mediator_count(f): i64 {
    if (_tm_in_range(f, TM_FUNDAMENTAL_FORCE_COUNT) != 1) { return 0; }
    return TM_FUNDAMENTAL_FORCE_MEDIATOR_COUNT[f];
}

# The force's k-th mediator as a TmBoson value, in Rust's order; -1 when k is out of range.
#must_use
fn fundamental_force_mediator(f, k): i64 {
    if (k < 0 || k >= fundamental_force_mediator_count(f)) { return 0 - 1; }
    return TM_FUNDAMENTAL_FORCE_MEDIATORS[TM_FUNDAMENTAL_FORCE_MEDIATOR_START[f] + k];
}

# --- relativity.cyr ---

# relativity.cyr — special relativity: four-momentum, Lorentz factor, velocity addition
# (port of rust-old/src/relativity.rs).
#
# Every expression keeps Rust's operation order, so the golden rows are class B: bit-identical
# expected, ≤ 2 ulp allowed. |p| goes through _tm_hypot, Rust libm's hypot reproduced
# exactly. The four-momentum functions are ill-conditioned for p ≫ m, so an inexact hypot
# would break them (docs/development/port-parity.md).

# A four-momentum (E, px, py, pz) in MeV and MeV/c, natural units. A 32-byte value: it is
# returned by value and passed by address.
struct TmFourMomentum {
    energy: f64;
    px: f64;
    py: f64;
    pz: f64;
}

impl TmFourMomentum {
    # A four-momentum from its components. Mirrors `FourMomentum::new`.
    #must_use
    fn new(energy: f64, px: f64, py: f64, pz: f64): TmFourMomentum {
        var p: TmFourMomentum;
        p.energy = energy;
        p.px = px;
        p.py = py;
        p.pz = pz;
        return p;
    }

    # A particle at rest: E = mc², p = 0. Mirrors `FourMomentum::at_rest`.
    #must_use
    fn at_rest(mass_mev: f64): TmFourMomentum {
        var p: TmFourMomentum;
        p.energy = mass_mev;
        p.px = 0.0;
        p.py = 0.0;
        p.pz = 0.0;
        return p;
    }

    # A particle of mass m moving along z with momentum p: E = √(m² + p²). Mirrors
    # `FourMomentum::from_mass_and_momentum`.
    #must_use
    fn from_mass_and_momentum(mass_mev: f64, p_mev: f64): TmFourMomentum {
        var r: TmFourMomentum;
        r.energy = f64_sqrt((mass_mev * mass_mev) + (p_mev * p_mev));
        r.px = 0.0;
        r.py = 0.0;
        r.pz = p_mev;
        return r;
    }

    # |p| = hypot(hypot(px, py), pz). Mirrors `FourMomentum::momentum_magnitude`.
    #must_use
    fn momentum_magnitude(self): f64 {
        var pxy: f64 = _tm_hypot(self.px, self.py);
        var p: f64 = _tm_hypot(pxy, self.pz);
        return p;
    }

    # The invariant mass m = √((E − p)(E + p)): the factored form avoids E² − p²
    # cancelling when E ≫ m. 0 for a spacelike vector (numerical noise for a massless
    # one). Mirrors `FourMomentum::invariant_mass`.
    #must_use
    fn invariant_mass(self): f64 {
        var p: f64 = self.momentum_magnitude();
        var e: f64 = self.energy;
        var m_sq: f64 = (e - p) * (e + p);
        if (m_sq < 0.0) { return 0.0; }
        var m: f64 = f64_sqrt(m_sq);
        return m;
    }

    # β = |p| / E; 0 when E ≤ 0. Mirrors `FourMomentum::beta`.
    #must_use
    fn beta(self): f64 {
        if (self.energy <= 0.0) { return 0.0; }
        var p: f64 = self.momentum_magnitude();
        var b: f64 = p / self.energy;
        return b;
    }

    # γ = E / m; +∞ for a massless particle. Mirrors `FourMomentum::gamma`.
    #must_use
    fn gamma(self): f64 {
        var mass: f64 = self.invariant_mass();
        if (mass <= 0.0) { return _TM_INF; }
        var g: f64 = self.energy / mass;
        return g;
    }

    # Kinetic energy T = E − m = p² / (E + m): the second form doesn't cancel at low
    # momentum. 0 when E + m ≤ 0. Mirrors `FourMomentum::kinetic_energy`.
    #must_use
    fn kinetic_energy(self): f64 {
        var m: f64 = self.invariant_mass();
        var p: f64 = self.momentum_magnitude();
        var den: f64 = self.energy + m;
        if (den <= 0.0) { return 0.0; }
        var t: f64 = (p * p) / den;
        return t;
    }

    # Component-wise sum, so `a + b` adds two four-momenta. Mirrors `impl Add for
    # FourMomentum`.
    #must_use
    fn add(self, rhs: TmFourMomentum): TmFourMomentum {
        var s: TmFourMomentum;
        s.energy = self.energy + rhs.energy;
        s.px = self.px + rhs.px;
        s.py = self.py + rhs.py;
        s.pz = self.pz + rhs.pz;
        return s;
    }
}

# The Lorentz factor γ = 1/√(1 − β²), symmetric in β; +∞ for |β| ≥ 1. The factored form
# (1 − |β|)(1 + |β|) keeps full precision as β → 1. Mirrors `lorentz_gamma`.
#must_use
fn lorentz_gamma(beta: f64): f64 {
    var b: f64 = f64_abs(beta);
    if (b >= 1.0) { return _TM_INF; }
    var g: f64 = 1.0 / f64_sqrt((1.0 - b) * (1.0 + b));
    return g;
}

# β from γ: √((γ − 1)(γ + 1)) / γ; 0 for γ ≤ 1, 1 for γ = +∞. Mirrors `gamma_to_beta`.
#must_use
fn gamma_to_beta(gamma: f64): f64 {
    if (gamma <= 1.0) { return 0.0; }
    if (_tm_is_inf(gamma) == 1) { return 1.0; }
    var b: f64 = f64_sqrt((gamma - 1.0) * (gamma + 1.0)) / gamma;
    return b;
}

# Relativistic velocity addition (β₁ + β₂) / (1 + β₁β₂). NaN when |β| > 1 or the
# denominator is 0 (β₁ = −β₂ = ±1). Mirrors `velocity_addition`.
#must_use
fn velocity_addition(beta1: f64, beta2: f64): f64 {
    var denom: f64 = 1.0 + (beta1 * beta2);
    if (f64_abs(beta1) > 1.0 || f64_abs(beta2) > 1.0 || denom == 0.0) { return _tm_nan(); }
    var v: f64 = (beta1 + beta2) / denom;
    return v;
}

# Total energy E = √(m² + p²), MeV. Mirrors `relativistic_energy`.
#must_use
fn relativistic_energy(mass_mev: f64, momentum_mev: f64): f64 {
    var e: f64 = f64_sqrt((mass_mev * mass_mev) + (momentum_mev * momentum_mev));
    return e;
}

# Momentum from kinetic energy, p = √(T² + 2Tm), MeV/c. Mirrors `relativistic_momentum`.
#must_use
fn relativistic_momentum(mass_mev: f64, kinetic_energy_mev: f64): f64 {
    var t: f64 = kinetic_energy_mev;
    var p: f64 = f64_sqrt((t * t) + ((2.0 * t) * mass_mev));
    return p;
}

# The de Broglie wavelength λ = 2πħc / (pc) in fm; +∞ for p ≤ 0. Mirrors
# `de_broglie_wavelength_fm`.
#must_use
fn de_broglie_wavelength_fm(momentum_mev: f64): f64 {
    if (momentum_mev <= 0.0) { return _TM_INF; }
    var l: f64 = ((2.0 * _TM_PI) * TM_HBAR_C_MEV_FM) / momentum_mev;
    return l;
}

# β = v / c, with v in m/s. Mirrors `velocity_to_beta`.
#must_use
fn velocity_to_beta(velocity_m_per_s: f64): f64 {
    var b: f64 = velocity_m_per_s / TM_C;
    return b;
}

# v = βc, in m/s. Mirrors `beta_to_velocity`.
#must_use
fn beta_to_velocity(beta: f64): f64 {
    var v: f64 = beta * TM_C;
    return v;
}

# The invariant mass of a two-particle system, |p1 + p2|. Mirrors `invariant_mass_two_body`.
#must_use
fn invariant_mass_two_body(p1: TmFourMomentum, p2: TmFourMomentum): f64 {
    var total: TmFourMomentum = p1 + p2;
    var m: f64 = total.invariant_mass();
    return m;
}

