# rem_pio2.rs `medium`: x = n·π/2 + (y0 + y1) by Cody–Waite with π/2 in three 33-bit words,
# the later words used only when the first cancels more than 16 (then 49) bits.
#must_use
fn _tm_rem_pio2_medium(x: f64, ix, yp): i64 {
    var inv_pio2: f64 = 0x3FE45F306DC9C883;
    var to_int: f64 = 0x4338000000000000;
    var pio2_1: f64 = 0x3FF921FB54400000;
    var pio2_1t: f64 = 0x3DD0B4611A626331;
    var pio2_2: f64 = 0x3DD0B4611A600000;
    var pio2_2t: f64 = 0x3BA3198A2E037073;
    var pio2_3: f64 = 0x3BA3198A2E000000;
    var pio2_3t: f64 = 0x397B839A252049C1;
    var tmp: f64 = (x * inv_pio2) + to_int;
    var f_n: f64 = tmp - to_int;
    var n = f64_to(f_n);
    var r: f64 = x - (f_n * pio2_1);
    var w: f64 = f_n * pio2_1t;
    var y0: f64 = r - w;
    var ex = ix >> 20;
    var ey = (_tm_bits(y0) >> 52) & 0x7FF;
    if (ex - ey > 16) {
        var t: f64 = r;
        w = f_n * pio2_2;
        r = t - w;
        w = (f_n * pio2_2t) - ((t - r) - w);
        y0 = r - w;
        ey = (_tm_bits(y0) >> 52) & 0x7FF;
        if (ex - ey > 49) {
            var t3: f64 = r;
            w = f_n * pio2_3;
            r = t3 - w;
            w = (f_n * pio2_3t) - ((t3 - r) - w);
            y0 = r - w;
        }
    }
    var y1: f64 = (r - y0) - w;
    store64(yp, y0);
    store64(yp + 8, y1);
    return n;
}

# One of rem_pio2.rs's direct reductions for |x| ≤ 9π/4: z = x ∓ k·PIO2_1, then the tail.
#must_use
fn _tm_rem_pio2_fast(x: f64, k, yp): i64 {
    var pio2_1: f64 = 0x3FF921FB54400000;
    var pio2_1t: f64 = 0x3DD0B4611A626331;
    var kf: f64 = f64_from(k);
    var h: f64 = kf * pio2_1;
    var t: f64 = kf * pio2_1t;
    if (_tm_bits(x) >= 0) {
        var z: f64 = x - h;
        var y0: f64 = z - t;
        var y1: f64 = (z - y0) - t;
        store64(yp, y0);
        store64(yp + 8, y1);
        return k;
    }
    var zn: f64 = x + h;
    var y0n: f64 = zn + t;
    var y1n: f64 = (zn - y0n) + t;
    store64(yp, y0n);
    store64(yp + 8, y1n);
    return 0 - k;
}

# x = n·π/2 + (y0 + y1) with |y0 + y1| ≤ ~π/4, y0 and y1 written to yp[0], yp[1]; returns n.
# rem_pio2.rs transcribed. Arguments at or past 2^20·π/2 go to the stdlib's Payne–Hanek
# reduction, `_f64_rem_pio2` (lib/math.cyr, FreeBSD k_rem_pio2.c, as Rust's rem_pio2_large is),
# which the libm.tsv rows above 2^20·π/2 pin bit for bit.
#must_use
fn _tm_rem_pio2(x: f64, yp): i64 {
    var ix = (_tm_bits(x) >> 32) & 0x7FFFFFFF;
    if (ix <= 0x400F6A7A) {                          # |x| ~≤ 5π/4
        if ((ix & 0xFFFFF) == 0x921FB) { return _tm_rem_pio2_medium(x, ix, yp); }
        if (ix <= 0x4002D97C) { return _tm_rem_pio2_fast(x, 1, yp); }
        return _tm_rem_pio2_fast(x, 2, yp);
    }
    if (ix <= 0x401C463B) {                          # |x| ~≤ 9π/4
        if (ix <= 0x4015FDBC) {
            if (ix == 0x4012D97C) { return _tm_rem_pio2_medium(x, ix, yp); }
            return _tm_rem_pio2_fast(x, 3, yp);
        }
        if (ix == 0x401921FB) { return _tm_rem_pio2_medium(x, ix, yp); }
        return _tm_rem_pio2_fast(x, 4, yp);
    }
    if (ix < 0x413921FB) { return _tm_rem_pio2_medium(x, ix, yp); }
    return _f64_rem_pio2(x, yp);
}

# sin(x) as Rust libm 0.2.16 computes it, bit for bit (sin.rs).
#must_use
fn _tm_sin(x: f64): f64 {
    var ix = (_tm_bits(x) >> 32) & 0x7FFFFFFF;
    if (ix <= 0x3FE921FB) {
        if (ix < 0x3E500000) { return x; }           # |x| < 2^-26
        var k0: f64 = _tm_k_sin(x, 0.0, 0);
        return k0;
    }
    if (ix >= 0x7FF00000) {
        var nan: f64 = x - x;
        return nan;
    }
    var y: i64[2];
    var n = _tm_rem_pio2(x, &y) & 3;
    var y0: f64 = load64(&y);
    var y1: f64 = load64(&y + 8);
    var r: f64 = 0.0;
    if (n == 0) { r = _tm_k_sin(y0, y1, 1); }
    elif (n == 1) { r = _tm_k_cos(y0, y1); }
    elif (n == 2) {
        var a: f64 = _tm_k_sin(y0, y1, 1);
        r = -a;
    } else {
        var b: f64 = _tm_k_cos(y0, y1);
        r = -b;
    }
    return r;
}

# cos(x) as Rust libm 0.2.16 computes it, bit for bit (cos.rs).
#must_use
fn _tm_cos(x: f64): f64 {
    var ix = (_tm_bits(x) >> 32) & 0x7FFFFFFF;
    if (ix <= 0x3FE921FB) {
        if (ix < 0x3E46A09E) { return 1.0; }         # |x| < 2^-27·√2
        var k0: f64 = _tm_k_cos(x, 0.0);
        return k0;
    }
    if (ix >= 0x7FF00000) {
        var nan: f64 = x - x;
        return nan;
    }
    var y: i64[2];
    var n = _tm_rem_pio2(x, &y) & 3;
    var y0: f64 = load64(&y);
    var y1: f64 = load64(&y + 8);
    var r: f64 = 0.0;
    if (n == 0) { r = _tm_k_cos(y0, y1); }
    elif (n == 1) {
        var a: f64 = _tm_k_sin(y0, y1, 1);
        r = -a;
    } elif (n == 2) {
        var b: f64 = _tm_k_cos(y0, y1);
        r = -b;
    } else {
        r = _tm_k_sin(y0, y1, 1);
    }
    return r;
}

# --- constants.cyr ---

# tanmatra — physical constants (CODATA 2022 unless noted)
#
# GENERATED by scripts/oracle from tanmatra 1.3.0 (rust-old/), libm 0.2.16. Do not edit.
# Regenerate: cargo run --release --locked --manifest-path scripts/oracle/Cargo.toml
#
# Each value is the shortest decimal that round-trips to the oracle's f64, written out
# positionally: the Cyrius lexer has no exponent notation, and decimal literals are
# correctly rounded (6.6.10+). tests/golden/constants.tsv pins every bit.

# Electron rest mass in MeV/c^2 (CODATA 2022).
const TM_ELECTRON_MASS_MEV = 0.51099895069;

# Proton rest mass in MeV/c^2 (CODATA 2022).
const TM_PROTON_MASS_MEV = 938.27208943;

# Neutron rest mass in MeV/c^2 (CODATA 2022).
const TM_NEUTRON_MASS_MEV = 939.56542194;

# Atomic mass unit in MeV/c^2 (CODATA 2022).
const TM_AMU_MEV = 931.49410372;

# Fine-structure constant (CODATA 2022).
#
# alpha = 1 / 137.035999177
const TM_FINE_STRUCTURE = 0.0072973525643314245;

# Reduced Planck constant in eV*s (CODATA 2022).
const TM_HBAR_EV_S = 0.0000000000000006582119569;

# Rydberg constant in m^-1 (CODATA 2022).
const TM_RYDBERG = 10973731.568157;

# Bohr radius in meters (CODATA 2022).
const TM_BOHR_RADIUS = 0.0000000000529177210544;

# Avogadro constant in mol^-1 (CODATA 2022, exact).
const TM_AVOGADRO = 602214076000000000000000.0;

# Elementary charge in coulombs (CODATA 2022, exact).
const TM_ELEMENTARY_CHARGE = 0.0000000000000000001602176634;

# Speed of light in vacuum in m/s (exact).
const TM_C = 299792458.0;

# Nuclear radius parameter r0 in femtometers.
#
# R = r0 * A^(1/3), with r0 approximately 1.2 fm.
const TM_R0_FM = 1.2;

# Boltzmann constant in eV/K (CODATA 2022, exact).
const TM_BOLTZMANN_EV = 0.00008617333262;

# Planck constant in eV*s (CODATA 2022, exact).
const TM_H_EV_S = 0.000000000000004135667696;

# Reduced Planck constant in MeV*s (CODATA 2022, exact).
#
# Used for decay width ↔ lifetime conversion: Γ·τ = ħ.
const TM_HBAR_MEV_S = 0.0000000000000000000006582119569;

# Bohr magneton in eV/T (CODATA 2022).
const TM_BOHR_MAGNETON_EV_T = 0.000057883817982;

